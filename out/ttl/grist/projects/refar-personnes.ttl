<1880a12a-210c-4d36-b23f-122b2641b3ce> a crm:PC3_has_note ;
    crm:P01_has_domain <7433f5a5-2aad-4b44-b31a-887d227b6e8d> ;
    crm:P03_has_range_literal "Jean-François Sarrasin est un écrivain français du XVIIe siècle. Il est proche des Scudéry, notamment de Madeleine avec laquelle il a échangé des vers. Il a aussi soutenu Georges de Scudéry en 1639 dans son attaque contre Corneille avec un Discours de la tragédie et alla jusqu'à demander à l’Académie de déclarer la pièce de Scudéry l’Amour tyrannique le chef-d’œuvre de la scène française (cf. https://fr.wikipedia.org/wiki/Jean-Fran%C3%A7ois\\_Sarrasin consulté le 14 janvier 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<18b62487-70db-4846-bdba-277089dadf11> a crm:PC3_has_note ;
    crm:P01_has_domain <0f4a8328-ab14-43df-815f-3d9b1209498b> ;
    crm:P03_has_range_literal "Religieux Minime, officie pour une cérémonie particulière à Marseille en février 1687 (cf. [1687-03a_046](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_046))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<18d1c2fa-1b0d-4c95-9a89-6389c3f95ed9> a crm:PC3_has_note ;
    crm:P01_has_domain <6ca9d7ea-7f33-4c94-8b3e-d122e1bca940> ;
    crm:P03_has_range_literal "L'abbé Du Mesnil composa la musique d'un air publié dans le Mercure galant (cf. [1702-03_215](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-03_215))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<18dda2f1-9871-4f42-9fc7-fbf4c35fdb4f> a crm:PC3_has_note ;
    crm:P01_has_domain <e9cdddd6-75a0-4bfc-a03d-aad964bb6fd6> ;
    crm:P03_has_range_literal "Le Mercure galant évoque «  Mr Blandin Notaire  » (cf. [1707-05_18](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-05_18)) : il pourrait s'agir de Gentin Blandin, notaire au Châtelet d'Orléans (cf. <https://gw.geneanet.org/vlefevre2?n=blandin&oc=&p=gentien>, consulté le 24 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<18f0e2f9-dd6d-447c-bfb7-a566a5baccf2> a crm:PC3_has_note ;
    crm:P01_has_domain <2ebf7ed8-524a-4eda-bc62-c9159b0f1a3b> ;
    crm:P03_has_range_literal "Charles Fontaines des Montées a également été doyen de la cathédrale Sainte-Croix d’Orléans (cf. Cuissard, Charles, Les chanoines et dignitaire de la Cathédrale d’Orléans, Orléans, 1900, p. 190)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<18f89558-f895-43da-aef5-6cb1e9688de8> a crm:PC3_has_note ;
    crm:P01_has_domain <4a7f9620-4d69-4992-a042-e6f2359df621> ;
    crm:P03_has_range_literal "Docteur en théologie, ancien curé de la Rocheguyon en 1692, prononce un panégyrique à Niort (cf. [1692-11_188](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1692-11_188))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<191e4f35-3170-4c8f-9eb6-33a2d982b217> a crm:PC3_has_note ;
    crm:P01_has_domain <0b28c95e-eaeb-45ca-8472-87e16f5a3833> ;
    crm:P03_has_range_literal "Giovanni Battista Roca prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1929ac3d-e984-4787-9f32-5d43cd1e34f9> a crm:PC3_has_note ;
    crm:P01_has_domain <b43f933e-7671-42fa-af3e-a661a4b011aa> ;
    crm:P03_has_range_literal "M. Merieux est l'auteur de deux airs publiés dans le *Mercure galant* en 1678 et 1679 (cf. [1678-09_103a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_103a), [1679-02_047](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-02_047))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<19302a3a-0025-46f3-ab91-d5cd7180d212> a crm:PC3_has_note ;
    crm:P01_has_domain <64ac5183-0ff5-4213-9e71-1442bae632cb> ;
    crm:P03_has_range_literal "membre de l'académie d'Arles (1682.12)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<19387820-0977-4ce5-a8a7-1cb37dfe6a9d> a crm:PC3_has_note ;
    crm:P01_has_domain <68177f9a-9d29-49fc-9212-edb45eb97162> ;
    crm:P03_has_range_literal "Religieuse de l'abbaye de Bétancourt (1685.11)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<194d1ef4-96e4-4816-b426-936b39082b2a> a crm:PC3_has_note ;
    crm:P01_has_domain <47227139-bdc8-4cf5-b026-2eb4f3d1306f> ;
    crm:P03_has_range_literal "Colbert (Nicolas) (1628-1676), docteur en théologie, prieur de la maison de Sorbonne, abbé commendataire de Saint-Sauveur de Vertus et de Notre-Dame de Landais, garde de la Bibliothèque du roi (1656-1676), évêque de Luçon (1661…), prieur de La Charité (1664…), intendant du Cabinet des médailles du roi (1666-1676), évêque d'Auxerre (1671…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<1950f26b-e599-43c8-81f6-c58f06bbc137> a crm:PC3_has_note ;
    crm:P01_has_domain <1d9e033b-1207-416d-8125-f2e798ff02e4> ;
    crm:P03_has_range_literal "Chancelier de l'Université d'Angers (cf. [1687-03a_076](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_076))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1960253b-c68f-4974-b6ce-d5dc85710fe8> a crm:PC3_has_note ;
    crm:P01_has_domain <e2ef4b6a-b41c-450a-8051-3f2a5dfc2cfd> ;
    crm:P03_has_range_literal "Prêtre, docteur en théologie de la Faculté de Paris, doyen et chanoine de l'église royale et collégiale Saint-Thomas-du-Louvre, demeurant, en 1671, au doyenné de la dite église (cf. https://www.siv.archives-nationales.culture.gouv.fr/siv/IR/FRAN\\_IR\\_041104) et décédé début 1691 (cf. [1691-01_242](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-01_242))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<196d7771-23ce-4727-ab1e-58be7dd8ab9a> a crm:PC3_has_note ;
    crm:P01_has_domain <593ac12e-93dd-4b82-8159-4759ffd36e53> ;
    crm:P03_has_range_literal "M. du Breuil est l'auteur, avec M. Piuli, d'un air paru dans le *Mercure galant* de janvier 1701 (MG-1701-01\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1990da47-f3d4-48fd-abd4-236c25a91ca5> a crm:PC3_has_note ;
