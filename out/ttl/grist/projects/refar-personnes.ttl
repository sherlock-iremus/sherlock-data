    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<577e5911-9c16-4939-a3e2-6e7298e94393> a crm:PC3_has_note ;
    crm:P01_has_domain <daac80c5-7970-4329-bfc1-26bde18f0ae2> ;
    crm:P03_has_range_literal "M. Durand, avocat au Parlement, est l'auteur de *La Musique naturelle ou par raisonnement, sistême universel et nouveau, raporté aux mathématiques et à l'usage ordinaire* (Paris, M. Rebuffe, 1700)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

