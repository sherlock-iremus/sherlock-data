    crm:P03_has_range_literal "Capitaine d'artillerie de la cour de Hanovre (cf. [1681-04_133](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-04_133), [1681-08_144](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_144))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<adf2ab87-7b17-4486-8c6b-cd1294b25d4b> a crm:PC3_has_note ;
    crm:P01_has_domain <be598a28-d7e3-4ab2-af8f-aca14f9c83f8> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae1258da-bbe6-4c81-83c3-be95cfc1f014> a crm:PC3_has_note ;
    crm:P01_has_domain <1eb96a7f-597c-4e76-bcb7-d8d3d9681b16> ;
    crm:P03_has_range_literal "Médailleur attesté dès 1674. Graveur particulier de la Monnaie de Paris de 1679 à 1694, puis graveur général des sceaux et chancellerie de France (vers 1702-1705). (cf? VILLELA-PETIT, Inès, \"Documents du Minutier central des notaires de Paris pour servir à l'histoire des Roettiers\", in *Revue numismatique*, 6e série - Tome 172, 2015 p. 193-228)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ae14943f-0b47-49e3-9078-bc5f4b9acf84> a crm:PC3_has_note ;
    crm:P01_has_domain <d8889388-ac3f-46be-9909-33db99263625> ;
    crm:P03_has_range_literal "Supersac (Mathieu) (v. 1701-?), balayeur du Grand Commun (…1724-1732…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

