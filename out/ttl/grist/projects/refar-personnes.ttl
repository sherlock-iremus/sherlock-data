    crm:P03_has_range_literal "épouse de W. Temple, ambassadeur d'Angleterre à la cour de France (1677.09)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7b913f01-bba9-48ed-b9af-5e93d1ebd983> a crm:PC3_has_note ;
    crm:P01_has_domain <3c1bd7c2-0d8f-4e93-a8fb-b274455ce43c> ;
    crm:P03_has_range_literal "Graveur de musique, actif à Paris entre 1709 et 1740." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b9df206-918f-4ba8-b64e-abbffd19bb93> a crm:PC3_has_note ;
    crm:P01_has_domain <21129c19-9f65-499e-a46f-770a8a20b967> ;
    crm:P03_has_range_literal "Bouillé de Saint-Géran (Nicolas de) (1702-1767), maître de l'oratoire (1749-1757), premier aumônier du roi (1757-1764), évêque d'Autun (1758-1767), dit l'abbé de Bouillé" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7bafb7c4-a4bf-411a-9c22-cdfa22607a53> a crm:PC3_has_note ;
    crm:P01_has_domain <996c0bf4-f5f9-40da-8874-74f130e477be> ;
    crm:P03_has_range_literal "Premier avocat du roi dans la vicomté de Pont-Audemer (cf. MG-1686-05\\_165)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7bbcb934-7ffe-4ed7-b612-7f6451dc731e> a crm:PC3_has_note ;
    crm:P01_has_domain <1c4cfc23-c22e-4cf1-91d1-9d2690a7f639> ;
    crm:P03_has_range_literal "Arnaud de Pomponne (Henri-Charles) (1669-1756), conseiller d'État ordinaire (1711-1756)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7bbd541a-c122-47c8-97d4-6154ec8b3d9b> a crm:PC3_has_note ;
    crm:P01_has_domain <b4f6288e-6d81-4ad6-9a0e-11832a79165d> ;
    crm:P03_has_range_literal "Goyon de Matignon (Léonor II), aumônier du roi (1664 ; 1669-1676), évêque de Lisieux (1676-1714)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7bd8bbc4-a4f8-47cb-8221-def91c91a8c3> a crm:PC3_has_note ;
    crm:P01_has_domain <b1e414ff-466d-4b51-8b5c-7a263256b89a> ;
    crm:P03_has_range_literal "Mme de Rémilly était l'épouse de Jean de Rémilly, bailli de Vendôme (cf. [1682-10b_227](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10b_227))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7bf178d3-47cc-4d96-b6c3-aa90d38e79ab> a crm:PC3_has_note ;
    crm:P01_has_domain <0c3b35dc-6789-4f73-84fa-65c6a8cbdbe9> ;
    crm:P03_has_range_literal "gouverneur de messieurs les princes de Hanovre (1681.04)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7c083aea-ca16-4aba-9231-b5b93c695fdb> a crm:PC3_has_note ;
    crm:P01_has_domain <de927540-454c-45a5-8ae8-eb3fa4793fd7> ;
    crm:P03_has_range_literal "J.-F. Eosander von Göthe était architecte de Frédéric Ier, roi de Prusse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7c0f9306-14fe-4d13-b6aa-35bab82c17ca> a crm:PC3_has_note ;
    crm:P01_has_domain <eb9ce2bd-fc6d-41b8-9e8d-47f6930d4f0c> ;
    crm:P03_has_range_literal "Giuseppe Tortoriti fut acteur et membre de la Comédie Italienne (1683-1697). Il était connu pour son rôle de Pascariel (cf. Guy Boquet, Les Comédiens Italiens à Paris au temps de Louis XIV , dans Revue d’histoire moderne et contemporaine, tome 26 N°3, Juillet-septembre 1979. pp. 422-438 ; https://www.persee.fr/doc/rhmc\\_0048-8003\\_1979\\_num\\_26\\_3\\_1065)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7c1626b9-1611-4ed5-bd3e-e99a38aca349> a crm:PC3_has_note ;
    crm:P01_has_domain <2b39b7c6-a012-4322-a63c-9aec4ccdce58> ;
    crm:P03_has_range_literal "Ehrenreich Bogislaus von Creutz était en 1701 « Baron de Creutz, Prémier Conseiller de Regence, & Chancelier de Prusse » d’après Le ceremonial diplomatique des cours de l'Europe, ou collection des actes… , Amsterdam, 1739, p. 541." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7c2042b2-7480-46e2-8a6a-6ce26d0c812d> a crm:PC3_has_note ;
    crm:P01_has_domain <82d17469-c1a8-4899-b332-50981ab86b0a> ;
    crm:P03_has_range_literal "Premier Président du Parlement de Normandie (1692-1703). Épouse en 1679 Marie-Anne de la Guillaumie." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7c7f21f8-97f8-458d-9ea7-59a66f79a66c> a crm:PC3_has_note ;
    crm:P01_has_domain <44aff363-62da-44f6-bc6d-d77bbcfe15c2> ;
    crm:P03_has_range_literal "Le chevalier de Théron, capitaine dans le régiment de Lanoy, est l'auteur d'une Ode sur la fortune parue dans le Mercure galant. D'après le périodique, il est le neveu du père Vital Théron (cf. [1703-01_112](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-01_112))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7c99052f-33ba-4886-bb51-f25493538f57> a crm:PC3_has_note ;
    crm:P01_has_domain <f8221932-0855-48b9-87c8-88e1ca6b4bdd> ;
    crm:P03_has_range_literal "Ministre d'état et grand maréchal de la cour de Württemberg (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7ca20d93-9d8e-47ea-88f3-bcf1203e41e7> a crm:PC3_has_note ;
    crm:P01_has_domain <07272df0-798d-4755-aa83-26406607acf9> ;
    crm:P03_has_range_literal "Mlles de Grandiniaire ont participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. MG-1704-07b\\_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7cf3396c-1c49-4cf6-b1af-be80047f28a3> a crm:PC3_has_note ;
    crm:P01_has_domain <783337c1-dab8-4d98-b70f-c98600f04457> ;
    crm:P03_has_range_literal "échevin de Semur-en-Auxois (cf. [1682-12_216](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-12_216)) et auteur d'une Relation de ce qui c'est passé de plus considerable dans la rejouissance ordonnée par messieurs les magistrats de la ville de Semur, capitalle d'Auxois, sur la naissance de Monseigneur duc de Bourgogne en l'année 1682 (Pierre Palliot, imprimeur du roi, du rever. evesque duc de Langres, des états, & de la ville, à la Reine de Paix, devant la Cour du Palais, 1682)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7cf58225-592e-4ec6-b83d-ae3c657a9f4d> a crm:PC3_has_note ;
    crm:P01_has_domain <9e3015d5-887d-4ee1-bd8a-71d6ebf45f3e> ;
    crm:P03_has_range_literal "Feydeau de Brou (Henri-Joseph) (1653-1706), évêque d'Amiens (1687-1706)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

