<25f68f33-5ecd-4cd8-ad2a-a51c3a5d30e8> a crm:PC3_has_note ;
    crm:P01_has_domain <c92abf15-c74d-4e91-885d-286ad32d0522> ;
    crm:P03_has_range_literal "Jérôme Bignon a été successivement intendant de la généralité de Rouen (1693-1694), intendant de la généralité d'Amiens et des pays reconquis (1694-1708) puis prévôt des marchands de Paris (1708-1716). Il a été élu membre de l'Académie des inscriptions et belles-lettres en 1705 (cf. https://fr.wikipedia.org/wiki/J%C3%A9r%C3%B4me\\_Bignon\\_(1658-1725), consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<262994e8-cbd8-4ced-a9d1-585dd18f4d9d> a crm:PC3_has_note ;
    crm:P01_has_domain <3b884fce-76f8-4be9-82ff-50d2b438ac87> ;
    crm:P03_has_range_literal "Abbé commendataire de Preuilly (1678-1684), capitaine-lieutenant de la 1re compagnie des mousquetaires du roi, major général des quatre compagnies des gardes du corps du roi." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<26351c34-6096-456f-bddb-17b9ab1b1018> a crm:PC3_has_note ;
    crm:P01_has_domain <18dd779e-6e98-4a34-99d8-65a137eafbd2> ;
    crm:P03_has_range_literal "Filley (Louis) (v. 1642 - 1705 ou 1706), ingénieur du roi (1677…), inspecteur des Bâtiments du roi sur le chantier de la rivière de l'Eure (1684-1688), directeur des fortifications des places approchant l'Entre-Sambre-et-Meuse dont Namur (1693-1698…), brigadier d'infanterie (1695…), maréchal des camps et armées du roi (1703…), directeur des travaux du siège de Landau (1703) puis à Nice (1705/1706)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<263c1577-1e0a-4806-817e-c265fcdeba0b> a crm:PC3_has_note ;
    crm:P01_has_domain <b6b9eb4a-14ee-4d4f-ba29-650edd85ba11> ;
    crm:P03_has_range_literal "Lieutenant du roi (cf. MG-1682-04\\_203)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<2643f889-6216-49a2-830d-22f87d1930ea> a crm:PC3_has_note ;
    crm:P01_has_domain <c9c0e4be-e9be-44f2-b36e-896a50d8c3a6> ;
    crm:P03_has_range_literal "Maire de Château-Thierry (cf. [1698-01_021](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-01_021))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<264c69b7-e35e-4e16-b41d-580387779912> a crm:PC3_has_note ;
    crm:P01_has_domain <ead398d1-a898-42e4-9704-23e3603f0ae2> ;
    crm:P03_has_range_literal "Pensionnaire au collège de Clermont, fils du comte de Coffé (cf. [1680-08_305](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-08_305))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<26562bca-39b4-4792-b7db-9afca85a8490> a crm:PC3_has_note ;
    crm:P01_has_domain <ef6745a9-ba60-47b9-a14d-b9d0d50270d4> ;
    crm:P03_has_range_literal "Chanoine et maître des enfants de chœur de Saint-étienne de Troyes (cf. MG-1698-04\\_145), auteur d'un motet en musique chanté à Troyes le 31 mars 1698." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<265e301e-1acb-4cbd-8a75-179da25c9bb9> a crm:PC3_has_note ;
    crm:P01_has_domain <05d4452e-6f8b-427c-b7b0-84ae104d600a> ;
    crm:P03_has_range_literal "Gouverneur de Cognac (cf. [1677-07_142](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1677-07_142))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<2661b9d9-0986-4483-aaf3-4da907421913> a crm:PC3_has_note ;
