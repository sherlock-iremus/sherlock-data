<3967573b-8678-4815-ad86-7e921f7bac7b> a crm:PC3_has_note ;
    crm:P01_has_domain <f17e0f9e-5cb0-48f8-8ae3-70d3cb501d40> ;
    crm:P03_has_range_literal "Dangeau (Philippe de Courcillon, marquis de) (1638-1720), colonel du régiment du roi (1665-1670), gouverneur de Touraine (1666-1720), menin du dauphin (1680), grand-maître de l'ordre de Notre-Dame du Mont-Carmel et de Saint-Lazare de Jérusalem (1691), président de l'Académie royale des sciences (1706), mémorialiste" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

