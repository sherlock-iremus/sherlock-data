    crm:P03_has_range_literal "\"Ombre des Tuileries\" est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mai 1698 (cf. [1698-05_280](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-05_280))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95a234d9-2b62-4fcc-bfc8-07a87dd2fdb5> a crm:PC3_has_note ;
    crm:P01_has_domain <cf5a3768-8924-4f5c-bf02-d31298bc853f> ;
    crm:P03_has_range_literal "Official et grand vicaire de Poitiers (cf. MG-1687-09a_122)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95af9033-990b-4fc0-9c8f-511899a0a5b2> a crm:PC3_has_note ;
    crm:P01_has_domain <6f416c47-13b7-4693-b07e-1f28e8f02a16> ;
    crm:P03_has_range_literal "François de Bertier (1657-1723) a été chevalier et seigneur de Saint-Geniez (Saint-Geniès-Bellevue), mainteneur de l'Académie des Jeux floraux et premier président du Parlement de Pau (1703), puis de Toulouse (1710)” (cf. https://fr.wikipedia.org/wiki/François\\_de\\_Bertier, consulté le 24 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

