<cf1f9920-e225-4fe5-a2df-05ce4431d77f> a crm:PC3_has_note ;
    crm:P01_has_domain <5bb22f50-e2c8-45a6-a73f-4dda15e3d7dc> ;
    crm:P03_has_range_literal "M. Potier a réalisé les costumes du ballet « Sieg der Schönheit über die Helden », présenté lors du mariage du prince de Prusse en 1706 (cf. [1707-05_101](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-05_101))." ;
