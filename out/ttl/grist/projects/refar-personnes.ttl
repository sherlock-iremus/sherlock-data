    crm:P03_has_range_literal "Boivin (Jean) (1663-1726), professeur de grec au Collège royal (1706-1726), garde des manuscrits de la Bibliothèque du roi (1720-1726)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<375e7a81-6808-493d-9459-136e367edf9a> a crm:PC3_has_note ;
