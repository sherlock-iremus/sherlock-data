<9f8a4432-fe57-4d5d-aec5-068abf761e59> a crm:PC3_has_note ;
    crm:P01_has_domain <cf264bfa-6820-454e-ba59-a0bd3dfc5afc> ;
    crm:P03_has_range_literal "M. Thibault composa les paroles et la musique de deux airs parus dans le *Mercure galant* en 1708 (cf. MG-1708-08\\_372 et MG-1708-11\\_175)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9f939494-bbdb-47a3-9fe4-d584a5f0add0> a crm:PC3_has_note ;
    crm:P01_has_domain <999fb6fa-20e8-4350-8c32-db08d5a76207> ;
    crm:P03_has_range_literal "Adhémar de Montfalcon (Gabrielle-Pauline Bouthillier de Chavigny, comtesse d') (v. 1735-1822), dame du palais (1762-1768 ; 1774-1789), dame pour accompagner la dauphine (1770-1774)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9fc88003-90f7-4f6d-8177-8602f10a44f2> a crm:PC3_has_note ;
    crm:P01_has_domain <e128ba8f-60a4-46a6-a382-f3c6e4b3ebe6> ;
