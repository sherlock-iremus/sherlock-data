<766370dc-5e2c-487c-8503-476dddc7b5f8> a crm:PC3_has_note ;
    crm:P01_has_domain <61a77ae7-6113-4901-85da-9f6c298199c8> ;
    crm:P03_has_range_literal "Catherine Bionneau Guérin de La Gendronnière était la soeur de Françoise Bionneau Leshénaut de Bouillé (1661 ca-1736) et la femme de René Guérin de La Gendronnière (1641-1708), conseiller du roi." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<76a1b538-7132-4af2-a5e9-4cb0ade6844f> a crm:PC3_has_note ;
    crm:P01_has_domain <0da25bb2-2c03-4a29-bc04-acafb5cea66a> ;
    crm:P03_has_range_literal "Prêtre provençal, auteur d'une tragédie Le siècle d'or dans l'Isle de Malte, sous les Regne de son Eminence Nicolas de Cotoner publiée et représentée à Malte en janvier 1680 (cf. [1680-03a_012](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03a_012))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<76e284f1-e567-46b9-80f0-7d46688416e5> a crm:PC3_has_note ;
    crm:P01_has_domain <1e48b96d-aee0-4345-903a-0b8bd73cb911> ;
