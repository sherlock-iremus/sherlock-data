<55ef04e3-093c-45c8-b40e-4a8299c2bef3> a crm:PC3_has_note ;
    crm:P01_has_domain <b7c3a24c-ff61-4f7f-8f7f-9e595bcbe532> ;
    crm:P03_has_range_literal "Rigaud (Jacques) (1680-1754), dessinateur, graveur" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<55fb38da-15b6-4d13-9711-c7804925435a> a crm:PC3_has_note ;
    crm:P01_has_domain <544e00d1-3bea-4100-aaa9-03a935493fec> ;
    crm:P03_has_range_literal "G. Montbard a publié en 1708 une estampe (Illustrissimus Ecclesiae Princeps D. D. Carolus Le Goux de la Berchere […].). Il est mentionné dans le Mercure galant d'août 1710 en tant que graveur d'une estampe d'une cornaline antique du cabinet du roi (cf. MG-1710-08\\_074)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<56259ef7-b806-4c3a-82d3-7281b883ae93> a crm:PC3_has_note ;
