<65a943e7-17fb-4852-9e7b-b2d774e19aff> a crm:PC3_has_note ;
    crm:P01_has_domain <a7918e54-fc50-4762-bbdc-a117e52a1a74> ;
    crm:P03_has_range_literal "Pélagie-Constance de Brilhac (1688-1731) était la seconde épouse de Pierre de Brilhac, premier président au parlement de Bretagne entre 1703 et 1734 (cf. https://fr.wikipedia.org/wiki/Pierre\\_de\\_Brilhac, consulté le 21 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

