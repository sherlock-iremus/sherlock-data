<770a60a1-8f6b-4a6a-b637-f97f1df5e4c1> a crm:PC3_has_note ;
    crm:P01_has_domain <ee7e8fe5-1a92-4213-a264-353e5294e3d6> ;
    crm:P03_has_range_literal "Jacques-Alès de Brisay (fl. 1709) était « chevalier de Denonville, exempt des gardes du camp du Roi, fils de Jacques René de Brisay ». (cf. [https://www.siv.archives-nationales.culture.gouv.fr/siv/rechercheconsultation/consultation/ir/consultationIR.action;jsessionid=7AA2220C9F28241E9AB0EC4932F0124D?irId=FRAN\\_IR\\_041441&udId=c1p6uv8wyaxn-1clrx8c383am0&details=true&gotoArchivesNums=false&auSeinIR=true](https://www.siv.archives-nationales.culture.gouv.fr/siv/UD/FRAN_IR_041441/c1p6uv8wyaxn-1clrx8c383am0), consulté le 21 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<772a4d5a-2603-4be0-b5e2-fb436d2a950d> a crm:PC3_has_note ;
    crm:P01_has_domain <a8f41986-4750-4521-a522-f4b949e9abe7> ;
    crm:P03_has_range_literal "Organiste de la Musique du dauphin (cf. [1682-05_175](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-05_175))." ;
