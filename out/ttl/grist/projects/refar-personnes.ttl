    crm:P03_has_range_literal "M. Marcel est l'auteur des paroles d'airs publiés dans le *Mercure Galant* entre juin 1690 et juin 1693 (cf. MG-1690-06\\_340 ; MG-1690-08\\_033 ; MG-1691-04\\_037 ; MG-1693-06\\_315). Dans celui de janvier 1701, il publie également un madrigal (cf. MG-1701-01\\_009)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0ff2448c-a4f8-4606-852a-ca7f3cc52b66> a crm:PC3_has_note ;
    crm:P01_has_domain <1728252b-24b4-4efc-b31d-f20f38fdae7a> ;
    crm:P03_has_range_literal "La Baume-Suze (Anne-Louis-François de), aumônier du roi (1725-1736)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<10106037-d6ee-472f-8ce2-4c2f1458c2a6> a crm:PC3_has_note ;
    crm:P01_has_domain <0eb4f3f9-b9a0-439f-9ed3-abff935bd42d> ;
    crm:P03_has_range_literal "M. de Montigny, \"du Havre\", est l'auteur de deux airs publiés dans le *Mercure galant* en 1678 et 1679 (cf. MG-1678-07\\_034 et MG-1679-05\\_112)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

