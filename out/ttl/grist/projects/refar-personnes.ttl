<81be9c3d-866b-4cf3-9f3b-2ead9ef4c019> a crm:PC3_has_note ;
    crm:P01_has_domain <6807d013-7934-47ea-b872-31869ad7866c> ;
    crm:P03_has_range_literal "Le rédacteur du *Mercure Galant* attribue à M. de Maiz de la Flèche d'Anjou plusieurs airs publiés entre 1704 et 1707." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<821f8037-b3c1-4eee-845c-004de7ef4d5b> a crm:PC3_has_note ;
    crm:P01_has_domain <e63278f3-0b9b-41e7-9abb-f2dc943e4a92> ;
    crm:P03_has_range_literal "Jean-Rémy Hénault (1648-1737), fermier général et père de Charles-Jean-François, acheta pour son fils la Lieutenance des Chasses et le Gouvernement de Corbeil à sa sortie de l'Oratoire (Claude Jordan et al., Suite de la clé, Journal historique des matières du temps, Ganeau, Paris, juin 1771, vol. 109, p. 443). Un article du Mercure galant consacré aux réjouissances pour la naissance du duc de Bretagne indique qu'il se distingua alors par la fête qu'il fit donner à Corbeil dans le cadre de ses nouvelles fonctions (cf. MG-1704-07b_281)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<823bf495-9897-44e6-9e36-2dbb49e953ed> a crm:PC3_has_note ;
    crm:P01_has_domain <57f4258d-59c4-453e-ad57-141432caca38> ;
    crm:P03_has_range_literal "D'après le Mercure galant, Bernard d'Aspe était conseiller au Parlement et maire de Toulouse (cf. MG-1697-09\\_234) puis président à mortier au Parlement de Toulouse (cf. MG-1702-02\\_284)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8240476a-73f1-43a9-ad7d-4077599dfb08> a crm:PC3_has_note ;
