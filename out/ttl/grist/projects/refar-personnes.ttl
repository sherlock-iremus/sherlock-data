    crm:P01_has_domain <380ef96f-f1b0-4765-a935-603f53e96793> ;
    crm:P03_has_range_literal "Grand-pensionnaire de Hollande (1653-1672). Meurt assassiné par la foule avec son frère Cornelis." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

