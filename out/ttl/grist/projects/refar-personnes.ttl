    crm:P03_has_range_literal "Amigoni (Jacopo) (1682 ?-1752), peintre et graveur" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<03240dd1-b8d0-439e-b46c-ab79b2d38cdd> a crm:PC3_has_note ;
    crm:P01_has_domain <2bb5287a-a068-489f-8563-30a300376358> ;
    crm:P03_has_range_literal "Béthune-Charost (Julie-Christine-Régine Gorge d'Antraigues, duchesse de) (1688-1737), dame du palais (1725-1737)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<032a0ca0-cfdd-4fc1-8bd0-30b915ad4547> a crm:PC3_has_note ;
    crm:P01_has_domain <58e6a7b7-3ea2-4226-840a-9966a08865ef> ;
    crm:P03_has_range_literal "Sanson (Robert) (?-1698), receveur des consignations du parlement de Paris (1658-1697)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<032e5800-7e92-4c96-84df-2f36cdaf7b67> a crm:PC3_has_note ;
    crm:P01_has_domain <c13ff9d8-3bbe-4d22-8ee1-1b725c0e85e2> ;
    crm:P03_has_range_literal "M. Gouët, auteur de quatre airs parus dans le Mercure galant en 1678, était, d'après le périodique \"Maistre de Musique des Dames Religieuses de Lonchamp\" (cf. [1678-08_060](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-08_060), [1678-09_225](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_225), [1678-10_031](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-10_031), [1678-11_043](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-11_043))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0339dde1-d7b3-43c5-a947-497bc7f9d3cc> a crm:PC3_has_note ;
    crm:P01_has_domain <535d38df-2d53-4c4e-ac91-1e55ec692388> ;
    crm:P03_has_range_literal "Le Mercure galant indique que Jean Foloppe était avocat du roi (cf. [1704-07b_292](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_292)). Les archives civiles de la Seine Maritime précisent qu’il est devenu « avocat du roi au siège présidial de Caudebec » entre 1676 et 1690 (Inventaire-sommaire des Archives Départementales antérieures à 1790 de Seine inférieure, archives civiles, série C- 1328)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<033c4db2-15b1-43c4-b197-9be125179816> a crm:PC3_has_note ;
    crm:P01_has_domain <98f9c381-c9a4-4907-acf6-7144420efa66> ;
    crm:P03_has_range_literal "Renoueur et valet de chambre ordinaire du roi (cf. MG-1687-03b\\_291)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0343babe-bdaa-4ee9-b9f9-50edea96764d> a crm:PC3_has_note ;
    crm:P01_has_domain <26767cf0-8cae-465d-9f23-c263697e75b0> ;
    crm:P03_has_range_literal "M. Pivin, \"d'un pays où l'on ne fait point de scrupule de faire rimer Trompette avec Conqueste\", est l'auteur de quatre airs parus dans le *Mercure galant* en 1697 et 1698. Le *Mercure galant* indique que l'air paru en novembre 1697 a été chanté à Claye (de nos jours Claye-Souilly), au souper de la duchesse de Lorraine." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<036a0dc2-c617-4dd9-be9a-8e6859f09933> a crm:PC3_has_note ;
    crm:P01_has_domain <43686f37-90f5-4585-a2dc-d672a080bfe5> ;
    crm:P03_has_range_literal "Ancien docteur en théologie aux Cordeliers de Pontoise (cf. MG-1681-09\\_103)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0397a68a-0338-4e6d-9abc-c271ccff1c34> a crm:PC3_has_note ;
    crm:P01_has_domain <23bd074b-47cc-4de1-88b3-b2239bdb1877> ;
    crm:P03_has_range_literal "Galard de Terraube (Marie-Joseph de) (1736-1804), évêque du Puy-en-Velay (1774-1791)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<03b0909d-a083-4faf-b782-11a71d17948e> a crm:PC3_has_note ;
    crm:P01_has_domain <4311e67c-0ad8-4db6-95b9-94d236325e84> ;
    crm:P03_has_range_literal "**Grand bailli de Troyes (cf. MG-1682-10b\\_179).**" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<03b9ed69-dab5-4be1-b780-84c1a784bb85> a crm:PC3_has_note ;
    crm:P01_has_domain <165ea0ba-61b9-4b96-aa88-ebe4164ca4dd> ;
    crm:P03_has_range_literal "Chanoine de la cathédrale de Troyes, auteur du livret d'un Divertissement sur le retour de la paix mis en musique par M. Nerat, donné par la Société philarmonique de Troyes en juillet 1763." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<03f6923b-2227-4041-b22c-cb5bf313dedd> a crm:PC3_has_note ;
    crm:P01_has_domain <2ce6d283-7062-46dc-895e-831fa8a5d4c3> ;
    crm:P03_has_range_literal "M. du Breuil est l'auteur d'un air paru dans le *Mercure galant* d'août 1714 (cf. [1714-08_221](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1714-08_221))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<03fce078-6494-4c7f-ae8e-15121c4d6ad2> a crm:PC3_has_note ;
    crm:P01_has_domain <d67cbf56-b37f-476e-a867-3ce4d3330802> ;
    crm:P03_has_range_literal "M. France de Nola composa la musique d'un air publié dans le Nouveau Mercure (cf. MG-1717-09\\_156)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0403a15d-75ee-43ae-8704-4fe30fee4638> a crm:PC3_has_note ;
    crm:P01_has_domain <d34d29ab-7f26-405a-8490-d87f1d154170> ;
    crm:P03_has_range_literal "M. Pillet était le principal du collège de Dormans en 1704 (cf. [1704-08_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-08_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

