    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cc339426-5d5b-4843-ae35-f3246fe96a2d> a crm:PC3_has_note ;
    crm:P01_has_domain <df8f6f27-f681-465e-8763-88c37f4c4f2a> ;
    crm:P03_has_range_literal "Jean de Rémilly était bailli de Vendôme (cf. [1682-10b_227](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10b_227))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cc55ce4b-9b9f-4391-b02e-fb81a32945a0> a crm:PC3_has_note ;
    crm:P01_has_domain <4de2f405-2052-4bff-979c-7d54b7c43a13> ;
    crm:P03_has_range_literal "Johann Kasimir Kolbe von Wartenberg (6 février 1643 - 4 juillet 1712) fut premier ministre du Royaume de Prusse de 1697 à 1710. Le grand-chambellan de Frédéric Ier de Prusse, fut également maréchal du royaume, chancelier de l'Ordre de l'Aigle noir et Statthalter héréditaire de toutes les principautés, comtés et seigneuries de la succession d'Orange. (cf. https://fr.wikipedia.org/wiki/Johann\\_Kasimir\\_Kolbe\\_von\\_Wartenberg, consulté le 26 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cc657c95-e3db-4f11-943d-0c36ce34d75a> a crm:PC3_has_note ;
    crm:P01_has_domain <20cb886e-a853-4f68-a53c-b46af0f12c41> ;
    crm:P03_has_range_literal "Secrétaire de M. de Bourgeauville (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cc8fa4c0-21f4-4a23-ba56-dd3d3b67588c> a crm:PC3_has_note ;
    crm:P01_has_domain <8a96df5c-4a10-4849-9f59-c575509f1280> ;
    crm:P03_has_range_literal "Maître des comptes à Grenoble (cf. [1684-03_218](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-03_218))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

