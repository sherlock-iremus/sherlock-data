<1aee4945-8be4-44ef-9477-7c002fbd499e> a crm:PC3_has_note ;
    crm:P01_has_domain <3dacdcf4-f36b-41d9-a895-7dacfeb57ceb> ;
    crm:P03_has_range_literal "M. du Mesnil, du Hâvre, \"Capitaine Quarrenier\", est l'auteur de stances irrégulières adressées en 1687 au duc de Saint-Aigna (cf. MG-1687-02\\_073)." ;
