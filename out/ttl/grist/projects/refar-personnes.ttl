    crm:P03_has_range_literal "Official et grand vicaire de Poitiers (cf. [1687-09a_122](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-09a_122))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da0e7df3-df40-45a0-94de-258584584f71> a crm:PC3_has_note ;
    crm:P01_has_domain <2833fc86-6883-4da3-a2dc-5eba039ef950> ;
    crm:P03_has_range_literal "Jeanne Orry était la fille de Jean Orry (1652-1717)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da37b3e9-0685-42f5-8016-73b3ce8a711e> a crm:PC3_has_note ;
