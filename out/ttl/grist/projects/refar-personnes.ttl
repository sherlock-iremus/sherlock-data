    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45549360-7393-4424-9dca-d7d83f6024b7> a crm:PC3_has_note ;
    crm:P01_has_domain <ddd84701-081a-4cb2-b92e-fade154c69ae> ;
    crm:P03_has_range_literal "premier chef d'escadre des Galères de Marseille (1682.09)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<4559d181-28ac-472e-ba09-989506d72fac> a crm:PC3_has_note ;
    crm:P01_has_domain <f829131a-0994-4c9d-98be-22d4587720a3> ;
    crm:P03_has_range_literal "Mademoiselle de Ravetot participa aux réjouissances organisées à la cours lors du Carnaval 1702 (cf. [1702-02a_400](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_400))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45623eff-3888-4871-b4dd-5f5e233c6b83> a crm:PC3_has_note ;
    crm:P01_has_domain <c92f5e49-d8b0-4b34-bdf7-d0a3b0cb96dc> ;
    crm:P03_has_range_literal "D'après le *Mercure galant*, M. Normandeau était organiste du Collège de Navarre. Il est l'auteur de deux airs parus dans le périodique en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Il ne doit pas être confondu avec M. Normandeau l'aîné, dont le *Mercure galant* affirme en 1699 qu'il était \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205) qui pourrait être son fils." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45c6b0e3-ad3b-485e-acac-1d23c2b2a20f> a crm:PC3_has_note ;
    crm:P01_has_domain <c5906e17-a439-4d1a-9e17-036d4b622840> ;
    crm:P03_has_range_literal "Général de l'ordre des capucins (cf. [1693-08a_235](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-08a_235))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45c7f7c5-30fd-4b71-984e-2478a310d9a5> a crm:PC3_has_note ;
    crm:P01_has_domain <31a432ef-d73b-4432-a30b-a2718bfb2c0e> ;
    crm:P03_has_range_literal "L'abbé Charlet est l'auteur d'odes latines dont une Sur la guerre présente publiée dans le Mercure galant d'août 1702 dans la traduction de l'abbé Mauguin (cf. [1702-08_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_211))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45cccd72-fb6d-4b6c-8368-d6a6484698d4> a crm:PC3_has_note ;
    crm:P01_has_domain <e746d15b-e1ae-4499-aa48-c265538ce86f> ;
    crm:P03_has_range_literal "Compositeur d'un motet chanté à Saint-Malo (cf. [1687-03b_378](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_378))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45e14c30-352a-41c3-9ce7-a24fe32f02ee> a crm:PC3_has_note ;
    crm:P01_has_domain <184da222-2136-4aee-8837-246cf6a70c6a> ;
    crm:P03_has_range_literal "D'après le Mercure galant, M. Labbé, a été successivement maître de musique à Saint-Jacques de Dieppe (1678-1679) puis maître de musique de Caën (1679), avant de s'établir à Rouen \"comme un homme rare & qui passe pour un des plus habiles Musiciens du Royaume, non seulement pour l'Art de composer, mais aussi pour la belle métode du Chant, qu'il enseigne à tout ce qu'il y a de Personnes de qualité dans la Ville\" (cf. MG-1686-11a\\_070b). Il se serait formé auprès des meilleurs maîtres de Paris et auprès de Bacilly lors d'un passage de ce dernier en Normandie (cf. MG-1687-09a\\_350)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45e48163-74ab-4d37-9bb1-e1eb16616f1f> a crm:PC3_has_note ;
    crm:P01_has_domain <c08ea734-4fb2-4907-b37c-4c84023758f1> ;
    crm:P03_has_range_literal "Prieur des Pères Jacobins d'Amiens (cf. [1693-07_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-07_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45f983bd-d45f-4733-9594-adeb5e161d11> a crm:PC3_has_note ;
    crm:P01_has_domain <54c5e6d4-c884-445c-a63e-c03b6ab91d94> ;
    crm:P03_has_range_literal "Julien Clopin fut vicomte maïeur de la ville de Dijon de 1703 à 1711 (cf. <https://fr.wikipedia.org/wiki/Mairie_de_Dijon#Historique>, consulté le 19 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<45fe9e67-93dc-4d5b-8a25-317c1300a7f8> a crm:PC3_has_note ;
    crm:P01_has_domain <ca336b8e-6564-4ef7-b777-a86d4cd644fb> ;
    crm:P03_has_range_literal "Closneuf (Louis Fouquet de) (v. 1642 - 1714), exempt des gardes du corps de la reine mère, gentilhomme servant du roi (…1676-1708…), gentilhomme servant de la dauphine (…1683-1686…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<46072e6d-fb07-4f63-abdd-a771c501823e> a crm:PC3_has_note ;
    crm:P01_has_domain <67942f12-da42-4de4-bd01-347cd51d5ff7> ;
    crm:P03_has_range_literal "Chanoine de Notre-Dame et archidiacre de Josas." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<460cec71-55aa-4ba8-bff9-89b7a7388d41> a crm:PC3_has_note ;
    crm:P01_has_domain <4689332c-e034-4bd6-8280-0d5b3faa9146> ;
    crm:P03_has_range_literal "M. de Monbrun est l'auteur des paroles d'airs publiés dans le *Mercure Galant* d'octobre 1681 (cf. [1681-10_125](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-10_125), [1681-10_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-10_375)) et janvier 1682 (cf. MG-1682-01\\_275). Le *Mercure Galant* d'octobre 1681 précise qu'il est conseiller au Parlement de Toulouse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<46360dee-0932-4d12-a06a-c4eb77276ca4> a crm:PC3_has_note ;
    crm:P01_has_domain <fa03e9b8-bba7-453b-b80e-b11abb320452> ;
    crm:P03_has_range_literal "maître de chapelle du duc Jean-Frederic de Brunsvic et de Lunebourg (1677.08)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<463f5194-298a-457b-8b4c-eb90c380b94e> a crm:PC3_has_note ;
    crm:P01_has_domain <2fdcd452-4d36-415f-a56d-b5401a3f2fd5> ;
    crm:P03_has_range_literal "converti au catholicisme en décembre 1684" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<464be145-488b-48c8-861c-7d038aeefd2f> a crm:PC3_has_note ;
    crm:P01_has_domain <0bd9c2a0-e221-498f-8fd8-adfdc9deb8bb> ;
    crm:P03_has_range_literal "Chanoine de Saint-Martin-de-Tours, frère de Guillaume Guédier (cf. [1687-03b_299](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_299))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<467ad94a-e3e1-4e09-bb59-8e69696db96f> a crm:PC3_has_note ;
    crm:P01_has_domain <9346c228-82e8-46bd-9078-f43a9df8cf74> ;
    crm:P03_has_range_literal "Giovanni Agostino Centurione prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-04_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-04_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<468ba32e-6475-4143-8926-5f5f2051a8fe> a crm:PC3_has_note ;
    crm:P01_has_domain <08d0f0e0-2295-4b1a-a050-7348ba45cfa6> ;
    crm:P03_has_range_literal "Intendant de justice des trois évêchés (cf. [1681-08_53](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_53)) après avoir occupé les mêmes fonctions à Caen (novembre 1676-1677)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<46906ccf-44a3-464f-9630-a15fc07f985c> a crm:PC3_has_note ;
    crm:P01_has_domain <b05b0f00-34e8-4a39-be43-420008884068> ;
    crm:P03_has_range_literal "Procureur général de la cour des aides (cf. MG-1682-06\\_241)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<46960043-6284-4325-9eba-94127dd5245d> a crm:PC3_has_note ;
    crm:P01_has_domain <8242dfd0-0a7b-4957-9b4d-d782401e03ca> ;
    crm:P03_has_range_literal "Député de la Régence de Mecklenbourg (cf. [1693-02a_096](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-02a_096))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<46c9450b-b027-4d48-aa95-b641940bd943> a crm:PC3_has_note ;
    crm:P01_has_domain <53d2a78e-5555-4153-9cde-db1bf9d64dc4> ;
    crm:P03_has_range_literal "Boyer (Jean-François) (1675-1755), évêque de Mirepoix (1730-1735), précepteur du dauphin (1735-1743), premier aumônier de la dauphine (1743-1746), membre de l'Académie française (1736-1755)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<46d0ac7a-b403-4ab5-83c6-38d75c8db4fd> a crm:PC3_has_note ;
    crm:P01_has_domain <e48785ba-b68d-4e48-bbd0-4800ca5f872e> ;
    crm:P03_has_range_literal "M. Simart, de Sézanne, est l'auteur d'une parodie publiée dans le Mercure galant d'avril 1702 (cf. [1702-04_397](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-04_397))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<46dfda8e-cdff-4df1-ac78-ca9c45914b41> a crm:PC3_has_note ;
    crm:P01_has_domain <98c12ce4-8182-4d10-9358-a0f3422d3200> ;
    crm:P03_has_range_literal "Avocat à Montpellier, auteur du livret d'un opéra de M. de la Sabière qui y fut chanté en 1679 (cf. [1679-03_049](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-03_049))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

