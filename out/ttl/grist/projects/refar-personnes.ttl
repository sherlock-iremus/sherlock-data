<bacb1576-b622-4802-bd34-31fa6d306ca0> a crm:PC3_has_note ;
    crm:P01_has_domain <92950e2c-0175-402f-9448-53830a693d4d> ;
    crm:P03_has_range_literal "L'abbé Mauguin est l'auteur d'une traduction en vers d'une ode latine Sur la guerre présente de l'abbé Charlet, publiée dans le Mercure galant d'août 1702 (MG-1702-08\\_211)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

