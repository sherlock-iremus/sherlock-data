    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9fcec4b4-14b8-41ed-8b47-c45f40e9b485> a crm:PC3_has_note ;
    crm:P01_has_domain <be636175-10c2-434c-ab7f-421358ebc342> ;
    crm:P03_has_range_literal "Florent Galland du Désert était maître à danser et fils de François Galland du Désert, Chancelier de l’Académie Royale de Danse (cf. [1680-06_263](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-06_263)). Avec son frère, François II Galland du Désert, il constituait le duo “Des-Airs” (cf. Powell, John. “Pierre Beauchamps, Choreographer to Molière's Troupe du Roy” dans Music & Letters , Vol. 76, No. 2 (May, 1995), p. 172)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9ff6db98-f859-441d-b1f5-df7e943fa456> a crm:PC3_has_note ;
    crm:P01_has_domain <4df64fa0-4912-44f4-98b7-3fc8891465bb> ;
    crm:P03_has_range_literal "Bazire (Antoine) (?-?), garçon de la Chambre du roi, gentilhomme ordinaire de la Maison du roi, concierge de la petite écurie du roi du château de Saint-Germain-en-Laye (1699-1718...)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

