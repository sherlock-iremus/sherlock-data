    crm:P03_has_range_literal "Fille aînée du ministre d'état et grand maréchal de la cour de Württemberg (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<52bbd590-13aa-493f-a946-9d576b918fa8> a crm:PC3_has_note ;
    crm:P01_has_domain <d6c3a737-80e4-4c5f-91bd-c1a4d6beca66> ;
    crm:P03_has_range_literal "M. de la Tour est l'auteur de sept airs publiés dans le Mercure galant entre 1678 et 1720 (2 en 1678, 1 en 1693, 1 en 1705, 3 en 1719 et 1720). Il est toutefois difficile de savoir s'il s'agit du même compositeur ou non." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<52c0ca1d-a33f-4c25-93c8-f908c8f2b608> a crm:PC3_has_note ;
    crm:P01_has_domain <7966d0be-1c5c-4d71-ae3b-2b1cf6cdaf9e> ;
    crm:P03_has_range_literal "M. Maurin, « dont les Peres, & les Ayeuls possedent depuis long-temps les principales Charges de la Chambre des Comptes », assista à la célébration de la fête de Saint-Lazare à l’abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (MG-1703-01\\_210)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5328587e-12c3-4c19-9ae1-a7f5113071c6> a crm:PC3_has_note ;
