    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cd1e1fb4-4ac5-44a7-95f3-f44d3bafb611> a crm:PC3_has_note ;
    crm:P01_has_domain <dbcc94b5-864e-4278-a119-263358de299a> ;
    crm:P03_has_range_literal "Rusé (Louis Le Lièvre, sieur de) (v. 1655-1740), contrôleur des Bâtiments du roi à Saint-Germain-en-Laye (1683-1740) et Marly (1683-1699)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<cd46140f-e621-4af1-8f23-1c3379cf5bc0> a crm:PC3_has_note ;
    crm:P01_has_domain <13be8cd4-4fb1-44a0-aa2f-fd56881f0892> ;
    crm:P03_has_range_literal "Giuliano Spinola prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cd8954cf-49e1-4d9d-9dc7-24aba516c335> a crm:PC3_has_note ;
