    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<267661b4-94b4-41e9-9310-af2210b6a68b> a crm:PC3_has_note ;
    crm:P01_has_domain <0aae2018-5a13-4b28-b926-f7b33b0d6add> ;
    crm:P03_has_range_literal "garde des livres du cabinet du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<268fde84-3afd-459b-aa3e-b23fa52c884a> a crm:PC3_has_note ;
    crm:P01_has_domain <e1f7fd2a-c490-408e-bca4-639d6db4a6c7> ;
    crm:P03_has_range_literal "M. de Justin (fl. 1701) était récollet à Moissac (cf. [1701-01_160](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_160))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<26aaf073-b9ec-4b8b-a732-b26e8049e2a7> a crm:PC3_has_note ;
    crm:P01_has_domain <d7d4a03e-e9b6-4a14-b3fe-ad5fc18d900f> ;
    crm:P03_has_range_literal "Montausier (Julie d'Angennes, duchesse de) (1607-1671), gouvernante des Enfants de France (1661), dame d'honneur de la reine (1664)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<26c28221-840c-4b8d-9084-dd31e453cc05> a crm:PC3_has_note ;
    crm:P01_has_domain <6f392d12-0dd2-451e-bd9e-b5395bc5d625> ;
    crm:P03_has_range_literal "Auteur d'une énigme parue dans le Mercure galant." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<26ed996b-a6c4-4377-a6ba-63072b900c55> a crm:PC3_has_note ;
    crm:P01_has_domain <43020552-caa2-49c4-bf32-5307ac869ed4> ;
    crm:P03_has_range_literal "Demoiselle parisienne, qui épouse en 1679 Charles-François Monthelon (1651 ca-1703) (cf. MG-1679-10a_171)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<26fc1b77-461f-48ce-837f-a32abd90df56> a crm:PC3_has_note ;
    crm:P01_has_domain <f18a5a0a-c3a1-4305-b3a3-a6844f3b3dfb> ;
    crm:P03_has_range_literal "Auditeur de la chambre des comptes d'Aix-en-Provence (1687.03)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<271546aa-0c88-473d-81cc-a42153bee1eb> a crm:PC3_has_note ;
    crm:P01_has_domain <96004d58-1654-49ac-a00a-9ad8ac35f391> ;
    crm:P03_has_range_literal "Maire de Moulins (1680-1682, cf. MG-1682-10b\\_064)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<273166f7-49be-404f-abc6-c7b07915a6c5> a crm:PC3_has_note ;
    crm:P01_has_domain <fae13376-b7c9-4f4b-b8af-82d8904b3499> ;
    crm:P03_has_range_literal "Fils d'avocat, Jean-Baptiste Louis-Nicolas Salley, dit Sallé, fait d'abord une tentative de vie monastique, avant de se retrouver chantant l'opéra en province. Engagé dans la troupe du roi de Pologne, il fait des débuts à la Comédie en 1698 et réussit dans la tragédie comme dans la comédie. Ne pouvant rompre son engagement, il quitte Paris pour la Pologne et revient en 1701, reçu sociétaire après de nouveaux débuts. Il succède à De Villiers dans les rois, les ivrognes et les petits-maîtres. Sa belle voix de basse attire le public lorsque des divertissements accompagnent la comédie. Il meurt prématurément en 1706, remplacé dans son emploi par Ponteuil. (cf. https://www.comedie-francaise.fr/fr/artiste/salle, consulté le 1er mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<2744329f-c137-4eb8-b1ec-cbe0edeed384> a crm:PC3_has_note ;
    crm:P01_has_domain <c0ea5a0b-a6e2-4d9b-b584-55aed98521d3> ;
    crm:P03_has_range_literal "Le Prévost (Pierre-Robert) (1675-1735), prêtre, chanoine de l'église cathédrale de Chartres (1718-1735), prédicateur ordinaire du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<27529ae3-6553-4048-8dbc-a72122ec4c3e> a crm:PC3_has_note ;
    crm:P01_has_domain <35efcd1d-a44a-4d5d-893c-0918b6e70fb6> ;
    crm:P03_has_range_literal "Abbé, \"théologal de l'église de Paris\" (cf. MG-1687-09a\\_270)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<2775be56-0509-430d-af54-8e443fab53c3> a crm:PC3_has_note ;
    crm:P01_has_domain <6236e5d0-1d03-4970-b02e-03d171739efe> ;
    crm:P03_has_range_literal "M. Lesgu est l'auteur de trois airs publiés en 1678 dans le *Mercure galant* (cf. [1678-05_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-05_211), [1678-06_071](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_071), [1678-10_328](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-10_328))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<277ff8b1-8c4b-4a7e-aad4-bc12c90b849c> a crm:PC3_has_note ;
    crm:P01_has_domain <b2aabd67-aacc-4186-8a43-fbbaf0ba4ff5> ;
    crm:P03_has_range_literal "Premier ministre du roi de Siam (1680-1688)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27831d68-27c0-47e5-bb7a-362275fccb1b> a crm:PC3_has_note ;
    crm:P01_has_domain <971d3b14-098d-488b-bfa7-c979d7ab969e> ;
    crm:P03_has_range_literal "Conseiller du Présidial à Montargis (1687.03)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<278d54f5-80b6-4edf-b4b4-a468b717b62e> a crm:PC3_has_note ;
    crm:P01_has_domain <f810f37f-476d-4254-ba81-059cf2ddb098> ;
    crm:P03_has_range_literal "Anne-Armande de Saint-Gelais de Lansac était dame d'honneur de la reine de 1680 à 1683." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27a8a92b-435e-4362-93c4-2b86338ef50f> a crm:PC3_has_note ;
    crm:P01_has_domain <d1459012-0b1a-4e25-9264-42dcd01a56f1> ;
    crm:P03_has_range_literal "Lieutenant général de la ville et du vicomté de Pont-Audemer (cf. [1686-05_165](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-05_165))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27b0a9fd-2eb6-49da-99e4-79cefdc1b2c2> a crm:PC3_has_note ;
    crm:P01_has_domain <d91cfd0f-e9ff-4bef-9d54-f6b4dd30e112> ;
    crm:P03_has_range_literal "Lieutenant de la compagnie des chevaliers du jeu de l'arquebuse de Provins (cf. MG-1686-10a\\_073)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27d0f04c-4797-467e-b6cf-87cdcc4b091b> a crm:PC3_has_note ;
    crm:P01_has_domain <06dcf0a1-acec-4256-82e8-80ba9ed281cd> ;
    crm:P03_has_range_literal "M. Normandeau l'aîné, \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205), ne doit pas être confondu avec M. Normandeau, auteur de deux airs parus dans le *Mercure galant* en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Ce dernier était peut-être le père de l'ancien page." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27dc2a4e-42e5-41ef-8bb5-ade0d25cee99> a crm:PC3_has_note ;
    crm:P01_has_domain <8f71b0de-8912-4b55-a9fe-9123694880be> ;
    crm:P03_has_range_literal "Musicien, inventeur de l'apollon, instrument à cordes, demeurant dans le cloître de Saint-Jean-de-Grève (cf. MG-1678-01_122)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27e1ed01-a267-41ed-8944-8a023f22f0ec> a crm:PC3_has_note ;
    crm:P01_has_domain <29b97f47-89c6-4c7f-8656-229e66d2c41f> ;
    crm:P03_has_range_literal "Pierre-Jean le Chapelier de Moron, abbé de Bosquein, a été grand-maître du Collège des Quatre-Nations de 1688 jusqu'à sa mort en 1721 (cf. Franklin, Alfred, Histoire de la Bibliothèque Mazarine et du Palais de l'Institut, Paris, H. Welter, 1901, p. 243)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27e99433-1d6c-4c7a-9bdd-8a13c10f3c42> a crm:PC3_has_note ;
    crm:P01_has_domain <62b82915-97d8-4f36-805f-ba6fc6bbc07a> ;
    crm:P03_has_range_literal "Cordier (Nicolas François, dit) (1704-1792), garde du corps de la duchesse d'Orléans, cavalier de la compagnie de la maréchaussée de l'Île-de-France" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<27f08d65-d180-4922-acb8-d7ee8c5a3039> a crm:PC3_has_note ;
    crm:P01_has_domain <8dd78a25-a07b-4778-bd9c-c10aed9bb208> ;
    crm:P03_has_range_literal "Auteur d'un sonnet publié dans la livraison d'août 1702 du Mercure galant (cf. MG-1702-08\\_5), résidant à Saint-Laurent dans le Périgord. M. Robert publia en juillet de la même année l'épitaphe de Nicolas-Antoine Lebègue (MG-1702-07a\\_268), mais rien ne permet d'affirmer avec certitude qu'il s'agit d'une seule et même personne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<27fe0a87-fe8e-476c-8b63-866150c0c2e3> a crm:PC3_has_note ;
    crm:P01_has_domain <5bd2495b-3457-42fe-aaac-f4aa7f08cbac> ;
    crm:P03_has_range_literal "Patris de Cougousse (Louis de) (1773-1811), page de la comtesse d'Artois (1787-1789), sous-lieutenant dans la légion de Mirabeau (1793), sous-lieutenant dans la légion d'Hœnloe (1795-…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<2817ed76-8a96-45e6-9d30-fb4dcd50f825> a crm:PC3_has_note ;
    crm:P01_has_domain <a944c91d-beae-4f9c-aac4-4c4f4e69d756> ;
    crm:P03_has_range_literal "Commissaire provincial des Guerres, capitaine des arquebusiers de Soissons (cf. MG-1682-10b\\_246)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<282bdd5c-bc45-4918-b20f-4e44f75a3f7c> a crm:PC3_has_note ;
    crm:P01_has_domain <82504d3a-4cd8-4bc7-9c0b-ebf4565cf291> ;
    crm:P03_has_range_literal "Importante famille de papetiers français. Actifs au moins entre 1751 et 1809." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<28476a98-066b-4ada-8a76-4abc5e950cdd> a crm:PC3_has_note ;
    crm:P01_has_domain <d80ad849-3d64-4c14-a361-7938c071c175> ;
    crm:P03_has_range_literal "Le Mercure galant de juillet 1704 consacré aux réjouissances organisées pour célébrer la naissance du duc de Bretagne mentionne M. de Brissac, alors pensionnaire au collège Louis-le-Grand (cf. [1704-07b_178](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_178)). Il figure au programme d’une représentation de théâtre du même collège, en avril 1701 (https://catalogue.bnf.fr/ark:/12148/cb333947409)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<2885e535-c00f-481c-9519-ac53a928c1ec> a crm:PC3_has_note ;
    crm:P01_has_domain <cd36c500-6a3a-449c-87df-1554303e9647> ;
    crm:P03_has_range_literal "Doyen du chapitre de Saint-Séverin à Bordeaux (cf. MG-1691-09\\_067)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<288c59b6-1b7f-49ec-b3a2-d5b59239b811> a crm:PC3_has_note ;
    crm:P01_has_domain <a6ec6611-3a56-4232-baed-0a1c93809bdf> ;
    crm:P03_has_range_literal "Maître de musique à Tours (1693.02)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<288d0779-3700-42dd-802d-34c25f135bbc> a crm:PC3_has_note ;
    crm:P01_has_domain <03d48361-9527-4548-9115-757279dcf256> ;
    crm:P03_has_range_literal "Conseiller au parlement (cf. [1678-06_222](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-06_222))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<288f663b-8faf-483e-be00-4527d6e55075> a crm:PC3_has_note ;
    crm:P01_has_domain <27fd7254-d52e-447a-a83a-03b33b160870> ;
    crm:P03_has_range_literal "Louis Frotier de la Coste-Messelière a été chancelier de l'université de Poitiers ainsi que docteur en théologie. Il était également le frère de Charles Frotier de la Coste-Messelière (1664-1727)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<28a08284-e668-4dc1-a32d-f0f32732e5c7> a crm:PC3_has_note ;
    crm:P01_has_domain <77fc7aed-15aa-4a91-8b28-39e61344ce2c> ;
    crm:P03_has_range_literal "Clément (Nicolas) (1647-1712), commis copiste chez Colbert (…1670), garde des planches et estampes de la Bibliothèque du roi (1670…), commis à la garde de la Bibliothèque du roi (1691-1712)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<28bca20c-6288-4d04-98d9-b4424c78d1f8> a crm:PC3_has_note ;
    crm:P01_has_domain <5f2bac6f-b9b4-4be6-8d19-e2f7f163fa92> ;
    crm:P03_has_range_literal "Judde de Grainville (Nicolas) (1729-1772), grand maître des Eaux et Forêts de Soissons (1760)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<28f236f0-3742-419e-affb-3189c8236a20> a crm:PC3_has_note ;
    crm:P01_has_domain <60888f33-f011-4e7f-affb-a0cc86288729> ;
    crm:P03_has_range_literal "Curé de l'église Notre-Dame de Niort (cf. MG-1692-11_188)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<28f6dd02-6da3-4a89-a1ae-1f77f5ac98f8> a crm:PC3_has_note ;
    crm:P01_has_domain <b7b59a65-a293-4fd6-9d93-1b65b6ab295d> ;
    crm:P03_has_range_literal "Tréheux (Étienne) (1651-1717), garçon ordinaire de la Chambre et du Cabinet de la reine (...1683), valet de la garde-robe du roi, garçon ordinaire de la Chambre et du Cabinet de la duchesse de Bourgogne, concierge de la surintendance des Bâtiments du roi à Saint-Germain-en-Laye (1692-1712...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<29145feb-e776-4486-b08a-7fb2cd291c3f> a crm:PC3_has_note ;
    crm:P01_has_domain <c3fdbad3-1fb7-4300-8ee2-f0d23d35bd9c> ;
    crm:P03_has_range_literal "Lieutenant criminel au Châtelet de Paris." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<29441780-6829-43b3-99d2-678fb96d81c8> a crm:PC3_has_note ;
    crm:P01_has_domain <44912f50-c7f3-4a3a-ace6-63ccd126f736> ;
