<8e893a1e-22b8-4117-acec-804934b83c88> a crm:PC3_has_note ;
    crm:P01_has_domain <6469c976-c565-4dcd-8e5a-4dd810cc0ba7> ;
    crm:P03_has_range_literal "Sénéchal de Bourgueil (1687.03 ; 1694.02)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<8ec5ff4a-67e1-4a9e-9e9a-fcf077c0fb4e> a crm:PC3_has_note ;
    crm:P01_has_domain <9e647a56-85ec-4f5f-b81b-d3bfd649c9d3> ;
    crm:P03_has_range_literal "Gilles Le Sourd fut principal du Collège de la Marche (1689) puis recteur de l’université de la Sorbonne à Paris. Il fut également curé de la paroisse Saint-Paul de 1692 à 1711." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8ed3a141-5b2f-4976-a1a9-d43c7e04fca3> a crm:PC3_has_note ;
    crm:P01_has_domain <73e316ff-4a5e-40f0-938b-efb6d7da8723> ;
    crm:P03_has_range_literal "Dame d'honneur de la duchesse de Hanovre (cf. [1684-12_136](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-12_136))" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8edf2db1-30ac-4572-a289-b9967ddc3c35> a crm:PC3_has_note ;
