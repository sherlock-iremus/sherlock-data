    crm:P03_has_range_literal "Mme du Poscq était la reine d'une course de tête organisée à Caen lors du Carnaval de 1703 (cf. [1703-02_178](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-02_178))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

