<59aa29d9-f7ce-478f-8cad-12c2ac93c290> a crm:PC3_has_note ;
    crm:P01_has_domain <e63278f3-0b9b-41e7-9abb-f2dc943e4a92> ;
    crm:P03_has_range_literal "Jean-Rémy Hénault (1648-1737), fermier général et père de Charles-Jean-François, acheta pour son fils la Lieutenance des Chasses et le Gouvernement de Corbeil à sa sortie de l'Oratoire (Claude Jordan et al., Suite de la clé, Journal historique des matières du temps, Ganeau, Paris, juin 1771, vol. 109, p. 443). Un article du Mercure galant consacré aux réjouissances pour la naissance du duc de Bretagne indique qu'il se distingua alors par la fête qu'il fit donner à Corbeil dans le cadre de ses nouvelles fonctions (cf. [1704-07b_281](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_281))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

