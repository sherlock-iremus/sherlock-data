    crm:P03_has_range_literal "La Minière (Félix-Louis de Cornette de) (1733-1794), secrétaire du duc de Coigny (…1772…), garde des livres du Cabinet du roi à Choisy (…1775-1785…), secrétaire général des dragons, trésorier de la capitainerie royale de la varenne du Louvre" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7a1ca536-faab-4a41-a789-41fc47952e8c> a crm:PC3_has_note ;
    crm:P01_has_domain <e4031b1d-3426-42c2-b443-572a1b96a370> ;
