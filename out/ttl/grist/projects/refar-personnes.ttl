<3476c40f-b17e-4a6b-9978-13310fb8274b> a crm:PC3_has_note ;
    crm:P01_has_domain <a58ed6f2-7d86-4ef5-a277-0ee0e76aef68> ;
    crm:P03_has_range_literal "M. de la Fevrerie était un contributeur du *Mercure Galant* qui publia en février 1695 sa \"Réponse à la Satire contre les Vers irreguliers employée dans le Mercure du mois d'Avril 1694\" (cf. [1695_02_236](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1695_02_236)) et écrivit les paroles d'un air publié dans le *Mercure Galant* de décembre 1708 (cf. MG-1708-12\\_267)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

