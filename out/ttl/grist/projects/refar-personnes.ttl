    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<56bdbec6-4a79-4be0-8d39-a0381595fbdf> a crm:PC3_has_note ;
    crm:P01_has_domain <e9819d87-d211-4e1a-8ed6-a023f24eb794> ;
    crm:P03_has_range_literal "Pierre de Malézieu était secrétaire des commandements du duc de Maine, secrétaire général des Suisses et des Grisons (1727), brigadier d'infanterie, maréchal de camp (1734), lieutenant général de l'artillerie de France et des armées du roi, commandeur de l'ordre de Saint Louis (1756)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<56d520e4-55df-4342-b4db-8ac971646791> a crm:PC3_has_note ;
    crm:P01_has_domain <cad671a2-a957-4876-be12-8b7b260a19b2> ;
    crm:P03_has_range_literal "Sous-aide major du régiment des gardes (cf. [1683-01_272](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-01_272))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<576f0b99-6cba-4437-ac28-09c53f6bf4f2> a crm:PC3_has_note ;
    crm:P01_has_domain <920ef489-ab54-48d5-932a-73b448129f07> ;
    crm:P03_has_range_literal "«  Professeur des Humanitez  » au collège de Saint-Germain, auteur d'un divertissement représenté lors de la célébration de l'anniversaire du roi (cf. [1691-09_134](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-09_134))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<5773d9ef-80e4-4c09-a4b1-762f13697e71> a crm:PC3_has_note ;
