    crm:P03_has_range_literal "Francisco Maria Serra prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

