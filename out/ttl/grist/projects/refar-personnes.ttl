    crm:P03_has_range_literal "Ancenis (Marthe-élisabeth de La Rochefoucauld de Roye, duchesse d') (1720-1784), dame du palais de Marie Leczinska (1737-1745)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<08ee0234-00e7-43f6-8c6b-466e920ef0eb> a crm:PC3_has_note ;
    crm:P01_has_domain <8d95ef5f-b852-4a92-9868-73ee7fce84ec> ;
    crm:P03_has_range_literal "Françoise Bionneau était l'épouse d'Antoine Hercule Leshénaut de Bouillé (1658-1701), écuyer, et capitaine des gardes de Monsieur." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<090157c6-f3cb-413e-adfc-2b143824a5db> a crm:PC3_has_note ;
