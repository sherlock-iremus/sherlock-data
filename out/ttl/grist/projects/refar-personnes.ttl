    crm:P03_has_range_literal "Hébert (Laurent) (?-1695), musicien ordinaire de la reine (…1644-1683), musicien ordinaire de la Chambre du roi (…1664-1695)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<639de56b-203a-4fe5-a020-f9c73b3c14ea> a crm:PC3_has_note ;
    crm:P01_has_domain <f1012b3a-6d53-4ca3-801b-7282ab29987a> ;
    crm:P03_has_range_literal "Compositeur provençal, auteur d'un Te Deum en musique chanté à Marseille en février 1687 (cf. MG-1687-04\\_074)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<63a3ca4c-223e-455b-847d-7192866be966> a crm:PC3_has_note ;
    crm:P01_has_domain <be636175-10c2-434c-ab7f-421358ebc342> ;
    crm:P03_has_range_literal "Florent Galland du Désert était maître à danser et fils de François Galland du Désert, Chancelier de l’Académie Royale de Danse (cf. MG-1680-06\\_263). Avec son frère, François II Galland du Désert, il constituait le duo “Des-Airs” (cf. Powell, John. “Pierre Beauchamps, Choreographer to Molière's Troupe du Roy” dans Music & Letters , Vol. 76, No. 2 (May, 1995), p. 172)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<63ab2e02-2616-415c-bb64-5b0c5c95fe6c> a crm:PC3_has_note ;
    crm:P01_has_domain <a9cd6e64-dc13-4b3c-978a-198245d34443> ;
    crm:P03_has_range_literal "Pseudonyme d'un habitant du Havre dont une explication en vers d'une énigme de décembre 1683 est parue dans le Mercure galant (cf. MG-1684-03e\\_084)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<63db10c9-3a33-4a55-87c2-97ca47641523> a crm:PC3_has_note ;
    crm:P01_has_domain <4cd6e542-388c-45c1-9342-645d9607d648> ;
    crm:P03_has_range_literal "Mademoiselle de Des Marest participa aux réjouissances organisées à la cours lors du Carnaval 1702 (cf. MG-1702-02a\\_400)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<63e23a51-b6c6-4f39-a942-3b70fa67016c> a crm:PC3_has_note ;
    crm:P01_has_domain <ef0e5720-0df9-4957-8cad-2f5758a2ec57> ;
    crm:P03_has_range_literal "Ignace-François de Limojon de Saint Didier a présenté en 1701 au duc d'Anjou et à ses frères une ode lors de leur passage à Avignon. Il est aussi mentionné qu'il est le neveu d'Alexandre-Toussaint de Limojon (1630?-1689), chevalier de Saint Didier (cf MG-1701-05B\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<645a0c27-3e79-4e2e-807d-cdd3124a0ef7> a crm:PC3_has_note ;
    crm:P01_has_domain <3dacdcf4-f36b-41d9-a895-7dacfeb57ceb> ;
    crm:P03_has_range_literal "M. du Mesnil, du Hâvre, \"Capitaine Quarrenier\", est l'auteur de stances irrégulières adressées en 1687 au duc de Saint-Aigna (cf. [1687-02_073](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-02_073))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<64748862-c3f1-4ed3-b34d-6c10a581a526> a crm:PC3_has_note ;
    crm:P01_has_domain <4d67db05-4ff8-4cd9-b23c-fa45755ef34e> ;
    crm:P03_has_range_literal "Musicien français, vivant à Paris vers 1750." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<649fff7e-3dc2-49ad-92ed-a24b932ce6ce> a crm:PC3_has_note ;
    crm:P01_has_domain <36cd82dd-3d4b-4f74-a433-cb84b6d87bdc> ;
    crm:P03_has_range_literal "M. Mourette est l'auteur de trois airs publiés dans le *Mercure galant* en 1721 (cf. [1721-03_173](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1721-03_173), [1721-04_156](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1721-04_156), [1721-05_134](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1721-05_134))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<64b22dcd-07c6-4bec-82b9-52d961e4b20a> a crm:PC3_has_note ;
