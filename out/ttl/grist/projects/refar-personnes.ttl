    crm:P01_has_domain <7451b65f-1cdd-4226-be4b-932a454d575a> ;
    crm:P03_has_range_literal "Président du bureau des finances à Metz (cf. MG-1687-03b_284)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6ec47b7-61e3-4ac7-8983-e15bc4bb1d87> a crm:PC3_has_note ;
    crm:P01_has_domain <9e9594d8-d2a5-48f6-a53f-ab202a9491f9> ;
    crm:P03_has_range_literal "Francesco Audiberti de Saint-Étienne-Villefranche prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (MG.1702-04\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6f1e470-18f4-4c30-9f22-7664bc6b82e4> a crm:PC3_has_note ;
    crm:P01_has_domain <6236e5d0-1d03-4970-b02e-03d171739efe> ;
    crm:P03_has_range_literal "M. Lesgu est l'auteur de trois airs publiés en 1678 dans le *Mercure galant* (cf. MG-1678-05\\_211 ; MG-1678-06\\_071 et MG-1678-10\\_328)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6f67be4-575e-444f-9ffd-a60da3f83d7d> a crm:PC3_has_note ;
    crm:P01_has_domain <8a9865e5-3023-4a4b-9584-6e874a589aac> ;
    crm:P03_has_range_literal "M. Mouton, maître de musique de la cathédrale Saint-Étienne de Troyes, est l'auteur de la musique d'un Te Deum exécuté par le Petit concert de Troyes le 27 juillet 1756 pour célébrer la prise du fort Saint-Philippe (cf. Annonces, affiches et avis divers. 8 septembre 1756, n° 36, p. 143)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a6fcf519-99b3-48c0-a449-17cd57c8bdd3> a crm:PC3_has_note ;
    crm:P01_has_domain <33b68f77-d7b1-4a62-9d60-fd32c93a4c5a> ;
    crm:P03_has_range_literal "M. Du Pré était \"Grand vicaire & Official de Sez\" (cf. MG-1687-07\\_149)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a712de58-fcdd-4983-a45b-d1cb17513552> a crm:PC3_has_note ;
    crm:P01_has_domain <46b9e9a8-407b-44d1-9cfb-d21dbed68601> ;
    crm:P03_has_range_literal "Père jésuite allemand qui confessa la dauphine à la Toussaint 1687 (cf. MG-1687-11\\_004)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a72f1ece-1952-4d91-b12c-a5659dfbc582> a crm:PC3_has_note ;
    crm:P01_has_domain <2fbd0ea7-961a-420c-a375-329d73de6aea> ;
    crm:P03_has_range_literal "Rabbin de la synagogue de Metz (cf. MG-1692-03_219)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a733fb55-96ee-4b04-bd42-1a7b7bc53e6e> a crm:PC3_has_note ;
    crm:P01_has_domain <1234dfc9-5088-4d26-a45d-c1db4d52e6d6> ;
    crm:P03_has_range_literal "Premier président du conseil d'Artois (1685-1687)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a74d4ef9-b1d6-48e7-a25a-3e78d9c51d32> a crm:PC3_has_note ;
    crm:P01_has_domain <e3799865-2bdf-4d58-b673-5b1b34cfd534> ;
    crm:P03_has_range_literal "Du Plessis d'Argentré (Charles) (1673-1740), aumônier du roi (1709-1725), évêque de Tulle (1725-1740)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7705bc7-bf3a-4f77-96b8-14983a44e991> a crm:PC3_has_note ;
    crm:P01_has_domain <7a6eebdb-f15a-45af-842f-afeb19fa3957> ;
    crm:P03_has_range_literal "Louis Colbert, comte de Linières (1667-1745) était abbé commendataire de Bonport, prieur de Nogent-le-Rotrou, garde de la Bibliothèque du roi (1676-1684)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7850698-d995-4bf4-bf9a-ffaec46a81ba> a crm:PC3_has_note ;
    crm:P01_has_domain <76e9a41f-e62e-4597-946e-d841ee96b049> ;
    crm:P03_has_range_literal "Richelieu (Louis-Alphonse Du Plessis de) (1582-1653), grand aumônier de France (1632-1653)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a797d9b9-92c5-46d3-ad64-93b21df3653e> a crm:PC3_has_note ;
    crm:P01_has_domain <d80ad849-3d64-4c14-a361-7938c071c175> ;
    crm:P03_has_range_literal "Le Mercure galant de juillet 1704 consacré aux réjouissances organisées pour célébrer la naissance du duc de Bretagne mentionne M. de Brissac, alors pensionnaire au collège Louis-le-Grand (MG-1704-07b\\_178). Il figure au programme d’une représentation de théâtre du même collège, en avril 1701 (https://catalogue.bnf.fr/ark:/12148/cb333947409)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7a37de1-b1f8-4890-a188-b7a5fab40df2> a crm:PC3_has_note ;
    crm:P01_has_domain <d48250f4-c387-490b-8ea5-5125aa66816b> ;
    crm:P03_has_range_literal "Dame de Bordeaux (cf. MG-1682-09b_015)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7dfbb3a-3635-430b-9a5c-9052a1c102d1> a crm:PC3_has_note ;
    crm:P01_has_domain <f86382f5-0d57-404a-ade7-bd85387bd577> ;
    crm:P03_has_range_literal "Marie de Rivault était l'épouse de Mathieu Douart (1643-1711), avocat du roi et seigneur du Tertre, ainsi que la mère de Mathieu Douart (fl. 1710), écuyer de la duchesse de Bourgogne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7f36aef-d450-4bd5-8f36-887c2bce73cc> a crm:PC3_has_note ;
    crm:P01_has_domain <c60dd705-c650-4abf-b250-cd83d86bde57> ;
    crm:P03_has_range_literal "Conseiller au Parlement de Paris, Intendant de Moulins, Président au Grand Conseil." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7f76ea4-3bcf-4279-816f-385c0fefd89c> a crm:PC3_has_note ;
    crm:P01_has_domain <e5ccfe8f-3835-4f82-a6dc-74a80ce6cd3e> ;
    crm:P03_has_range_literal "Argenson (Marc-Antoine-René de Voyer de Paulmy, marquis de) (1722-1782), ministre d'état et diplomate" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a7fd7351-e175-4a87-98b0-0b36dd17fb38> a crm:PC3_has_note ;
    crm:P01_has_domain <193d3f6c-f688-410f-a9fe-7635d200c1e7> ;
    crm:P03_has_range_literal "Gontaut (Marie-Adélaïde de Gramont, duchesse de Biron, dite duchesse de) (1700-1740), dame du palais de la reine (1725-1740)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a8d92e24-4131-49ae-ae69-429d0ae5836d> a crm:PC3_has_note ;
    crm:P01_has_domain <1b0d552f-9235-4ee8-a7a0-e86aafded215> ;
