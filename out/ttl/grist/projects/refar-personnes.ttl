<e44709c0-1c35-4436-8db9-c6324bcb0657> a crm:PC3_has_note ;
    crm:P01_has_domain <420b8125-be66-4950-a3ca-aabaaa254ccd> ;
    crm:P03_has_range_literal "Religieuse au Couvent des Filles de l'Assomption de Paris (cf. [1679-04_335](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-04_335))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e455899d-dfd1-4790-910f-6e578dcfe9fa> a crm:PC3_has_note ;
    crm:P01_has_domain <2ccf59e0-a6f4-4248-a674-b30321c26896> ;
    crm:P03_has_range_literal "Mlle Bataille est l'auteur de quatre airs publiés dans le Mercure galant entre 1699 et 1702. Dans sa livraison de novembre 1699, le rédacteur du Mercure galant parle d'elle en ces termes : \"C'est une jeune personne de seize ans, qui possede a fonds la Musique, & le Clavessin. Elle execute à livre ouvert les pieces les plus difficiles, & les transpose sur tous les tons qu'on veut, avec une facilité qui passe l'imagination. Plusieurs Maistres des plus habiles qui on été témoins de ce qu'elle sçait faire, ont esté surpris de sa capacité. Elle enseigne aux personnes de son sexe, & va donner ses Leçons accompagnée d'une Mere, dont la sagesse & la conduite paroissent avantageusement dans l'éducation qu'elle s'est attachée à luy donner. Elle demeure dans la ruë Christine, entre Madame de Monchal, & Mr de Montelon. (cf. [1699-11_089](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1699-11_089)).\" Elle mit en musique trois poèmes de Tamiriste, pseudonyme d'un lecteur et auteur publiée dans le périodique qui le mentionne entre 1681 et 1709." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e4600b6c-7bb3-49dc-b1f5-bbf994ecc0e9> a crm:PC3_has_note ;
    crm:P01_has_domain <b20e6819-aae0-49b5-b939-2c5a480e4ab8> ;
    crm:P03_has_range_literal "première fille d'honneur de la duchesse de Hanovre (1681.04 et 08)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e46860fc-871d-4b32-ac56-969e5c39515e> a crm:PC3_has_note ;
