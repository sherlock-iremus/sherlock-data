<d05a877b-f7d6-401a-a7f2-70c4fa1ebf1b> a crm:PC3_has_note ;
    crm:P01_has_domain <f6ab33c1-d16c-414a-a9be-2e49af5cc816> ;
    crm:P03_has_range_literal "Joan de Rojas y Solorzano, auteur d'un sonnet en espagnol publié dans le Mercure galant de février 1702, était secrétaire de Philippe V d'Espagne (cf. [1702-02a_301](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_301))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d0793df9-4e4b-4786-9cbe-aabc2c25b8d5> a crm:PC3_has_note ;
    crm:P01_has_domain <53cd1f57-e582-4348-a9cc-d8f38b583f70> ;
    crm:P03_has_range_literal "Maître de musique de la cathédrale d'Arras (cf. [1687-04_074](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-04_074))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d08308b1-94a5-4fc7-8067-26dddffedc72> a crm:PC3_has_note ;
    crm:P01_has_domain <d72b9959-3c26-42be-8155-873e2db9594f> ;
    crm:P03_has_range_literal "M. Ozon est l'auteur des paroles d'un air publié dans le *Mercure Galant* d'août 1719 (cf. MG-1719-08\\_148)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d0d21a7c-ad44-4cfd-9097-7c746cff9f80> a crm:PC3_has_note ;
    crm:P01_has_domain <e0884e1a-017a-4d82-b574-13c383de8e85> ;
    crm:P03_has_range_literal "Fr. Bizotton a été maire d'Orléans de 1705 à 1707 (cf. <https://www.annuaire-mairie.fr/ancien-maire-orleans.html>, consulté le 24 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d0dbde72-3d2c-475b-8704-023303d0035d> a crm:PC3_has_note ;
    crm:P01_has_domain <8c365810-e1ce-4b2d-a970-a038ded2c2ca> ;
    crm:P03_has_range_literal "Intendant de la Flandre (1672-1680)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d126e327-4284-4af0-911c-855088964801> a crm:PC3_has_note ;
    crm:P01_has_domain <7cfcc2db-1fb1-427a-b931-18db57d80801> ;
    crm:P03_has_range_literal "Juan Francisco Pacheco Téllez-Girón y Mendoza a été ambassadeur d’Espagne à Rome (cf. Hanotin, Guillaume, *«L’union des couronnes: images et pratique»,* *Ambassadeur de deux couronnes: Amelot et les Bourbons entre commerce et diplomatie* [en ligne], Madrid, Casa de Velázquez, 2018 (généré le 29 mars 2021). Disponible sur Internet: <http://books.openedition.org/cvz/5213>.ISBN: 9788490961803.)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d13b585e-dac3-41f6-8415-52c36363fe38> a crm:PC3_has_note ;
    crm:P01_has_domain <cecc3176-d5d1-4bd9-ae28-3d67c084d414> ;
    crm:P03_has_range_literal "Mlle d'O est l'autrice de deux airs parus dans le *Mercure galant* en 1680. En septembre 1680, le périodique affirme \"[qu'] elle est du Quartier S. Paul, dont elle fait un des plus beaux ornemens, & tres-digne Fille d'une Mere qui ayant esté dans son Printemps la plus aimable du monde, conserve dans son Eté tous les agrémens que peuvent avoir celles de son âge.\" (cf. MG-1680-09a\\_340 et MG-1680-11\\_045)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d16f99c3-0d33-4b46-b768-f92f9a15e9eb> a crm:PC3_has_note ;
    crm:P01_has_domain <8fc514c1-b164-451b-8af0-aa85fd28dbc5> ;
    crm:P03_has_range_literal "écuyer du Dauphin dans un carousel (cf. MG-1685-04\\_246)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d173394b-3d7e-461c-bb1c-0e82be3a99e7> a crm:PC3_has_note ;
