<389e7257-ab3d-4ad9-b756-8235db7a58af> a crm:PC3_has_note ;
    crm:P01_has_domain <1c6556be-1a88-4209-8ac6-1c76a0ed28f7> ;
    crm:P03_has_range_literal "M. Ennelin, \"de Saint Quentin\", est l'auteur d'un air publié dans le *Mercure galant* de juin 1687 (cf. MG-1687-06a\\_084). Peut-être est-il apparenté à l'auteur de l'air \"Retirez-vous foibles buveurs\" publié dans les *Meslanges de musique latine, françoise & italienne...* (Paris, Jean-Baptiste-Christophe Ballard, 1731, Automne, p. 200-204)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<38a99282-b91a-4e00-9911-542570381286> a crm:PC3_has_note ;
    crm:P01_has_domain <024bf428-3dcd-41d5-aef2-748e51ef03ac> ;
    crm:P03_has_range_literal "Caulaincourt (René-Louis-François-Marie de) (1738-1773), aumônier du roi (1767-1773)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<38d5a4bb-12d6-4dde-b73a-f747da3fd73d> a crm:PC3_has_note ;
    crm:P01_has_domain <51ed1529-59a0-403c-86d5-f2171cad1391> ;
    crm:P03_has_range_literal "M. l'abbé Roy «  Chanoine de S. Jacques de l'Hopital, âgé de 80 ans  » est l'auteur du poème d'un air en l'honneur de Louise-Adélaïde de Savoie publié dans la livraison d'août 1718 du Mercure galant (cf. MG-1718-08\\_188)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<38fe2fe8-7b90-4d7b-ad60-5336c02ed680> a crm:PC3_has_note ;
    crm:P01_has_domain <a0c8fd47-0095-4dde-8a52-b9e9f9833b1f> ;
    crm:P03_has_range_literal "Directeur général des vivres à Marseille (1687.03)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<390de72e-211e-4c21-a1ca-98e2a501a9f1> a crm:PC3_has_note ;
    crm:P01_has_domain <92950e2c-0175-402f-9448-53830a693d4d> ;
    crm:P03_has_range_literal "L'abbé Mauguin est l'auteur d'une traduction en vers d'une ode latine Sur la guerre présente de l'abbé Charlet, publiée dans le Mercure galant d'août 1702 (cf. [1702-08_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_211))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<39199b45-a97f-4188-bcec-6391d3ad9f6f> a crm:PC3_has_note ;
    crm:P01_has_domain <e8460592-c63b-4766-b062-a52b9e86cafa> ;
    crm:P03_has_range_literal "M. Prevost a été nommé en 1703 chantre à Hedins (cf. [1703-04_207](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-04_207))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<3939947f-f706-4042-9ba2-ba9f4939bb3f> a crm:PC3_has_note ;
    crm:P01_has_domain <482dda5e-de46-44e2-92d1-9253cb5e4c90> ;
    crm:P03_has_range_literal "Gabriel de Rasilly a été lieutenant général au gouvernement de Tourraine (1676) puis sous-gouverneur du duc de Bourgogne, du duc d'Anjou et du duc de Berry (https://fr.wikipedia.org/wiki/Famille\\_de\\_Rasilly#cite\\_ref-9)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<393da01a-f90a-4727-b4dd-5e2201f58ddd> a crm:PC3_has_note ;
    crm:P01_has_domain <9b312415-9ab5-4e7b-ade3-ca8f331cd321> ;
    crm:P03_has_range_literal "Mlle de Fontenelle a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. MG-1704-07b\\_393)." ;
