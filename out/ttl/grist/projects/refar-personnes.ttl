    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<888fff1e-9dd6-4a1b-a8c6-e5662968924f> a crm:PC3_has_note ;
    crm:P01_has_domain <658d944d-3254-488c-8092-8916098f93c3> ;
    crm:P03_has_range_literal "Fait partie des équipages du Roy d’Espagne & de Messeigneurs les Ducs de Bourgogne & de Berry, & de leur suite mentionné dans le Mercure galant de janvier 1701 (cf. [1701-01_160](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_160))." ;
