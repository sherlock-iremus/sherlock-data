<cc0722bd-5e83-420c-a1cf-edc83f389456> a crm:PC3_has_note ;
    crm:P01_has_domain <9d301972-dd72-4391-a47b-828d60d80bc8> ;
    crm:P03_has_range_literal "Gentilhomme bordelais (1682.09)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<cc2b2179-d680-40dd-9b13-4c48a8cbc68d> a crm:PC3_has_note ;
