    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f8881a0b-83ec-48ad-b19f-e47f648a8a25> a crm:PC3_has_note ;
    crm:P01_has_domain <e40331d8-d489-4395-8f30-adbb963bd214> ;
    crm:P03_has_range_literal "En 1769, Mahon Descoublon était directeur et receveur des deniers du Concert de Troyes." ;
