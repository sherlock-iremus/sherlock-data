<b4dbfba3-0285-454f-82a8-b713e1bcb7a4> a crm:PC3_has_note ;
    crm:P01_has_domain <5abd72ca-8fc9-48be-b6b9-cf45fc8c558e> ;
    crm:P03_has_range_literal "Évêque d’Amiens (sed. 1706-1733) Sabatier, Pierre de (1654-1733) Bavenne, Pierre Sabatier de (1654-1733) <https://data.bnf.fr/fr/16726995/> <https://isni.org/isni/0000000050104570> <http://viaf.org/viaf/73809737> <https://www.catholic-hierarchy.org/bishop/bsabap.html>" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b4fda574-595c-47b6-939f-5c818f6b12e0> a crm:PC3_has_note ;
    crm:P01_has_domain <048c0adf-cac2-46e2-a8b7-822690ddce60> ;
    crm:P03_has_range_literal "Participa à une fête galante donnée à DIe en 1681 (cf. [1681-09_25](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-09_25))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5040d7e-a083-4ddd-926c-135fafcc1597> a crm:PC3_has_note ;
    crm:P01_has_domain <e96dd083-125e-4e19-b736-584320de332d> ;
    crm:P03_has_range_literal "Écuyer d’Aix, seigneur de Leven-lès-Berre, conseiller du roi auditeur archivaire en la cour des Comptes de Provence (1652-1664) ; auteur de poésies, pièces dramatiques (Jephté, 1676) et ouvrages de grammaire (Le génie de la langue française), épouse à l’" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b5234861-00a7-45d6-aeef-055d3c33dd62> a crm:PC3_has_note ;
    crm:P01_has_domain <b7a21c58-d24d-4430-adce-53b873ab904e> ;
    crm:P03_has_range_literal "Vincent Hantier était abbé au collège des Jésuites du Havre (cf. Albert Anthiaume, \\_Le Collège du Havre, contribution à l'histoire de l'enseignement secondaire en France et particulièrement au Havre (1579-1865)\\_, Tome 1, Le Havre, 1905, p. 344). Arrivé à Paris (1689), il change son  nom en Antier." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b54ddae1-808b-4201-8243-0fee72aa9c7e> a crm:PC3_has_note ;
    crm:P01_has_domain <4f4f7bde-a5cf-42bd-9bb9-70b0b86ea1c3> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5682665-1ea6-48cc-9267-f1294cf97e35> a crm:PC3_has_note ;
    crm:P01_has_domain <a9e0a1e5-e2e4-421d-9d64-c9cd2bc77732> ;
    crm:P03_has_range_literal "M. le Redde mit en musique un air, paru dans le *Mercure galant* de mars 1679 (cf. [1679-03_042](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-03_042)). Le poème de cet air a été écrit par M. Noël, avocat à Chartres. Peut-être pourrait-il s'agir de Nicolas Le Redde, marchand bourgeois à Nonancourt. Il était le père de Nicolas Le Redde qui épouse Marie Piet à Chartres en juin 1717 et était décédé à cette date (cf. \"France, Eure-et-Loir, Parish and Civil Registration, 1526-1902\", database, FamilySearch (https://www.familysearch.org/ark:/61903/1:1:69SP-4VW2 : 1 July 2021), Nicolas le Redde)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5b33a93-59f4-40d9-90ee-5cba221a4ba4> a crm:PC3_has_note ;
    crm:P01_has_domain <2d397ef3-639e-450e-a5eb-385a5986268b> ;
    crm:P03_has_range_literal "maître des cérémonies (1684.10)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b5d691d9-c1ef-4201-939d-9c402adcc29e> a crm:PC3_has_note ;
    crm:P01_has_domain <18c4fe2c-4450-4513-b305-2a45ec16af38> ;
    crm:P03_has_range_literal "Le père jésuite Joseph Mahoudeau a remporté le prix de l'ode française décerné à Caen en février 1702. Son ode est publiée dans le Mercure galant du même mois (cf. MG-1702-02a\\_251). D'après ce périodique, Mahoudeau a également remporté le prix de l'épigramme latine dont un exemplaire publié à Caen en 1702 est conservé à la BnF (https://catalogue.bnf.fr/ark:/12148/cb308600558)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5f06657-7d49-421b-920c-51a00ac3715d> a crm:PC3_has_note ;
    crm:P01_has_domain <a8f49b39-f557-4f89-b528-e4d9952d2cc8> ;
    crm:P03_has_range_literal "Capitaine d'artillerie de la cour de Hanovre (cf. MG-1681-04\\_133 et MG-1681-08\\_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5f0fff4-0e3d-453e-82da-a9b5aaf9cfa3> a crm:PC3_has_note ;
    crm:P01_has_domain <81c91085-7cd2-4c98-9fd8-f299360ceec2> ;
    crm:P03_has_range_literal "Poitevin, membre de l'Académie des Inscriptions (1706)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5f4627a-1463-48f4-8796-21a995db3d8a> a crm:PC3_has_note ;
    crm:P01_has_domain <048c0adf-cac2-46e2-a8b7-822690ddce60> ;
    crm:P03_has_range_literal "Participa à une fête galante donnée à DIe en 1681 (cf. MG-1681-09\\_25)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b5fad411-03c2-403f-b39d-d571683ccdc0> a crm:PC3_has_note ;
    crm:P01_has_domain <70e2b2c9-dcea-48b6-9957-e2677f70e067> ;
    crm:P03_has_range_literal "M. Bessant, «  de Poitiers  », composa la musique de deux airs parus dans le Mercure galant en août et en septembre 1678 (cf. [1678-08_175](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-08_175), [1678-09_371](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_371))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b60886d9-408f-4ab2-ac57-c62a654baf28> a crm:PC3_has_note ;
    crm:P01_has_domain <a3f9eb63-eec8-4c44-a11a-e08692362409> ;
    crm:P03_has_range_literal "Pensionnaire de l'abbaye de Bettancourt, seconde fille de M. de Monchy, marquis de Sénarpont (cf. [1685-11_069](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1685-11_069))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b63480a0-be9f-403c-bd4b-b9c975668324> a crm:PC3_has_note ;
    crm:P01_has_domain <d4c5ec39-9828-4f00-bff6-94dcdb99c415> ;
    crm:P03_has_range_literal "Charles Trudaine, seigneur de Montigny (1660-1721) fut maître des requêtes (1689), intendant de Lyon (1704-1710), intendant de Bourgogne (1710-1711) après quoi il siégea au Conseil d'État. Il fut membre de l'Académie des sciences, belles-lettres et arts de Lyon de 1704 à 1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b67a4b3c-a058-4a36-ba10-67924fddbaa6> a crm:PC3_has_note ;
    crm:P01_has_domain <ebc31a2e-3193-4965-bf20-b1f9334c179e> ;
    crm:P03_has_range_literal "M. le Febvre est mentionné en tant que gouverneur de la pompe de la Samaritaine, située sur le Pont-Neuf (cf. [1704-07b_47](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_47))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6920cd6-ab85-4796-b633-ad28b1be23fc> a crm:PC3_has_note ;
    crm:P01_has_domain <b7c6b2dd-0b8f-46a5-b6b0-ff5d85d70fec> ;
    crm:P03_has_range_literal "Estrées (Victor-Marie d') (1660-1737)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b69b51e5-d707-45f6-b4c6-d6a5e5fd9a3e> a crm:PC3_has_note ;
    crm:P01_has_domain <abc67a8f-5a0e-4af0-98b0-8bc44c8fbace> ;
    crm:P03_has_range_literal "Jean Le Poil est l'auteur d'un air paru en 1719 dans le Mercure galant (cf. MG-1719-10\\_174)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6d2ef8c-11ca-4d19-97be-d69488cab80e> a crm:PC3_has_note ;
    crm:P01_has_domain <8e2c565b-f1c6-48ba-b971-8bebe4ec7896> ;
    crm:P03_has_range_literal "Fitz-James (Victoire-Louise-Joseph Goyon de Matignon, duchesse de) (1722-1777), dame du palais de la reine (1741-1762)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b6d8fb0a-e415-4bd5-9d09-53d5966e9873> a crm:PC3_has_note ;
    crm:P01_has_domain <0b28c95e-eaeb-45ca-8472-87e16f5a3833> ;
    crm:P03_has_range_literal "Giovanni Battista Roca prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b6f86b93-5c90-4f6f-a395-05da637c16a4> a crm:PC3_has_note ;
    crm:P01_has_domain <7af373db-a477-448a-9f64-4c01cb54034a> ;
    crm:P03_has_range_literal "trésorier de France de la généralité de Riom (1682.10)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b71562cb-a7ac-4555-8fa0-e16eb2dd83d0> a crm:PC3_has_note ;
    crm:P01_has_domain <2d16ca0e-2698-4e2f-bd1f-cb27cb723bc3> ;
    crm:P03_has_range_literal "Dans la notice de la SIEFAR consacrée à Françoise Pascale (<http://siefar.org/dictionnaire/fr/Fran%C3%A7oise_Pascal>), Deborah Steinberger précise qu'il est possible que lui soient attribuées des paroles d'airs : \"A. évain a trouvé mention d'une pastorale musicale en cinq actes, non publiée, mais présentée aux Appartements à Versailles en 1686, dont les paroles seraient de «  Mlle Pascal  ». Et, en 1688, paraît dans le *Mercure galant* une chanson composée par le maître de choeur de l'hôtel de Guise, dont les paroles (profanes) sont également signées de «  Mlle Pascal  ». On ignore la date de sa mort, mais, selon Vertron, l'autrice vit encore en 1698.\"" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b7315a27-60af-41c3-913a-6c34c34bed69> a crm:PC3_has_note ;
    crm:P01_has_domain <799a872e-89cb-4168-b312-37b857b83d3b> ;
    crm:P03_has_range_literal "Premier écuyer commandant la Grande Écurie du roi." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b73fb73e-fa68-42b0-a78c-9b5fb13152ba> a crm:PC3_has_note ;
    crm:P01_has_domain <4ef6c5d4-d330-46f4-903e-9e6135a23324> ;
    crm:P03_has_range_literal "Joseph Doria prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b75d7ca3-e9fd-4cda-8fb5-ffe689cef70d> a crm:PC3_has_note ;
    crm:P01_has_domain <f695095c-59a1-441a-aec5-530b732b7d78> ;
    crm:P03_has_range_literal "Torre (Inès Henriquez y Sandoval, comtesse de La) (?-?), dame d'honneur de la reine (1615-1618)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b7696491-97ed-45ac-a4f7-de325c6c933c> a crm:PC3_has_note ;
    crm:P01_has_domain <114858fe-833e-443e-9634-d14bfda4ad31> ;
    crm:P03_has_range_literal "Luis Antonio Tomás Fernández de Portocarreño, compte de Palma (1649-1723) fut viceroi de Catalogne. Il était neveu de Luis Manuel Fernández de Portocarrero-Bocanegra (1635-1709), cardinal de Portocarrero (sed. 1669-1709) (cf. https://es.qaz.wiki/wiki/Luis\\_Antonio\\_Tomas\\_de\\_Portocarrero, consulté le 10 février 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b783d7b6-a347-4df4-86e0-348ce48cfb88> a crm:PC3_has_note ;
    crm:P01_has_domain <15090833-a167-4aca-8c20-70bcf28a83ea> ;
    crm:P03_has_range_literal "Premier président de la chambre des comptes de Rouen (cf. [1682-07_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-07_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b7c2bfeb-4619-4cce-8d27-465a7c5a7b87> a crm:PC3_has_note ;
    crm:P01_has_domain <3f3e5128-9ae0-4bcc-a602-5d6c2975f81b> ;
    crm:P03_has_range_literal "ambassadeur de France à Madrid (1682.10)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b7d4f003-31bd-4168-b3fa-7549b2d31cc0> a crm:PC3_has_note ;
    crm:P01_has_domain <130a1d5e-c8de-4c64-994c-e529e901ba9c> ;
    crm:P03_has_range_literal "Fanchon (Arnoul) (?-1643), garde des Plaisirs du roi (actif en 1630), concierge de la petite écurie de Saint-Germain-en-Laye (…1643)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b7d8fc06-da49-4180-b414-695ec53a43d3> a crm:PC3_has_note ;
