    crm:P03_has_range_literal "Marini (Claudio de) (1574 ?-1629), conseiller d'État et chambellan du roi (1610?-1629), ambassadeur auprès du duc de Savoie (…1629)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0b0124c3-1371-44c8-a2ac-6c04cb01efc2> a crm:PC3_has_note ;
    crm:P01_has_domain <c6174b29-7226-40da-a705-00f95f602e27> ;
    crm:P03_has_range_literal "M. Le Comte est l'auteur des paroles d'un air publié dans le *Mercure* *Galant* d'août 1698, qui précise qu'il est \"Conseiller au Parlement de Toulouse\" (cf. [1698-08_127](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-08_127))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0b1c1185-e1aa-48ea-9e2b-6f12c63c31bd> a crm:PC3_has_note ;
    crm:P01_has_domain <2a8be81d-3518-4e4f-b82d-995af684fa01> ;
    crm:P03_has_range_literal "M. du Breuil chanta, avec M. Pivain, un air de la composition de ce dernier à Clayes (désormais Clayes-Souilly), en présence de la duchesse de Lorraine (cf. [1698-11_113](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-11_113))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0b3eeb6e-a518-44d4-8c97-edb60c66c7e2> a crm:PC3_has_note ;
    crm:P01_has_domain <a9635d44-a130-49fe-86c1-742e5d8d420e> ;
    crm:P03_has_range_literal "Gabriel Bachelier était premier valet de la garde-robe du Roi de 1686 à 1706 ." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

