<0669609b-53b9-423e-b33e-ce99fd6b6007> a crm:PC3_has_note ;
    crm:P01_has_domain <714ab30f-1593-4f5a-896a-07f61256a6d7> ;
    crm:P03_has_range_literal "Jean Vivant (1660-1739) était docteur de la maison et société de Sorbonne, prieur de Saint-Fiacre de Gagny, chanoine de Soissons et de l'Église de Paris, vicaire général de Mgr l'Archevêque, cardinal de Noailles, et son official métropolitain, [...] curé de Saint-Merry (cf. Baloche, Constant. Église Saint-Merry de Paris : histoire de la paroisse et de la collégiale, 700-1910. Tome 1. Paris : Librairie H. Oudin, 1912, p. 432-433)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

