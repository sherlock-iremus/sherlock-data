<ebfa4b03-e18d-4733-83ef-8e7f9ee54706> a crm:PC3_has_note ;
    crm:P01_has_domain <4fbd4cb4-e543-45ce-88ba-fad40775b993> ;
    crm:P03_has_range_literal "D'après le Mercure galant, un motet de M. Dubuisson, \"Pensionnaire de la Musique de Sa Majesté\", fut chanté à Fontainebleau durant la messe du roi (cf. [1707-10a_306](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-10a_306))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ec42484a-ceaa-4a5f-a9ac-f09aff9c208e> a crm:PC3_has_note ;
    crm:P01_has_domain <a918e0a5-95fd-4230-9284-ecd532e8fe85> ;
    crm:P03_has_range_literal "La comtesse de Chaumont fut invitée au château de Marly en février 1703 (cf. MG-1703-02\\_277)." ;
