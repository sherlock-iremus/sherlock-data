    crm:P03_has_range_literal "Membre de l'Académie de Nîmes, auteur d'une l'épître au roi d'Espagne parue dans le Mercure galant de janvier 1701 (cf. MG-1701-01\\_085) et probablement aussi de l'épître au Roy sur la prise de Barcelone, (Paris, J.-B. Coignard, 1697, https://catalogue.bnf.fr/ark:/12148/cb30718820j)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

