    crm:P03_has_range_literal "Ministre d'état et grand maréchal de la cour de Württemberg (cf. MG-1684-11\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<acf7eef2-7862-4293-b41a-de1d017c8436> a crm:PC3_has_note ;
