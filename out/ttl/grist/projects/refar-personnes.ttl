    crm:P03_has_range_literal "Prêtre, docteur en théologie de la Faculté de Paris, doyen et chanoine de l'église royale et collégiale Saint-Thomas-du-Louvre, demeurant, en 1671, au doyenné de la dite église (cf. https://www.siv.archives-nationales.culture.gouv.fr/siv/IR/FRAN\\_IR\\_041104) et décédé début 1691 (cf. MG-1691-01\\_242)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<87275fad-9c99-4173-85e6-109c78a18f92> a crm:PC3_has_note ;
