<5f7560c6-c88c-4c9c-a2a1-a1fd62ac6b5f> a crm:PC3_has_note ;
    crm:P01_has_domain <4d6fa7f9-9065-4abc-8a0e-5aa3609370df> ;
    crm:P03_has_range_literal "Pierre Perrichon (1645-1721) fut “notaire, avocat et secrétaire à Lyon [devenant] échevin en 1700 […]. En 1699, il portrait le titre d’avocat au Parlement et secrétaire de la commune puis, dans les années 1710-15, d’avocat en Parlement et ex-consul de la ville (cf. http://www.hyacinthe-rigaud.com/catalogue-raisonne-hyacinthe-rigaud/portraits/192-perrichon-pierre, consulté le 20 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

