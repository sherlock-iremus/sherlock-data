    crm:P03_has_range_literal "Lourson (Anthoine) (?-?), valet de chambre du chevalier de Fourbin (…1682…), concierge du chenil du roi à Versailles (…1696-1708…), chef fourrier du duc de Bourgogne (…1708…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

