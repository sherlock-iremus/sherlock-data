<a97fd22a-0a5c-4976-8c63-0c7e414881e6> a crm:PC3_has_note ;
    crm:P01_has_domain <4347e6f1-2c66-45d5-9126-93b23f5a7fac> ;
    crm:P03_has_range_literal "Jésuite à Poitiers (cf. MG-1688-09a\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a984e1d7-48da-4d30-a106-98a41816c387> a crm:PC3_has_note ;
    crm:P01_has_domain <b8ab4dc1-752a-4d1c-be44-3b85d7290321> ;
    crm:P03_has_range_literal "René-Joachim du Chenedé, marquis de Rosay-Vilette, était premier valet de chambre ordinaire de la Dauphine, puis premier valet ordinaire de la garde-robe du duc de Berry." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a98566eb-d374-4bb5-82f2-69f3c510948f> a crm:PC3_has_note ;
    crm:P01_has_domain <6d81e1f4-cf00-4e70-a4ae-87b4e02d9be5> ;
    crm:P03_has_range_literal "M. Guitrandi (ou Guitrandy) , d'Avignon, fut publié à plusieurs reprises dans le Mercure galant, notamment en octobre 1693 (cf. MG-1693-10a\\_055) et en avril 1702 (cf. MG-1702-04\\_79)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a99cf78d-85ed-4e33-97f8-afd07bb1149b> a crm:PC3_has_note ;
    crm:P01_has_domain <9664d56e-45e8-480f-8af2-943e4fcaea83> ;
