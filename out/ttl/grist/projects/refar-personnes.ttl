<793b1d2d-ca08-4af9-a11e-33617cc7f882> a crm:PC3_has_note ;
    crm:P01_has_domain <f3ef7e6c-13fc-4f18-99d7-69cfaf9b3eb4> ;
    crm:P03_has_range_literal "Hauberat (Jean) (v. 1656-1724), inspecteur des Bâtiments du roi à Chaville (1700-1718), puis à Meudon (1718-1722…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7953738a-0015-4940-b083-ff9c467f03a0> a crm:PC3_has_note ;
    crm:P01_has_domain <b46f226a-bf0a-41b0-9cd2-8214adbf6cf1> ;
    crm:P03_has_range_literal "D'après l'État de la France (1727, p. 179-180), Séraphin Beufvier des Palliniers était Grand sénéchal de Poitou et gouverneur du château de Poitiers." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7960015d-b594-4015-9571-d4dc987beeb1> a crm:PC3_has_note ;
    crm:P01_has_domain <07abdc82-5a40-4a8d-a659-6b05af5cbb8f> ;
    crm:P03_has_range_literal "Mlle de Villecourt a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<79716c15-ef8e-4e71-b549-703c3786d222> a crm:PC3_has_note ;
    crm:P01_has_domain <9feb6ddb-691c-49d0-b72e-01fe6eb59026> ;
    crm:P03_has_range_literal "Argouges (Florent d') (1647-1719), intendant de Moulins (1686-1688), puis de Bourgogne (1688-1694)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<798db124-af8a-4d30-88d5-5b2d0a130591> a crm:PC3_has_note ;
