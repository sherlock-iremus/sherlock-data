<9a69a58d-1d88-4e7d-a015-baed8f0d2aba> a crm:PC3_has_note ;
    crm:P01_has_domain <6b77332e-2b1b-47bc-8919-f1f3989ad3a3> ;
    crm:P03_has_range_literal "M. Le Froid, \"Homme fort consommé en Musique, & qui fait de tres-habiles Ecoliers\" (cf. [1678-05_085](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-05_085)) est l'auteur de deux airs parus dans le Mercure galant en 1678 et 1679." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9a8b3521-675e-4b38-9552-8e6400a43265> a crm:PC3_has_note ;
    crm:P01_has_domain <8dd78a25-a07b-4778-bd9c-c10aed9bb208> ;
    crm:P03_has_range_literal "Auteur d'un sonnet publié dans la livraison d'août 1702 du Mercure galant (cf. [1702-08_5](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_5)), résidant à Saint-Laurent dans le Périgord. M. Robert publia en juillet de la même année l'épitaphe de Nicolas-Antoine Lebègue (MG-1702-07a\\_268), mais rien ne permet d'affirmer avec certitude qu'il s'agit d'une seule et même personne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

