    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8e14c7a4-ca7b-4283-a0d3-df3a9822d993> a crm:PC3_has_note ;
    crm:P01_has_domain <7986de3e-47b0-4734-b4a2-3d12d7d4e79f> ;
