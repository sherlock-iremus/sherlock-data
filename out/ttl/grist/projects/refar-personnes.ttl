<b7da204d-8de3-4f65-9c37-9bbc028ce637> a crm:PC3_has_note ;
    crm:P01_has_domain <b1d194d3-2d84-4473-b7cb-9b21b0c61486> ;
    crm:P03_has_range_literal "Doyen du chapitre de la cathédrale de Châlon-en-Champagne (cf. [1680-03b_088](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03b_088))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b80568df-de31-4959-8ac0-e282b4d8b405> a crm:PC3_has_note ;
    crm:P01_has_domain <87738fde-37b4-4c8e-820e-37cd69ad5025> ;
    crm:P03_has_range_literal "Pierre de Boissy a été lieutenant du roi au Château-Trompette de Bordeaux (cf. Charles-René d'Hozier, Armorial général de France : recueil officiel dressé en vertu de l'édit royal du 20 novembre 1696, Paris : librairie des Archives de la noblesse , 1903-1904, p. 10 ; cf. https://gallica.bnf.fr/ark:/12148/bpt6k1066996/f281, consulté le 4 mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8077cf0-28fd-43c4-b517-1e6c268b8206> a crm:PC3_has_note ;
    crm:P01_has_domain <8becd5f9-5371-46c6-ac7a-a25c48215d55> ;
    crm:P03_has_range_literal "Villars (Amable-Gabrielle de Noailles, duchesse de) (1706-1771), dame du palais (1727-1742), dame d'atours de la reine (1742-1768), puis de la dauphine (1770-1771)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b808340c-0ccb-4ad7-bcee-b1968dc3b093> a crm:PC3_has_note ;
    crm:P01_has_domain <078b1e30-5739-472e-a948-2435457dcbec> ;
    crm:P03_has_range_literal "Fille cadette de M. Bilau, premier ministre d'état à la cour de Würtemberg (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b80b838b-ce39-4aa3-b565-a873993e7821> a crm:PC3_has_note ;
    crm:P01_has_domain <b2839e57-1157-481f-9b0f-76d3eef7c4ef> ;
    crm:P03_has_range_literal "L'abbé Gualtieri, frère de Filippo Antonio Gualtieri, nonce ordinaire du Pape à Paris, assista à la célébration de la fête de Saint-Lazare à l’abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (cf. [1703-01_210](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-01_210))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b81209b9-6dbb-4413-aca7-479a44770a29> a crm:PC3_has_note ;
    crm:P01_has_domain <fc4adc32-372b-4494-b0c4-6d0fef632098> ;
    crm:P03_has_range_literal "Hôpital (Élisabeth-Louise de Boullongne, marquise de l') (1721-1767), dame pour accompagner Mesdames aînées (1739-1752), dame pour accompagner Madame Adélaïde (1752-1767)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b8622f30-1b26-4bcd-b11c-8cd1d0df8796> a crm:PC3_has_note ;
