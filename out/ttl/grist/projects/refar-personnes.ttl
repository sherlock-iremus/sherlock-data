<43c28b99-1659-432b-8da3-69afa40b2959> a crm:PC3_has_note ;
    crm:P01_has_domain <759046cf-d518-4b2b-bfcb-684276181ae1> ;
    crm:P03_has_range_literal "Pour un arbre de la famille, cf. http://badigit.comune.bologna.it/books/sol/mostratalon/pannello%201%20albero%20SAMPIERI%20.pdf, consulté le 5 février 2021." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<43e4fe17-665e-4825-baf4-f469f70c208f> a crm:PC3_has_note ;
    crm:P01_has_domain <5c07773a-e33c-4269-9e5b-73e373059240> ;
    crm:P03_has_range_literal "Frédou (Jean-Martial) (1710-1795), peintre du Cabinet du roi (…1755-1776…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<43f26c91-2b70-4a38-8bd4-8af69cf32705> a crm:PC3_has_note ;
    crm:P01_has_domain <82556577-b599-42cd-ab44-771659731e90> ;
    crm:P03_has_range_literal "M. Devin est l'auteur du poème d'un air publié dans le numéro de mai 1678 du *Mercure Galant* (cf. [1678-05_024](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-05_024))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<43feb013-80ea-4fcc-83ae-bd0bb7ce1c05> a crm:PC3_has_note ;
    crm:P01_has_domain <2de9c93b-60d7-4c23-ad8d-bdaa2644601e> ;
    crm:P03_has_range_literal "Chanoine de Soissons et membre de l'académie de la même ville (cf. [1687-03a_262](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_262))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<44248dc1-922a-4762-8b92-8fc9778ebe29> a crm:PC3_has_note ;
    crm:P01_has_domain <7e9eaed4-cf04-477d-b781-c3ea6e7cb6bf> ;
    crm:P03_has_range_literal "Hordillon (Mathias) (v. 1654-1706), suisse des offices du château de Marly" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<4426c87b-17dd-4f5a-902e-fce4a0834740> a crm:PC3_has_note ;
    crm:P01_has_domain <48dc3845-d163-4a92-88f2-b7bd3d8e01d2> ;
    crm:P03_has_range_literal "Edmond Pirot (1631-?) était “docteur et professeur de Sorbonne […] d'abord chantre de Varzy dans le diocèse d'Auxerre, puis chanoine de Notre-Dame à Paris, et enfin chancelier de cette cathédrale” (cf. https://fr.wikipedia.org/wiki/Edmond\\_Pirot, consulté le 9 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<444776d8-7e32-4e35-a9c4-a1398ce79617> a crm:PC3_has_note ;
    crm:P01_has_domain <f5ee9bd8-2317-4248-b91b-d5fce335aa30> ;
    crm:P03_has_range_literal "procureur du roi à Montoire-sur-le-Loir (1679.05)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<4462c38a-0683-411e-8f54-08b1f450afbd> a crm:PC3_has_note ;
    crm:P01_has_domain <ebc31a2e-3193-4965-bf20-b1f9334c179e> ;
    crm:P03_has_range_literal "M. le Febvre est mentionné en tant que gouverneur de la pompe de la Samaritaine, située sur le Pont-Neuf (cf. MG-1704-07b\\_47)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<44681772-f2d3-4e9e-9344-40e22676792e> a crm:PC3_has_note ;
    crm:P01_has_domain <5bb22f50-e2c8-45a6-a73f-4dda15e3d7dc> ;
    crm:P03_has_range_literal "M. Potier a réalisé les costumes du ballet « Sieg der Schönheit über die Helden », présenté lors du mariage du prince de Prusse en 1706 (cf. MG-1707-05\\_101)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<448f5fee-4f6a-42e3-89ef-82c20b3d8c2b> a crm:PC3_has_note ;
    crm:P01_has_domain <5014bc23-c122-44f0-b360-b7a4cb3f2776> ;
    crm:P03_has_range_literal "Saumery (Jean-Baptiste de Johanne de La Carre de) (1692-1728), aumônier du roi (1718-1728)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<449f0689-a0b3-42c4-b065-3967e8e9e26e> a crm:PC3_has_note ;
    crm:P01_has_domain <c919e633-a3ef-4a75-a0d5-8fbb07575648> ;
    crm:P03_has_range_literal "José Manuel Fernández de Velasco y Tovar était en 1701 « ambassadeur extraordinaire [d'Espagne en France] pour remercier Louis XIV de son acceptation du testament » (cf. François-Marie Gérard, Liste des ambassadeurs, et autres agents politiques de la cour de France auprès des principales puissances européennes,…, Paris, ‪A.Pihan de la Forest, 1833‬, p. 29)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<44bd63b7-a902-4fa3-a9b0-8e7c02e734a1> a crm:PC3_has_note ;
    crm:P01_has_domain <e485a575-a74c-481f-acd5-46188fca747f> ;
    crm:P03_has_range_literal "Ballon (Gilles Loistron, sieur de) (1634-1693), contrôleur des parcs et avenues du roi (…1676…), huissier de la Chambre du roi (1681-1693), valet de chambre de la dauphine (…1682-1683…), directeur des plants d'arbres des maisons royales (…1683-1693)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<44c785ff-b07d-4160-89cb-0644598245d4> a crm:PC3_has_note ;
    crm:P01_has_domain <befe2b3f-4d0a-4396-be01-28008896a1fa> ;
    crm:P03_has_range_literal "Major à Chartres (1688.11)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<44ee128b-2f56-4e40-a626-7acce5805809> a crm:PC3_has_note ;
    crm:P01_has_domain <814e6207-c4b7-47de-97f1-e7aa80e48c26> ;
    crm:P03_has_range_literal "Écuyer du dauphin dans un carrousel (cf. MG-1685-04\\_246)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<44f4c520-dc84-48d8-b111-ad4d36dbaf94> a crm:PC3_has_note ;
