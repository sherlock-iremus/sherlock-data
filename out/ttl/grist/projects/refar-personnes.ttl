<f03e6a94-52df-4d02-9e0c-1f36bbc3de55> a crm:PC3_has_note ;
    crm:P01_has_domain <3aac5839-9b2d-4e78-9bbd-923e0941b7df> ;
    crm:P03_has_range_literal "« Anne-Marie Coquet, fille d’un maître-d’hôtel du roi ; elle était prieure, lorsqu’elle fut élue abbesse le 12 août 1705 par les religieuses, avec la permission du duc Léopold et en présence de l’abbé de Clairvaux, Pierre Bouchu, père immédiat du couvent » (cf. Arthur Benoit, Notes sur l’abbaye de Sainte-Hoïlde. Liste des abbesses, requête au duc Léopold, dans, Mémoires de la société des lettres, sciences et arts de Bar-le-Duc, 1894, p. 55)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

