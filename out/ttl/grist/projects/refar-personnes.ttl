<776718e5-a2ff-4c82-adbb-bb15df98917e> a crm:PC3_has_note ;
    crm:P01_has_domain <2ff033e2-9ccf-4808-bfef-3afce27571c1> ;
    crm:P03_has_range_literal "Syndic des apothicaires de la Maison royale (cf. [1687-02_073](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-02_073))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7776ad5a-040c-4eb2-99ed-3aeeae27c0e6> a crm:PC3_has_note ;
    crm:P01_has_domain <dbb2add3-a3ff-46d9-bef0-28303e11db51> ;
    crm:P03_has_range_literal "Lieutenant général des armées, Gouverneur de Dole et Châtillon-sur-Seine (cf. [1687-03b_317](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_317)), Baron puis Comte de Frolois (1683), Seigneur de Vannaire" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<77bab81a-fbd5-449d-baf3-f81a8cf2c191> a crm:PC3_has_note ;
    crm:P01_has_domain <8fd20b13-7d0a-405e-8645-e4176a1923d6> ;
    crm:P03_has_range_literal "La Briffe (Jean-Arnaud de ; comte de Ferrière) (v. 1649-1700), maître des requêtes (1676…), président du Grand Conseil (1683…), intendant à Rouen (1686-1687), procureur général du parlement de Paris (1689-1700)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<77bc788c-76bb-4cb8-9822-e0cbfee58665> a crm:PC3_has_note ;
    crm:P01_has_domain <ffd1e29b-ea51-44d5-80de-29ac512e0f5a> ;
    crm:P03_has_range_literal "M. de Merville est l'auteur des paroles d'un air publié dans le *Mercure galant* de juin 1678 (cf. MG-1678-06\\_207) et d'un air publié dans celui de septembre 1678 (cf. MG-1678-09\\_037)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<77d7a442-7087-4a4f-ad2f-d8cdcba6f3fc> a crm:PC3_has_note ;
    crm:P01_has_domain <2eae7d95-3c3f-4e0f-b8c2-e6085efb7263> ;
    crm:P03_has_range_literal "Blouin (Louis) (v. 1660-1729), premier valet de chambre du roi (1665-1715), intendant des terres, parcs et châteaux de Versailles (1701-1729) et de Marly (1679-1729), gouverneur de Coutances (1713)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<78abd580-a9e6-40f6-bb4d-9fff57dea898> a crm:PC3_has_note ;
    crm:P01_has_domain <8f10b1dd-7f18-42c1-b07e-10f208429d9c> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

