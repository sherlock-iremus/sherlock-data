    crm:P03_has_range_literal "Breteuil (Louis-Charles-Auguste Le Tonnelier de Preuilly, baron de) (1730-1807), diplomate, secrétaire d'État de la maison du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<44fa20f5-04f3-4ec3-b5ea-1cbb32428bde> a crm:PC3_has_note ;
    crm:P01_has_domain <4208eb00-e120-443e-95df-1f03723d7734> ;
    crm:P03_has_range_literal "Chancelier de Monsieur (cf. [1677-03_077](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1677-03_077))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<451488a2-6a93-495a-ae83-b41005accd0e> a crm:PC3_has_note ;
    crm:P01_has_domain <a8a1b119-358f-4e75-abc2-adb9b396b31c> ;
    crm:P03_has_range_literal "M. Puget, de Berance est l'auteur d'une ode publiée dans le Mercure galant en avril 1702 (cf. MG-1702-04\\_282). Nous n'avons pas pu identifier avec certitude la ville où il réside à cette date. Peut-être s'agit-il de Cérance, dans l'évêché de Coutances (gouvernement de Normandie), à peu de distance de la Bérence, affluent de la Sienne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<4526fa35-6147-4f58-8ae9-c998d8b63384> a crm:PC3_has_note ;
    crm:P01_has_domain <202cc584-1e3b-4987-a75f-efe34dbb907a> ;
    crm:P03_has_range_literal "Compositeur et maître de musique des Jésuites de la rue Saint-Jacques (cf. [1682-09a_318](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-09a_318))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<4530e7f8-0f24-4d06-8112-dc99007de197> a crm:PC3_has_note ;
    crm:P01_has_domain <59042db1-f9ec-4648-a532-195ee155cb78> ;
    crm:P03_has_range_literal "Secrétaire de la ville de Bordeaux (cf. [1679-10a_288](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-10a_288))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

