<801d6957-63e8-4c64-9c35-5c2f897863cd> a crm:PC3_has_note ;
    crm:P01_has_domain <9187a770-ec73-4ece-b949-88efef628b42> ;
    crm:P03_has_range_literal "D'après le Mercure Galant de mars 1701, M. de Manny est à cette date capitaine des chevaliers du jeu de l’arc de Montpellier (cf. [1701-03_211](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-03_211))." ;
