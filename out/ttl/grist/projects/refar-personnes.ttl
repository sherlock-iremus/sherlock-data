    crm:P01_has_domain <218b7126-9cf7-4e92-8f56-22a5d817ebd9> ;
    crm:P03_has_range_literal "Contrôleur général de Monsieur." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cd02f92c-5848-49a6-8c04-b05a94c4e678> a crm:PC3_has_note ;
    crm:P01_has_domain <19dd9fb1-f35b-4b35-aca8-28fbeccd83c6> ;
