<008ea3d8-3aba-41a6-9ac7-e9a445393d68> a crm:PC3_has_note ;
    crm:P01_has_domain <b1a125e3-78d3-459a-9e01-9390c6757834> ;
    crm:P03_has_range_literal "Konstantyn Jázef Zieliński est mentionné dans le Mercure galant en tant qu' «  'Archevêque de Leopol  » (cf. MG-1705-12\\_16), nom francisé de la ville de Lviv." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<00ac0f65-d7f1-4f57-97fc-62a6570f0da9> a crm:PC3_has_note ;
    crm:P01_has_domain <253e1677-8f13-4a1d-ac38-8fe10eb0cebc> ;
    crm:P03_has_range_literal "Francisco Mari était, d'après le Mercure galant, l'envoyé de la République de Gênes à Milan lors du voyaqe qu'y fit Philippe V d'Espagne en 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01089588-7190-4be6-b08d-6e83d6d0e9c6> a crm:PC3_has_note ;
    crm:P01_has_domain <01104cc3-c307-49dd-b1a0-9198cffedad6> ;
    crm:P03_has_range_literal "M. Gaulard est l'un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0115d340-b65a-4e0b-a548-0f3b693d8c2c> a crm:PC3_has_note ;
    crm:P01_has_domain <1d1b8810-c076-486b-a2a0-490dc3ed070c> ;
    crm:P03_has_range_literal "Le site internet Hyacinthe Rigaud indique que Jean Rémy Hénault, peint par le peintre, « officiait comme fermier général aux aides et aux domaines de 1689 à 1718 » (http://hyacinthe-rigaud.com/catalogue-raisonne-hyacinthe-rigaud/portraits/357-henault-de-cantobre-jean-remy)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<012f4b81-d685-46d3-994d-a7b53b28101f> a crm:PC3_has_note ;
    crm:P01_has_domain <d31c14e5-ef9a-4617-9993-c1e68a60df63> ;
    crm:P03_has_range_literal "Laurent Degas était magistrat et prévôt des marchands à Lyon. Il est également l'un des fondateurs de l'Académie des sciences, belles-lettres et arts de Lyon." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01431f3d-afc8-4516-b01d-ec640e861ae4> a crm:PC3_has_note ;
    crm:P01_has_domain <e5c2689b-5eb0-4b4d-8d8a-18e7aa8292c0> ;
    crm:P03_has_range_literal "Huntziger (Balthazar) (v. 1684-1744), suisse du château de Choisy" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0154fb08-353a-4d05-9000-c7062d41eb83> a crm:PC3_has_note ;
    crm:P01_has_domain <1a6202e0-d98b-40c8-8e03-9f8a3ee460dd> ;
    crm:P03_has_range_literal "M. de Montigny, \"du quai des Célestins\", expliqua l'énigme parue dans le *Mercure galant* de janvier 1679 (cf. MG-1679-02\\_345)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<017d5e19-ecbe-483f-8c70-c68f9c3f332e> a crm:PC3_has_note ;
    crm:P01_has_domain <a101b72a-0ffa-478d-ab39-ce037f80baf6> ;
    crm:P03_has_range_literal "Pierre Pièche (fl. 1703) était joueur de flûte de la Chambre du Roi (cf. Waquet, Françoise. “‘Philidor L'ainé, Ordinaire de la Musique du Roy rt Garde de tous les livres de sa Bibliothèque de musique.’” Revue de Musicologie, vol. 66, no. 2, 1980, p. 207)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0195efe5-19fc-422f-9d31-4f662e07c8b2> a crm:PC3_has_note ;
    crm:P01_has_domain <a4cbac91-cd6d-4f2f-84d9-d947ccc57717> ;
    crm:P03_has_range_literal "Avocat au Parlement de Paris, Conseiller du roi au Grand conseil (cf. MG-1679-10a_171), père de Charles-François de Montholon." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<019f1ec4-5c49-4ec9-96fb-e746d83cd032> a crm:PC3_has_note ;
    crm:P01_has_domain <e76e7fa5-92b6-43c7-8102-906aa5caee18> ;
    crm:P03_has_range_literal "Capucin, Provincial de Bretagne (cf. MG-1693-08a_235)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01c9a628-7e17-4ef4-939a-a25f6d66afd7> a crm:PC3_has_note ;
    crm:P01_has_domain <2a2f52c6-7536-4582-a24a-066ad82da4a0> ;
    crm:P03_has_range_literal "Bignon (Jérôme I) (1590-1656), enfant d'honneur du dauphin, avocat général au Grand Conseil (1620…) puis au parlement de Paris (1626-1656), maître de la Librairie du roi (1642-1656)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01d77fde-c6e8-4db5-b2b5-3e6525ab9d20> a crm:PC3_has_note ;
    crm:P01_has_domain <5429cd36-e2ad-456a-a381-bfb190036728> ;
    crm:P03_has_range_literal "Auteur du texte d'une cantate (*Ariane*) mise en musique par Duluc, Jean-Baptiste." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01d83a3d-978d-43dc-9ef0-08c9c6626394> a crm:PC3_has_note ;
    crm:P01_has_domain <730ddccf-2d9d-4d30-99a5-8663468fb6ca> ;
    crm:P03_has_range_literal "Gentilhomme, capitaine d'infanterie à la cour de Hanovre (cf. [1681-04_133](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-04_133), [1681-08_144](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_144))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<01f035d5-980b-4029-815b-7f0689774562> a crm:PC3_has_note ;
    crm:P01_has_domain <66df6eb0-1f64-46b8-80f5-32bcaa10fc93> ;
    crm:P03_has_range_literal "Abbé, chanoine et archidiacre de Nîmes, secrétaire de l'évêché, aumônier auprès de l'abbé Fléchier." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<0200b70c-a8d7-44cc-945b-7c96f699fa94> a crm:PC3_has_note ;
    crm:P01_has_domain <31b65919-e913-4170-84d0-091ed9015756> ;
    crm:P03_has_range_literal "Fils aîné de Louis-Henri de Guyon (?-1703)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<023780a9-d76e-47ce-aac0-0f45e9ef8736> a crm:PC3_has_note ;
    crm:P01_has_domain <e34e7445-cb18-41f5-b0bd-440d676f6197> ;
    crm:P03_has_range_literal "M. de Rabaudy est viguier de Toulouse et père de Pierre de Rabaudy (1702-1754), égaleme t viguier de Toulouse, membre de l'Académie des Jeux floraux." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<024aa214-c4ad-4c29-8d7e-c60e64de40d7> a crm:PC3_has_note ;
    crm:P01_has_domain <0c554fe3-dbd8-4773-9d68-ba199e91d755> ;
    crm:P03_has_range_literal "Rolland Barrin a été nommé commandant de la marine à Rochefort en 1694 (cf. https://fr.wikipedia.org/wiki/Rolland\\_Barrin, consulté le 15 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<027d6ee5-9597-4f29-9be8-79e6ce1ab6f7> a crm:PC3_has_note ;
    crm:P01_has_domain <3b8d1dd1-bb4b-4a6f-bdfc-d96488381aef> ;
    crm:P03_has_range_literal "Nicolas Desmarets de Palis est l'un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<028e8e11-f814-431b-a4b5-26091445d84c> a crm:PC3_has_note ;
    crm:P01_has_domain <12dfb503-8aea-4e4a-b4b3-1d7bdff26293> ;
    crm:P03_has_range_literal "M. Beaudun écrivit les paroles d'un air publié dans le numéro de juin 1716 du *Mercure Galant* (cf. [1716-06_266](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1716-06_266))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0296d5a4-76a8-4a54-b75f-70dc3002545d> a crm:PC3_has_note ;
    crm:P01_has_domain <b8ab4225-aad9-43ff-8dd9-cf88b7182315> ;
    crm:P03_has_range_literal "Michel de Bancalis de Pruines était vicaire général du diocèse de Senlis [...] Prêtre et bachelier en théologie de l'université de Paris, abbé commendataire de l'abbaye de Bois Aubry au diocèse de Tours en janvier 1678, prieur commendataire du prieuré royal de Saint Maurice de Senlis en 1693, prieur de Marmanhac en janvier 1700, doyen du chapitre de la cathédrale de Senlis (cf. https://fr.wikipedia.org/wiki/Famille\\_de\\_Bancalis\\_de\\_Maurel\\_d%27Aragon, consulté le 20 mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<02b0674b-71eb-464d-b318-4f63dddcd3f7> a crm:PC3_has_note ;
    crm:P01_has_domain <59047b40-1ab7-4d47-b5d6-e1de26ce2a25> ;
    crm:P03_has_range_literal "graveur" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<02c3d195-e07d-4d6a-93ce-06ab8fd6f540> a crm:PC3_has_note ;
    crm:P01_has_domain <ab292b3d-a62a-4e0b-b674-ff32b4ab9186> ;
    crm:P03_has_range_literal "Pontevès (Alphonse-Constance de) (1750-1841), aumônier du roi (1784- 1789...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<02cee65e-fe07-45bb-9b78-790fac8dc684> a crm:PC3_has_note ;
    crm:P01_has_domain <3c980f0e-31a1-4a9a-a2ab-0b8a05d9bcad> ;
    crm:P03_has_range_literal "Consul de France à Cadix (cf. MG-1682-10b\\_330)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<02e56fd3-026d-43f2-8e9a-4dbb3c0635ed> a crm:PC3_has_note ;
    crm:P01_has_domain <7a287e3a-e379-45bd-8293-b6f76dc938c8> ;
    crm:P03_has_range_literal "Chapelain de la chapelle du Louvre (cf. [1677-09_212](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1677-09_212))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0300c35c-4f00-4390-9bb2-ee7ca37c5121> a crm:PC3_has_note ;
