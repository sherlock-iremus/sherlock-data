<e429b225-4d11-4827-a76f-73e1991488e5> a crm:PC3_has_note ;
    crm:P01_has_domain <f8603e60-3220-4044-89cb-eb5af5652fc0> ;
    crm:P03_has_range_literal "Garpard-Cornil de Gaya (fl. 1704) était escuyer, major et commandant de la ville de Compiègne (cf. Revue Nobiliaire Héraldique et Biographique publié par M. Bonneserre de Saint-Denis, Tome 2. Paris : Librairie Héraldique de J.B. Dumoulin, 1863, p. 135)." ;
