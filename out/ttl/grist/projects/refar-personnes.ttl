<61a4bd0a-2357-440a-a9ac-0d479e10d059> a crm:PC3_has_note ;
    crm:P01_has_domain <1c6556be-1a88-4209-8ac6-1c76a0ed28f7> ;
    crm:P03_has_range_literal "M. Ennelin, \"de Saint Quentin\", est l'auteur d'un air publié dans le *Mercure galant* de juin 1687 (cf. [1687-06a_084](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-06a_084)). Peut-être est-il apparenté à l'auteur de l'air \"Retirez-vous foibles buveurs\" publié dans les *Meslanges de musique latine, françoise & italienne...* (Paris, Jean-Baptiste-Christophe Ballard, 1731, Automne, p. 200-204)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<61bb4fbc-5262-492e-80ba-50f4eb247c80> a crm:PC3_has_note ;
