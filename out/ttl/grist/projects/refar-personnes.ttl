    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a9661742-cc7b-42f4-94af-bb05488beddd> a crm:PC3_has_note ;
    crm:P01_has_domain <d1e6c195-d70f-48af-a8a1-11f239c2cee4> ;
