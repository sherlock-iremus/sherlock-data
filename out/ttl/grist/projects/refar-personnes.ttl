    crm:P03_has_range_literal "La Tour d'Auvergne (Emmanuel-Théodose de) (1643-1715), cardinal (1669-1715)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<abf6d8c9-dcad-4691-893f-ac88644dcbe6> a crm:PC3_has_note ;
    crm:P01_has_domain <927c9898-8fb5-4c2f-8a3f-a0b4bba3f13c> ;
    crm:P03_has_range_literal "Épiphane Nicaud (fl. 1710) a été provincial des récollets de Lyon (cf. Jean-Baptiste Martin, Histoire des églises et chapelles de Lyon, tome 1, Lyon, H. Lardanchet, 1908-1909, p. 357 ; https://gallica.bnf.fr/ark:/12148/bpt6k5788167w/f406.item.r, consulté le 20 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ac056726-3f44-41bd-8563-28eaffbe5672> a crm:PC3_has_note ;
    crm:P01_has_domain <42fc2c85-bcf1-4964-8650-1bdac2be3722> ;
    crm:P03_has_range_literal "Philippe-Charlotte Hardouin de La Girouardière (dite Madame d'Ampoigné) était l'épouse de René d'Héliand, seigneur d'Ampoigné et de la Chaffinière (1667-1727 ca), capitaine au régiment Dauphin-Infanterie." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ac45e86a-6ba6-4d65-b0b0-a219a0ff8c27> a crm:PC3_has_note ;
    crm:P01_has_domain <b7419b8e-d652-4eee-bf5f-cfca2234bc5d> ;
    crm:P03_has_range_literal "M.Pannier d'Eurtebise est mentionné en tant que maire de Dormans en 1704." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ac619365-7199-4e0a-809f-80369927e5be> a crm:PC3_has_note ;
    crm:P01_has_domain <7d3b47ab-5621-4a05-934a-2390ab03251c> ;
    crm:P03_has_range_literal "Consul de Grenoble (cf. MG-1693-07\\_196) en 1693, conseiller du roi, premier assesseur de l'hôtel de ville de Grenoble en 1710 et 1724, greffier en chef des insinuations ecclésiastiques du diocèse de Grenoble en 1729." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ac8424b2-86f9-4fa7-b0c3-120f8634bfdc> a crm:PC3_has_note ;
    crm:P01_has_domain <21459ec3-8849-4a0d-a2e2-5ae8aa893bb4> ;
    crm:P03_has_range_literal "M. Noël était compositeur à Paris. Il a publié un recueil de motets en 1687." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ac9c1f11-5a3d-4b64-818f-4c7f1c05f3ea> a crm:PC3_has_note ;
    crm:P01_has_domain <18c4fe2c-4450-4513-b305-2a45ec16af38> ;
    crm:P03_has_range_literal "Le père jésuite Joseph Mahoudeau a remporté le prix de l'ode française décerné à Caen en février 1702. Son ode est publiée dans le Mercure galant du même mois (cf. [1702-02a_251](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_251)). D'après ce périodique, Mahoudeau a également remporté le prix de l'épigramme latine dont un exemplaire publié à Caen en 1702 est conservé à la BnF (https://catalogue.bnf.fr/ark:/12148/cb308600558)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<acc37cef-2a71-45a1-930e-2ba0341122b8> a crm:PC3_has_note ;
    crm:P01_has_domain <61f4b373-9b1d-47d6-a172-feec8fb8a9e8> ;
    crm:P03_has_range_literal "Oratorien, professeur de rhétorique à Angers (cf. MG-1687-03a\\_076)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<acc3dbf0-62bd-452c-bd64-46736d760170> a crm:PC3_has_note ;
    crm:P01_has_domain <c738eaf2-2248-4806-94f9-b620ca8b3510> ;
    crm:P03_has_range_literal "Président du grenier à sel de Luzy." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<acd6411c-87da-4772-848d-99b759624a81> a crm:PC3_has_note ;
