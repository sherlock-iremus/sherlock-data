<b45d8a94-e044-4d71-b2e0-0ee552031e23> a crm:PC3_has_note ;
    crm:P01_has_domain <320fe9d1-dd84-4725-b333-c9105cc6baa4> ;
    crm:P03_has_range_literal "Compositeur d'une cantate \"Cantate sur la paix\" - Employé à l'Administration Départementale de la Meuse-Inférieure." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b478e151-abe2-4625-901f-913130a56240> a crm:PC3_has_note ;
    crm:P01_has_domain <6365fa2b-62b4-4163-9466-e52ca31846ea> ;
    crm:P03_has_range_literal "Conseiller du roi, avocat au Parlement et lieutenant général au Présidial de Caudebec (cf. [1687-03b_275](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_275))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b4d9056d-1120-425d-bacc-63f4109dc9ad> a crm:PC3_has_note ;
    crm:P01_has_domain <931c5402-05bc-48ec-926a-d97f0b651c09> ;
