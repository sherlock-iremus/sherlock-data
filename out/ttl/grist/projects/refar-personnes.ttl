<809ce72d-77df-4f9b-87f3-fb2b884edc5d> a crm:PC3_has_note ;
    crm:P01_has_domain <c4799c5d-5ace-416b-b5a8-fbcd34c81347> ;
    crm:P03_has_range_literal "Bignon (Jean-Paul) (1662-1743), président de l'Académie royale des sciences (1691-1700 ; 1702 ; 1704 ; 1707 ; 1709 ; 1710 ; 1712 ; 1716 ; 1717 ; 1719 ; 1721 ; 1726 ; 1732 ; 1734), garde de la Bibliothèque du roi (1719…)" ;
