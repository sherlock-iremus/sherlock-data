    crm:P03_has_range_literal "Fouquet Du Breuil (René) ( ?-1706), aumônier du roi (1659-1694)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<4344a05f-3dfc-4e33-b7c8-1f69340814d6> a crm:PC3_has_note ;
    crm:P01_has_domain <23aef7a3-194e-4c93-b351-eaa5d6e1e5aa> ;
    crm:P03_has_range_literal "Montespan (Françoise Athénaïs de Rochechouart de Mortemart, marquise de) (1640-1707), surintendante de la Maison de la reine" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

