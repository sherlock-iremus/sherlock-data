    crm:P01_has_domain <c48b0050-f96c-490f-adc1-6594120ec415> ;
    crm:P03_has_range_literal "La Mothe-Fénelon (Léon-François-Ferdinand de Salignac de) (1734-1787), évêque de Lombez (1771-1787)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<45456e29-2e04-485b-bc21-6b56bc572dec> a crm:PC3_has_note ;
