    crm:P03_has_range_literal "Maître à danser à la cour de Würtemberg (cf. MG-1684-11\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d9ba4c20-2a31-41ac-aa00-b83054ab6a45> a crm:PC3_has_note ;
    crm:P01_has_domain <830d9d74-eecd-4abc-a711-b1bebe84ecfe> ;
    crm:P03_has_range_literal "Luxembourg (Madeleine-Suzanne-Adélaïde Voyer d'Argenson de Paulmy, duchesse de) (1752-1813), dame pour accompagner la dauphine (1771-1774), dame du palais (1774-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<da08288e-2534-40ee-a65b-49182127448e> a crm:PC3_has_note ;
