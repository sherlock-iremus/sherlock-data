    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<a9f4651c-9517-4190-99ce-d2fa2f1b779f> a crm:PC3_has_note ;
    crm:P01_has_domain <47391b83-db4d-4c1a-abbd-68524844ef5d> ;
    crm:P03_has_range_literal "Correcteur des comptes de Paris qui organisa un bal sur l'île de Puteaux (cf. [1679-06_083](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-06_083))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aa16d86a-9404-46f8-ac31-33c8b0222f11> a crm:PC3_has_note ;
    crm:P01_has_domain <a3bb3774-0ece-4c90-ab9c-d8ca053a85f3> ;
    crm:P03_has_range_literal "Jean-Claude Viany (1639-1726) était prieur de la collégiale Saint-Jean d'Aix-en-Provence (cf. https://fr.wikipedia.org/wiki/Jean-Claude\\_Viany, consulté le 23 février 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aa1c5c03-54a2-4734-bc93-3f4f6573b5c0> a crm:PC3_has_note ;
