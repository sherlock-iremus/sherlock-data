<c4c0ef83-442b-4947-bfdd-9bc4565344e6> a crm:PC3_has_note ;
    crm:P01_has_domain <3c5c7606-3102-46f5-81c9-0e63c8eb4471> ;
    crm:P03_has_range_literal "Marie-Anne Neyret était l'épouse de Nicolas Petit de Villeneuve (?-1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c4e64a9a-d714-4c82-9c75-f8743bbd3d13> a crm:PC3_has_note ;
    crm:P01_has_domain <4c3ef283-87cb-447d-8a55-844b04035855> ;
    crm:P03_has_range_literal "Dans le *Mercure Galant* de mars 1705*,* le rédacteur attribue les paroles d'un poème qui sera mis en air à \"Mr. Chauveau de Chartes qui a donné au Public deux Volumes d'histoires galantes & comiques & plusieurs petits contes en vers, qui ont esté bien reçûs.\"" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c505752f-523e-4de4-854b-d936e8b6726d> a crm:PC3_has_note ;
    crm:P01_has_domain <01d49cac-ac1b-42ac-a08b-2709f4ca97e8> ;
    crm:P03_has_range_literal "Gratien Raoul, récollet, nommé professeur de théologie en 1703, fut élu en 1708 supérieur du couvent de Port-Louis. Il séjourna dans la colonie de l’Île Royale de 1710 à 1715 puis entre 1754 et 1758, cette fois-ci en qualité de de Supérieur de l’île Saint-Jean. Il mourut probablement autour de 1780 (cf. Marc-Antoine Alix, Missionnaires bretons dans les Nouveaux Mondes (XVIe-XVIIIe siècles, Mémoire de Master 2, Université Rennes 2 Haute-Bretagne, 2016-2017, Annexes, p. 186, https://dumas.ccsd.cnrs.fr/dumas-01586706/file/2017\\_MM2\\_ALIX\\_M\\_A\\_vol.%202.pdf, consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c54297c7-b823-441b-9e97-c06edf4ee8f3> a crm:PC3_has_note ;
    crm:P01_has_domain <a534f6f2-9d5a-499f-9462-19bf625972c0> ;
    crm:P03_has_range_literal "Saint-Aldegonde de Noircames (Joseph-Ignace de) (?-1786...), aumônier du roi (1747-1761)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c55347e3-f1c5-4dc3-a85c-f898948a0e23> a crm:PC3_has_note ;
    crm:P01_has_domain <4a924a5f-5cce-4811-8d27-94429a3f857c> ;
    crm:P03_has_range_literal "Maître de musique de M. le Duc (cf. [1679-06_161](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-06_161)), ancien maître à danser du roi en 1685." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c558d61a-9f33-4fde-a721-bfc64e15831b> a crm:PC3_has_note ;
    crm:P01_has_domain <4b28790c-6864-444b-827c-68b971251661> ;
    crm:P03_has_range_literal "Mailly (Anne-Marie-Françoise de Sainte-Hermine, comtesse de) (v.1670-1734), dame d'atours de la duchesse de Chartres (1692-1696), puis de la duchesse de Bourgogne (1696-1712), puis de la reine (1725-1731)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c56f2899-f2da-48a4-9a3a-cdffb9813291> a crm:PC3_has_note ;
    crm:P01_has_domain <90115c07-0388-4c2a-ad8d-37c536875bf2> ;
    crm:P03_has_range_literal "Intendant de Moulins (1675-1680), de Provence (1680-1687, cf. MG-1687-03b_237), premier président au parlement de Toulouse (1687-1708)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c5955b42-9667-426a-8ec3-e50fecebcb51> a crm:PC3_has_note ;
    crm:P01_has_domain <c204b707-f06f-45c8-87ec-2b92ab50ee55> ;
    crm:P03_has_range_literal "Gouverneur-viguier perpétuel de Marseille ; gouverneur du château d'If (cf. MG-1682-09b\\_288)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c59c22d6-2d73-4fc2-90c9-acaf183ecaeb> a crm:PC3_has_note ;
    crm:P01_has_domain <50e176a4-01b0-4c26-be9b-b5c7f0f09729> ;
    crm:P03_has_range_literal "Autrice de deux cantatilles (*Les songes heureux et malheureux* et *Le réveil heureux*)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c5ac519d-6dc5-4e01-bb43-b033668b9613> a crm:PC3_has_note ;
    crm:P01_has_domain <aeeb263e-fbc4-4bbb-be18-aebaeb7f9105> ;
    crm:P03_has_range_literal "Le \"Solitaire de Pontoise\" est le pseudonyme utilisé par l'auteur d'un air publié dans le *Mercure Galant* de juillet 1678 (cf. MG-1678\\_07\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c5b0cf6a-d382-4e8b-af2a-496174d9368e> a crm:PC3_has_note ;
    crm:P01_has_domain <fab0b1fc-8b2a-44c2-9bc8-64ad6b5e4562> ;
    crm:P03_has_range_literal "Chaperon (Jean-Louis) (1718-?), garçon du Garde-Meuble à Marly, puis concierge de l'hôtel du duc de Grouchy à Paris (…1781…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c5b15a69-ca9c-42b7-a2c7-bbb885f8ce75> a crm:PC3_has_note ;
    crm:P01_has_domain <854aaead-d2ca-442f-a5cb-99e71813c9f4> ;
    crm:P03_has_range_literal "La Cauve (Jean-Louis) (v. 1702-1782), taupier des Bâtiments du roi à Vincennes et Choisy (…1782)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c6087932-2702-402f-b1f7-d65658ba63c8> a crm:PC3_has_note ;
    crm:P01_has_domain <158dae8e-1813-4cc2-9cc7-0e65837da284> ;
