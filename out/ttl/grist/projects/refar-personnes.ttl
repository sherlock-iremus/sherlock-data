    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<f5d6ddbf-31bd-4e8e-8912-438965b3a86b> a crm:PC3_has_note ;
    crm:P01_has_domain <46535821-6b53-46c9-b38c-26d3f1c4b591> ;
    crm:P03_has_range_literal "Le Mercure galant évoque «  Mr Blandin Notaire  » (cf. [1707-05_18](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-05_18)) : il pourrait s'agir de Philippe Blandin, notaire royal (cf. <https://gw.geneanet.org/druhen?lang=fr&pz=dominique&nz=druhen&ocz=1&p=philippe&n=blandin>, consulté le 24 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6385572-f9b1-4f83-9e72-159825f7c9ed> a crm:PC3_has_note ;
    crm:P01_has_domain <02d3fe62-3d0d-4e03-bd32-1600a6f522a8> ;
    crm:P03_has_range_literal "M. Royer est l'auteur des paroles d'un air publié dans le *Mercure Galant*de septembre 1684 (cf. [1684-09_091](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-09_091))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f65e5ea3-05a7-4568-ba42-6aecc573463f> a crm:PC3_has_note ;
    crm:P01_has_domain <8f35d019-0bb2-41b2-834c-66d466c46367> ;
    crm:P03_has_range_literal "Le Noir (Jean-Charles-Pierre) (1732-1807), conseiller au Châtelet de Paris (1752…), lieutenant criminel au Châtelet de Paris (1759…), lieutenant général de la police de Paris (1774-1775 puis 1776-1785), maître des requêtes (1765…), président du Grand Conseil (1768…), conseiller d'État (1775…), bibliothécaire du roi (1784-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<f66275f7-3f6e-4428-bc86-c92f28cb5a96> a crm:PC3_has_note ;
    crm:P01_has_domain <e0d0fb2c-e6dd-45c9-8a49-1e5228a40a7e> ;
    crm:P03_has_range_literal "Gouverneur de Fécamp (cf. MG-1682-10b_347)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6b0efe1-226c-4960-b252-0ed9b98c28e6> a crm:PC3_has_note ;
    crm:P01_has_domain <7f268616-ea27-4a19-b6ad-3363c25243ba> ;
    crm:P03_has_range_literal "Jean-Baptiste Chevalier (1729-1789), gouverneur de Chandernagor (1767-1778)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6ee384a-1980-4daa-83d2-1a80504ab0df> a crm:PC3_has_note ;
    crm:P01_has_domain <c8fdc0a8-1927-4e4a-b4bc-ca8d2b3a5aa8> ;
    crm:P03_has_range_literal "Dit le président Denys , maire de Chaumont-en-Bassigny (cf. [1687-03b_081](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_081))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6f48d3d-eb25-4d0e-8e94-d6121dc7f05b> a crm:PC3_has_note ;
    crm:P01_has_domain <ef6745a9-ba60-47b9-a14d-b9d0d50270d4> ;
    crm:P03_has_range_literal "Chanoine et maître des enfants de chœur de Saint-étienne de Troyes (cf. [1698-04_145](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-04_145)), auteur d'un motet en musique chanté à Troyes le 31 mars 1698." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6fa40f6-2e6a-42f8-a0fc-ba97d8466e93> a crm:PC3_has_note ;
    crm:P01_has_domain <c7370ab0-8f5a-40f8-b552-9bf672ce1d54> ;
    crm:P03_has_range_literal "Auteur d'un divertissement en un acte (Zélie). Le *Dictionnaire dramatique* (anonyme, Paris, 1776) nous apprend que Ferrand était fermier général." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f6fc5746-c1a4-4a0d-a1c5-6fe9ef41f243> a crm:PC3_has_note ;
    crm:P01_has_domain <897a8647-85d0-4bfd-96b9-afcabd894512> ;
    crm:P03_has_range_literal "D'après le *Mercure galant* où il publie un air, M. Riel était \"connu pour un des plus consommez que nous ayons dans la Musique, & le premier Eleve de Mr Lambert\" (cf. [1678-08_354](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-08_354))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f7124058-9aa9-453c-981a-cc3e0fd8be75> a crm:PC3_has_note ;
    crm:P01_has_domain <a31584eb-6125-4da9-bff3-edd33bb877cd> ;
    crm:P03_has_range_literal "Lieutenant du roi à Amiens (1691.05)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<f71df6c3-a60a-4f25-b659-88e8b699cecb> a crm:PC3_has_note ;
    crm:P01_has_domain <161b0196-f98c-4436-abbc-546d408c36b9> ;
    crm:P03_has_range_literal "Échevin de Lyon (cf. [1682-10b_017](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10b_017))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f744b133-e4d9-4c27-865f-519e40be1bb5> a crm:PC3_has_note ;
    crm:P01_has_domain <a6b64293-ba26-422e-874d-944b5b1cd330> ;
    crm:P03_has_range_literal "Marchand (Pierre-Nicolas) (1682-?), musicien ordinaire de la Chapelle (1727-1761)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<f7492a8b-43d8-47a4-99a9-5e1d6d9eb2c9> a crm:PC3_has_note ;
    crm:P01_has_domain <eb5a78f1-d480-401b-9d0a-ec449e410e20> ;
    crm:P03_has_range_literal "Pierre (†1722) avait acquis une étude de notaire (1670) qu'il avait su faire fructifier dans d'heureuses spéculations qui l'avaient beaucoup enrichi et lui permirent d'acquérir l'hôtel de Beauvais, rue François-Miron à Paris. Il devint doyen des notaires du Châtelet, puis échevin de Paris (1690) et enfin capitoul de Toulouse (1710), charge recherchée car anoblissante. (cf. https://gw.geneanet.org/pierfit?lang=fr&n=savalette&p=pierre, consulté le 12 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f76b958c-d82d-434b-b3f6-dbf6aade9267> a crm:PC3_has_note ;
    crm:P01_has_domain <f2399f07-3006-4777-9ea6-e7d7e931f669> ;
    crm:P03_has_range_literal "Épouse de M. Bazin, intendant de justice des trois évéchés de Metz (cf. [1681-08_053](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-08_053))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f78e198e-376f-420a-bc32-029cbe974de6> a crm:PC3_has_note ;
    crm:P01_has_domain <2034489e-b796-4f49-affe-6df8317e814c> ;
    crm:P03_has_range_literal "Capitaine du château de Seignelay (cf. MG-1682-06_141)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f7b3a02c-3a39-4fb8-a4c0-d2a52cf2ac88> a crm:PC3_has_note ;
    crm:P01_has_domain <a69bf250-9e4b-44a7-a2eb-9590fa17c8ed> ;
    crm:P03_has_range_literal "M. Du Breuil de Vignancourt est l'auteur d'airs parus dans le *Nouveau Mercure* entre 1714 et 1716. D'après la livraison de novembre 1714, M. du Breuil de Vignancourt était un \"digne élève du fameux Lambert\" (cf. [1714-11_345](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1714-11_345)). Un commentaire de Dusfresny dans le *Mercure* de novembre 1715 (cf. MG-1715-11\\_090) permet de lui attribuer un air signé sous le pseudonyme \"Amoureux oïsif des bords de Marne\" : il indique en effet que sous ce pseudonyme se cache l'auteur du poème et de la musique, et accompagne cet air de sa partition gravée portant le nom de \"De Breüil de Vignancourt\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f7e5f851-47a8-4bf8-8aed-1faf0fca3b13> a crm:PC3_has_note ;
    crm:P01_has_domain <34f03a44-a46c-4947-a209-3c7c069eacae> ;
    crm:P03_has_range_literal "Capitaine des vaisseaux qui épouse en 1677 Mlle de La Verune (cf. [1677-08_127](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1677-08_127))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f7ee56e4-e37a-42f9-a8e7-6db15f0128be> a crm:PC3_has_note ;
    crm:P01_has_domain <6c80c4ff-d886-4fda-b16f-8fc971b0fa9c> ;
    crm:P03_has_range_literal "Ghistelle (Léon-Louis-Ange de) (?-1747), aumônier du roi (1735-1745)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<f84484bd-2105-41e0-8182-5faff0c99e6b> a crm:PC3_has_note ;
    crm:P01_has_domain <4822e333-ae92-43c7-b54f-ce7869891404> ;
    crm:P03_has_range_literal "Graveur et peintre (?), actif entre 1653 et 1697) (Véronique Meyer, *Pour la plus grande gloire du roi : Louis XIV en thèses*, Rennes, Centre de recherche du château de Versailles/Presses universitaires de Rennes, 2017, p. 357). « On ignore tout de Levesque. Un peintre du nom de Laurent, actif entre 1653-1697, qui a représenté en 1691 une vue cavalière de l'abbaye de Sainte-Geneviève (Paris, musée Carnavalet, topo. GC XXVI B), pourrait être notre graveur. » (Véronique Meyer, *Pour la plus grande gloire du roi : Louis XIV en thèses : Catalogue*, Rennes, Centre de recherche du château de Versailles/Presses universitaires de Rennes, 2017, p. 401)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f8828232-ad48-4efd-8a9b-73312114c1b8> a crm:PC3_has_note ;
    crm:P01_has_domain <1f9afd67-ca2e-4027-a140-27b6202b6f1f> ;
    crm:P03_has_range_literal "Princesse française, fille d'Henri IV et de Marie de Médicis, duchesse puis régente du duché de Savoie (1637-1648)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<f885cfe1-9f74-4fdf-89c5-fb975a15a84b> a crm:PC3_has_note ;
