    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d03c87ee-6a3f-490a-b27f-a536d3e11bd3> a crm:PC3_has_note ;
    crm:P01_has_domain <739ae498-81b3-4938-9a19-e1541dcc0aeb> ;
    crm:P03_has_range_literal "Lambert (Pierre) (1646-1709), architecte, contrôleur des Bâtiments du roi (1698-1709)" ;
