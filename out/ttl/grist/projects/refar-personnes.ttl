    crm:P03_has_range_literal "Religieuse à l'abbaye Saint-Sauveur de Beaucaire (cf. MG-1694-04_123)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<421302fc-be23-45e8-a722-f99b8205d280> a crm:PC3_has_note ;
    crm:P01_has_domain <7df66d2f-0ecf-43ac-8e81-97ba899deafa> ;
    crm:P03_has_range_literal "Fille de Manuel Ier et de Marie d'Aragon, épousa en 1526 son cousin Charles Quint." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<423d9a3d-5741-450d-a695-1daba466220e> a crm:PC3_has_note ;
    crm:P01_has_domain <333fc399-5d83-4c57-b8e3-6cdb69503816> ;
    crm:P03_has_range_literal "Jean-Frédéric d’Autel a été gouverneur du duché du Luxembourg entre 1697 et 1713." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<42550814-582b-4377-b615-dfbd3b814d65> a crm:PC3_has_note ;
    crm:P01_has_domain <4689332c-e034-4bd6-8280-0d5b3faa9146> ;
    crm:P03_has_range_literal "M. de Monbrun est l'auteur des paroles d'airs publiés dans le *Mercure Galant* d'octobre 1681 (cf. MG-1681-10\\_125 ; MG-1681-10\\_375) et janvier 1682 (cf. MG-1682-01\\_275). Le *Mercure Galant* d'octobre 1681 précise qu'il est conseiller au Parlement de Toulouse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<425d6834-6eb5-4aa2-884b-360a034d0a58> a crm:PC3_has_note ;
    crm:P01_has_domain <1f57664a-b52c-493b-97d1-e790ee412e56> ;
    crm:P03_has_range_literal "Jean Reynal était maître à danser, frère de Guillaume Reynal, tous les deux membres de l’Académie Royale de Danse (cf. Société des études historiques. L’Investigateur, Paris: 1879, p. 320)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<425e9df2-6a8b-40b4-a6cd-bd4372643b58> a crm:PC3_has_note ;
    crm:P01_has_domain <bc011297-d793-41fb-9e98-d3231d1dc31b> ;
    crm:P03_has_range_literal "M. de La Terrasse et l'auteur d'un sonnet à la gloire de Philippe V d'Espagne publié dans le Mercure galant d'août 1702 et d'une traduction en vers des Noces de Pelée et de Thétis de Catule (MG-1702-08\\_176)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<42702036-8e3d-4ae7-87c9-4cebcb1004ec> a crm:PC3_has_note ;
    crm:P01_has_domain <994f9376-62bd-4d24-b27b-c37472f76038> ;
    crm:P03_has_range_literal "Consul de France à Alep (cf. [1691-11_039](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-11_039))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<42c76176-2b8f-4e8f-8e75-0db59fd84def> a crm:PC3_has_note ;
    crm:P01_has_domain <0c661022-7bc2-4cea-888f-723214dc35c1> ;
    crm:P03_has_range_literal "M.-I.-G.-A de la Mothe-Houdancourt fut gouvernante des enfants royaux de 1709 à 1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<42eb643c-9ea4-44e9-91ab-263c2919aeb7> a crm:PC3_has_note ;
    crm:P01_has_domain <6183d99f-d43f-4d06-b598-ad7edc1ad953> ;
    crm:P03_has_range_literal "Envoyé extraordinaire du roi en Allemagne (cf. MG-1682-10b\\_352 et MG-1684-11\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<42f5f688-644e-4127-8878-eafcfb0145c0> a crm:PC3_has_note ;
    crm:P01_has_domain <68f7b3bc-d102-4908-8f2e-bf4b328d2d8a> ;
    crm:P03_has_range_literal "Père supérieur des Théatins." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<431ea5a8-3c88-4271-9db9-fde029ef6f45> a crm:PC3_has_note ;
    crm:P01_has_domain <288d09ec-0c5b-487f-ae09-2cafd73010be> ;
    crm:P03_has_range_literal "Gautier d'Aubicourt est l'auteur d'énigmes versifiées et de sonnets publiés par le Mercure galant dans les années 1700-1710." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

