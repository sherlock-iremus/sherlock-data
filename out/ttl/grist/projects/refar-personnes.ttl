    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67831ec9-bc44-4eb0-b1a7-ab35d6026a38> a crm:PC3_has_note ;
    crm:P01_has_domain <b26e3092-7f1c-4ff4-b4d5-63dd2cbda124> ;
    crm:P03_has_range_literal "Aumônier de la duchesse du Maine (cf. MG-1694-11\\_163)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67953e56-c647-462a-ab30-d63ee19a1174> a crm:PC3_has_note ;
    crm:P01_has_domain <c8f7aee6-90e5-4a08-a73b-70c4958ac984> ;
    crm:P03_has_range_literal "Procureur de Libourne (cf. [1682-10a_157](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10a_157))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67af2410-5f9a-449d-921d-ecf769df478d> a crm:PC3_has_note ;
    crm:P01_has_domain <4f8d1de7-4640-4702-b0ac-d89e6582c39d> ;
    crm:P03_has_range_literal "M. de La Coste pourrait avoir proposé une nouvelle harmonisation de l'air \"Ainsi que mon amour\" publié anonymement dans le Mercure galant de septembre 1700 (cf. MG-1700-09\\_144). Cette harmonisation est parue dans le Recueil d'airs sérieux et à boire (Paris, Ballard, juillet 1700)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67e168ae-acf4-4b52-933a-69c7af7c05d5> a crm:PC3_has_note ;
    crm:P01_has_domain <56c9c346-49ea-47a0-80f0-b779fc24e076> ;
    crm:P03_has_range_literal "Pierre Allard était le fils de Charles Allard (1660 av.- 1717 ap.) et le frère de Charles Allard (?-1711)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<67f5bc66-8e21-4d5a-9b77-886355aa21e7> a crm:PC3_has_note ;
    crm:P01_has_domain <73313905-6417-4118-8a48-4d246bb11179> ;
    crm:P03_has_range_literal "Choiseul-Beaupré (Charlotte-Rosalie de Romanet, comtesse de) (1733-1753), dame pour accompagner Mesdames aînées (1751-1752), dame pour accompagner Madame Adélaïde (1752-1753)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<680584ea-1999-48ce-a638-0d991af2572a> a crm:PC3_has_note ;
    crm:P01_has_domain <fcd925e7-bed5-4eac-9e7f-817f7a4ccc99> ;
    crm:P03_has_range_literal "M. Le Chantre (fl. 1680) était membre de l’Académie Royale de Danse (cf. [1680-06_263](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-06_263))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6805adaa-36fc-4ec0-9b28-83b5b42b1d8e> a crm:PC3_has_note ;
    crm:P01_has_domain <8943d620-19c7-439f-8326-4923f19f9670> ;
    crm:P03_has_range_literal "Mauléon (Paul de) (1750...-?), aumônier du roi (1778-1789...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<68a8c275-2696-45c5-804a-16bb0d9d7b08> a crm:PC3_has_note ;
    crm:P01_has_domain <7344509a-6dcc-4aee-88da-d7c22e2edd5e> ;
    crm:P03_has_range_literal "Jacques Cabassole (1671-?) était prêtre et maître de musique. Il a exercé aux Saint-Innocents de Paris entre 1698 et 1702, puis à la Cathédrale de Chartres entre 1702 et 1706 (cf. Hajdu Hayer, John. The Lure and Legacy of Music at Versailles. Louis XIV and the Aix School. Cambridge : Cambridge University Press, 2014, p. 107, 108)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<68aeb287-bb64-4ac6-93bc-a404e5ea9225> a crm:PC3_has_note ;
    crm:P01_has_domain <485a3392-8569-4f6f-bebe-712d7079f88d> ;
    crm:P03_has_range_literal "Pierres (René-François) (1704-1779), écrivain au Cabinet des titres et généalogies de la Bibliothèque du roi, trésorier de la Bibliothèque du roi (1741…), garde du Cabinet des titres et généalogies (1763-1779), généalogiste de la maison et des écuries du duc d'Orléans" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<68ba3be9-94fe-403f-942d-c5e1cd8bb07e> a crm:PC3_has_note ;
    crm:P01_has_domain <8f79dfbd-9734-41b6-9e23-c9e82cb06a5d> ;
    crm:P03_has_range_literal "Père jésuite à Poitiers, auteur d’un sonnet paru dans le Mercure galant de janvier 1701 (cf. [1701-01_085](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_085))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<691b9928-963d-40bc-9cc1-bfa9df7c1bec> a crm:PC3_has_note ;
    crm:P01_has_domain <29f29d46-1d69-43da-b426-0c09d78a0897> ;
    crm:P03_has_range_literal "Courçay (André Barthélemy, abbé de) (1744-1799), garde adjoint du Cabinet des médailles du roi (1770-1795), conservateur-bibliothécaire du Cabinet des médailles de la Bibliothèque de France (06/1795-10/1795), conservateur du Cabinet des médailles de la Bibliothèque de France (1795-1799), directeur du Conservatoire de la Bibliothèque de France (1795-1796)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<691fa56c-a893-4b62-8795-123535bc4259> a crm:PC3_has_note ;
    crm:P01_has_domain <5840c3cc-2b2d-4d0b-98fb-03a6398cb671> ;
    crm:P03_has_range_literal "Janson (Toussaint de Forbin de) (v.1630-1713), cardinal, grand aumônier de France (1706-1713)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<693a041a-8442-4adc-86ff-81261f1ef053> a crm:PC3_has_note ;
    crm:P01_has_domain <d8553c1a-569e-4596-a4fe-11977e5483f9> ;
    crm:P03_has_range_literal "avocat (1678.07)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<697a6df6-74c1-4786-97b3-ac8cec1fa966> a crm:PC3_has_note ;
    crm:P01_has_domain <121f0ac0-c03a-4f83-b53f-349ac3858bad> ;
    crm:P03_has_range_literal "Du Hamel (Jean-Baptiste) (1623-1706), secrétaire de l'Académie royale des sciences (1666), pensionnaire anatomiste" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<69a0e722-1942-48fa-9f64-2867a7eaab42> a crm:PC3_has_note ;
    crm:P01_has_domain <84f2b3f0-36bb-453a-aa0b-961875e36347> ;
    crm:P03_has_range_literal "gouverneur du Croisic (1678.06)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<69aac4ab-7c88-4d4e-b616-6edeef6f8b87> a crm:PC3_has_note ;
    crm:P01_has_domain <005358e1-803a-4d1a-b93e-9d831776d8b6> ;
    crm:P03_has_range_literal "Nesle (Félice-Armande de La Porte-Mazarini, marquise de) (1691-1729), dame du palais de la reine (1725-1729)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<69b51857-b5f6-438b-bc97-cf711aea20d8> a crm:PC3_has_note ;
    crm:P01_has_domain <eb0c8aa8-1232-4d0b-97d3-44adff9d240a> ;
    crm:P03_has_range_literal "Célèbre danseur, membre de l'Académie royale de danse et danseur à l'Académie royale de Musique (cf. S. Bouissou, P. Denecheau, F. Marchal-Ninosque, *Dictionnaire de l'opéra de Paris sous l'Ancien Régime (1669-1791)*, Paris, Garnier, 2019, t. 3, p. 687-691)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<69fd7289-2fe5-4654-8d76-69717e19ce6b> a crm:PC3_has_note ;
    crm:P01_has_domain <f6f345aa-21a8-4b5c-846e-7e53a29df102> ;
    crm:P03_has_range_literal "Clemente Doria prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. [1702-12_191](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-12_191))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<69fd9e62-253f-45ed-af68-3d0cf1fca41a> a crm:PC3_has_note ;
    crm:P01_has_domain <435fb61c-f6f7-4493-89e9-6b6dd71eb0a8> ;
    crm:P03_has_range_literal "Prieur de l'abbaye Notre-Dame de Châtillon-sur-Seine (cf. [1682-12_193](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-12_193))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a0d292b-ce6c-4681-8c6a-767b8e9cef4b> a crm:PC3_has_note ;
    crm:P01_has_domain <9e90c60e-72d2-407f-9589-e46b0eefaa53> ;
    crm:P03_has_range_literal "Monsieur D. L. Txxx composa la musique de l'air \"Votre toutou vous flatte\" paru dans le Mercure galant de mai 1720 (cf. MG-1720-05\\_138)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a2e0071-b0e8-4d78-8f79-70a871c88dde> a crm:PC3_has_note ;
    crm:P01_has_domain <e7794ab3-7d4a-4ceb-b196-99abf842f33d> ;
    crm:P03_has_range_literal "Louis-François d’Harcourt était chevalier de la Toison d'or (nommé en 1702) et lieutenant général des armées du roi (1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a6a9188-3598-47d1-ab2a-2365e79e8cfc> a crm:PC3_has_note ;
    crm:P01_has_domain <7311ed00-e1e3-43f4-a508-f0e96c8a60a2> ;
    crm:P03_has_range_literal "César Neurone était graveur et dessinateur." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a7d949b-946b-4295-b8bb-db6b072fe877> a crm:PC3_has_note ;
    crm:P01_has_domain <af620b09-ca75-4a8b-94f0-be6faa285759> ;
    crm:P03_has_range_literal "M. Buquet le fils composa la musique d'un air paru dans le Mercure galant en août 1719 (cf. [1719-08_148](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1719-08_148))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a85b2fd-6bc9-4adc-ba30-d2446beeadcb> a crm:PC3_has_note ;
    crm:P01_has_domain <3f02e784-c16b-4794-88f0-6c8dfb670804> ;
    crm:P03_has_range_literal "Tarente (Louise-Emmanuelle de Châtillon, princesse de) (1763-1814), dame du palais (1786-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6a8770f5-7f65-4cea-aeb2-8c1e82ece744> a crm:PC3_has_note ;
    crm:P01_has_domain <cecc3176-d5d1-4bd9-ae28-3d67c084d414> ;
    crm:P03_has_range_literal "Mlle d'O est l'autrice de deux airs parus dans le *Mercure galant* en 1680. En septembre 1680, le périodiqueaffirme \"[qu'] elle est du Quartier S. Paul, dont elle fait un des plus beaux ornemens, & tres-digne Fille d'une Mere qui ayant esté dans son Printemps la plus aimable du monde, conserve dans son Eté tous les agrémens que peuvent avoir celles de son âge.\" (cf. [1680-09a_340](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-09a_340), [1680-11_045](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-11_045))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6a9d99f1-0770-4796-a182-423109cd8508> a crm:PC3_has_note ;
    crm:P01_has_domain <63fc1f23-d18f-4d7b-a200-77c6f9bd2a83> ;
    crm:P03_has_range_literal "M. de Beaupré est l'auteur de la musique d'une chanson parue dans le Mercure galant de janvier 1717 (MG-1717-01\\_218)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6aadf2e4-d153-4675-b80d-df6c5cb5e7c8> a crm:PC3_has_note ;
    crm:P01_has_domain <e1f3c3b6-780a-4a77-9246-6688f51063d2> ;
    crm:P03_has_range_literal "M. de Frontinière est l'auteur des paroles d'un air publié dans le *Mercure Galant* de septembre 1689 (cf. MG-1689-09\\_051)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6ac8dc82-76cc-4496-b704-ef707c493fdc> a crm:PC3_has_note ;
    crm:P01_has_domain <426764d4-da84-4740-969b-4c28565dd252> ;
    crm:P03_has_range_literal "Médecin et académicien de Bouilly (1678.07)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6aeb63a6-5bfa-48ff-b7d0-16d2d5a0fe01> a crm:PC3_has_note ;
    crm:P01_has_domain <e2573330-c0ce-4318-b432-e4af1ac49909> ;
    crm:P03_has_range_literal "Gramont d'Aster (Gabrielle-Charlotte-Eugénie de Boisgelin, comtesse de) (1766-1836), dame du palais (1788-1789)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6aff79ac-c91e-4628-9ea6-7deb9b75648a> a crm:PC3_has_note ;
    crm:P01_has_domain <eecfff07-b46f-4ba6-bbbe-a96b3d6daf76> ;
    crm:P03_has_range_literal "Intendant de Tours (1689)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6b011257-fbdc-4c29-a09b-e00bf19867d1> a crm:PC3_has_note ;
    crm:P01_has_domain <9ec01d0d-c742-4bff-bc09-01563df4a770> ;
    crm:P03_has_range_literal "Résident du roi de France à Genève (cf. MG-1680-07\\_224 ; MG-1682-10b\\_190)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6b0fb4d9-80b8-4482-8ae4-f82f3e945600> a crm:PC3_has_note ;
    crm:P01_has_domain <e858051b-0b96-4b59-9652-c7668e6cd072> ;
    crm:P03_has_range_literal "Caussin de Perceval (Jean-Jacques-Antoine) (1759-1839), censeur royal, professeur d'arabe au Collège de France (1783-1833), garde du Cabinet des manuscrits de la Bibliothèque du roi (1787-1792), président de l'Académie royale des inscriptions et belles-lettres (1824-1830), président du Collège de France (1830-1833)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6b118058-5da1-40b1-ac45-f0e89ce184f8> a crm:PC3_has_note ;
    crm:P01_has_domain <cc8496b9-96f4-4fd7-8229-5de08b2f828c> ;
    crm:P03_has_range_literal "Jonquet (Jean) (?-1728), ordinaire de la musique de la Chapelle (1676/1677-1727), ordinaire de la musique de la Chambre du roi (1682-1728)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<6b14cd03-7ac5-4f65-93da-c2d1144bfbc0> a crm:PC3_has_note ;
    crm:P01_has_domain <58bf1e15-cdad-40c0-b7c3-f5669ec1a00d> ;
    crm:P03_has_range_literal "Anne-Philippe d’Auburtin de Vallombre était la fille de Claude-Philippe d’Auburtin (1659-1638)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6b2f9221-3580-40f2-882d-eec26dca49fa> a crm:PC3_has_note ;
    crm:P01_has_domain <810d8de0-6c91-4436-9400-b7daaf7b2aa9> ;
    crm:P03_has_range_literal "Mme du Poscq était la reine d'une course de tête organisée à Caen lors du Carnaval de 1703 (MG-1703-02\\_178)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6b3ef7d5-ecd4-451f-b79e-d09131b931ca> a crm:PC3_has_note ;
    crm:P01_has_domain <fd232b9e-1aa7-4401-b2b3-940cac960ccd> ;
    crm:P03_has_range_literal "M. Bellot, chevalier, participa à une course traditionnellement organisée à Saint-Quentin (Picardie) (cf. MG-1680-05\\_089)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6b81be84-8b79-4034-b57d-41ecaa0febb7> a crm:PC3_has_note ;
    crm:P01_has_domain <1bf2e572-88c8-4208-b10f-a7feaaaeae09> ;
    crm:P03_has_range_literal "Conseiller au présidial de Bourg-en-Bresse (cf. [1678-12e_064](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12e_064), [1678-12e_344](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-12e_344), [1679-09_072](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-09_072)). Voir aussi Geoffrey Turnovsky, \"Les lecteurs du Mercure galant. Trois aperçus\", *Auctorialité, voix et publics dans Le Mercure Galant*, éd. A. Piéjus, D. Blocker, *Dix-septième siècle,* 270 (2016/1), p. 65-80 (cf. https://www.cairn.info/revue-dix-septieme-siecle-2016-1-page-65.htm)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6b943484-264b-4f2d-8242-30eba7c88d2c> a crm:PC3_has_note ;
    crm:P01_has_domain <a69bf250-9e4b-44a7-a2eb-9590fa17c8ed> ;
    crm:P03_has_range_literal "M. Du Breuil de Vignancourt est l'auteur d'airs parus dans le *Nouveau Mercure* entre 1714 et 1716. D'après la livraison de novembre 1714, M. du Breuil de Vignancourt était un \"digne élève du fameux Lambert\" (cf. MG-1714-11\\_345). Un commentaire de Dusfresny dans le *Mercure* de novembre 1715 (cf. MG-1715-11\\_090) permet de lui attribuer un air signé sous le pseudonyme \"Amoureux oïsif des bords de Marne\" : il indique en effet que sous ce pseudonyme se cache l'auteur du poème et de la musique, et accompagne cet air de sa partition gravée portant le nom de \"De Breüil de Vignancourt\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6bb98887-3d9b-4174-ac69-63726c2328cb> a crm:PC3_has_note ;
    crm:P01_has_domain <33a5a8cc-4afc-42e0-b7fe-9e9af2d249c3> ;
    crm:P03_has_range_literal "Beauvilliers (Marie-Madeleine de Rosset de Fleury, duchesse de) (1744-1803), dame du palais (1763-1768 ; 1774-1786), dame pour accompagner la dauphine (1770-1774)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<6bc18328-f092-4af7-910f-a83dd4ddd771> a crm:PC3_has_note ;
    crm:P01_has_domain <186a3531-b0c7-4d70-b623-0c53627ab84c> ;
    crm:P03_has_range_literal "Angelo Olivieri est mentionné en tant que Musicien du cardinal Charles Barberin (cf. [1702-03_153](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-03_153))." ;
