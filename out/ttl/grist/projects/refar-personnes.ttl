<717f79dc-6624-4ca5-a2b0-e2095a76ccee> a crm:PC3_has_note ;
    crm:P01_has_domain <d2639458-3e3b-43ff-8f2a-9f31dd35db40> ;
    crm:P03_has_range_literal "M. de Tonti est l'auteur des vers de la pastorale Les Bergers heureux parue dans le Mercure galant de septembre 1689 (cf. [1689-09_021](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-09_021)), du Prologue Mars, la France, la Renommée parue en novembre 1690 (cf. MG-1690-11\\_255) et de l'air nouveau paru en janvier 1701 (cf. MG-1701-01\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<71bc349a-da1b-4c57-8d04-3201fef016a2> a crm:PC3_has_note ;
