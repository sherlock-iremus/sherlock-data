    crm:P03_has_range_literal "Béon (Marie-Magdeleine-Charlotte de Béon de Massés de Cazaux, comtesse de) (1757-1818), dame pour accompagner Madame Adélaïde (1782/83-1789)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

