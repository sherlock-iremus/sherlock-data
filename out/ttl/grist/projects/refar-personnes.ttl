    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<395aa869-33cb-4902-8513-e320de0c4522> a crm:PC3_has_note ;
    crm:P01_has_domain <950225df-bca7-49d2-b9f3-d5d9eea19924> ;
    crm:P03_has_range_literal "La Berchère (Charles Le Goux de) (1647-1719), évêque de Lavaur (1677-1685)" ;
