    crm:P03_has_range_literal "Montazet (Jean-Antoine-François de Malvin de) (1744-1789...), aumônier du roi (1782-1789...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7ac340ce-9077-451f-b5be-cde77693c2e4> a crm:PC3_has_note ;
