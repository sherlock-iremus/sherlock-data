    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc7ed6ad-e314-4736-9976-998a35b3e2c1> a crm:PC3_has_note ;
    crm:P01_has_domain <818b4eb1-b411-4954-8f8f-e59d8a627ed9> ;
    crm:P03_has_range_literal "Saltini (Jacques) (?-?), apothicaire du corps (…1618-1642…) et valet de chambre de la reine mère (…1618…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc80cf0e-08e4-4606-9215-d14c054e2e49> a crm:PC3_has_note ;
    crm:P01_has_domain <f18a5b3e-dc40-42ea-8a0a-8025994b31ba> ;
    crm:P03_has_range_literal "Claude-Roch Titon, fils de Maximilien Titon, a été chanoine de Sainte-Geneviève et prieur à Dourdan (cf. https://gw.geneanet.org/cdemagnitot?lang=fr&pz=myriam&nz=jourdan+du+mazot+le+rat+de+magnitot&p=claude+roch&n=titon)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dc8deb37-1775-446a-a36d-1f4c9ad8f46c> a crm:PC3_has_note ;
    crm:P01_has_domain <3162831f-d9f0-477f-9434-80b5344e92d8> ;
    crm:P03_has_range_literal "M. de Pulvigny est l'auteur d'un air paru dans le *Mercure galant* de juin 1681 (cf. MG-1681-06\\_88)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dc97d162-14c4-4562-945e-c43c32077196> a crm:PC3_has_note ;
    crm:P01_has_domain <5620afc5-a6ac-406f-92dd-59edfc63f7ad> ;
    crm:P03_has_range_literal "Docteur de la Sorbonne et grand doyen de la cathédrale d'Angers (cf. [1687-03b_213](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_213))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dca41cb0-5ca4-4c3b-9c82-16cdd844041e> a crm:PC3_has_note ;
    crm:P01_has_domain <2007b67f-065b-4a93-97f5-3013b26e01ed> ;
    crm:P03_has_range_literal "Prévôt général de Haute Normandie (cf. [1687-03b_277](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_277))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

