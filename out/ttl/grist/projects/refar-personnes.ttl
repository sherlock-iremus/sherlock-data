<bdf3ee8d-e8ac-4b3e-9f2f-dc61a9a82c81> a crm:PC3_has_note ;
    crm:P01_has_domain <e4d115ec-b455-40a2-afe4-d1fe46444d3b> ;
    crm:P03_has_range_literal "M. Prevost était un compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310)). Lors de la publication d'un air dans le *Mercure galant*, il est indiqué qu'il était «  ci-devant maître de musique de la cathédrale de Clermont en Auvergne  » (cf. MG-1687-04_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<be1d4bfc-6a26-48de-a072-d2b56d1d4b94> a crm:PC3_has_note ;
    crm:P01_has_domain <41cb5998-8169-4557-9d54-fe46eafce62b> ;
    crm:P03_has_range_literal "Pour une notice prosopographique concernant Étienne Labruë, voir Dainville-Barbiche S., Prosopographie des curés de Paris (1695-1789), dans Devenir curé à Paris : Institutions et carrières ecclésiastiques (1695-1789), PUF, 2005, p. 425-511." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

