<cc056097-fe3f-4070-9464-8f3a7103a17f> a crm:PC3_has_note ;
    crm:P01_has_domain <42d1d0fe-aeb0-4a22-96ba-2b371a40a242> ;
    crm:P03_has_range_literal "M. Piuli est l'auteur, avec M. du Breuil, d'un air paru dans le *Mercure galant* de janvier 1701 (cf. [1701-01_079](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_079))." ;
