<b27c7d65-73ff-40ea-a015-e46fa95376ab> a crm:PC3_has_note ;
    crm:P01_has_domain <2d883eed-eab7-44fb-ac5c-9deec30d7e33> ;
    crm:P03_has_range_literal "M. Tesson est l'auteur d'un madrigal destiné à être mis en musique paru dans le Mercure galant de juin 1701 (cf. [1701-06_065](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-06_065)), d'une épître en vers (cf. MG-1702-02a\\_70), et d'un autre madrigal publié en avril 1702 (cf. MG-1702-04\\_139)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b2955729-4647-4c00-bdb9-ca9b00269b5a> a crm:PC3_has_note ;
    crm:P01_has_domain <512780e6-ba90-4c1f-8588-365cc3a88d33> ;
    crm:P03_has_range_literal "Escars (Marie-Émilie FitzJames, marquise d') (1715-1770), dame du palais de la reine (1757-1768)" ;
