    crm:P03_has_range_literal "Aguesseau (Henri d') (1636-1716), intendant de Limoges (1667-1669), de Bordeaux (1669-1673), de Languedoc (1673-1685)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ca291b47-c1df-4288-bfee-c1c8c2a2cb1c> a crm:PC3_has_note ;
    crm:P01_has_domain <4f12913c-4ecc-48be-aafa-a1fe8babbca1> ;
    crm:P03_has_range_literal "Capitaine perpétuel de la compagnie des chevaliers du jeu de l'arquebuse de Provins (cf. MG-1686-10a\\_073)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ca2a5104-d855-4df4-8511-d7edbb97b76d> a crm:PC3_has_note ;
    crm:P01_has_domain <76fe07cd-2112-4f97-8180-621bdfa6d08f> ;
    crm:P03_has_range_literal "aumônier du roi" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ca419acb-03d9-4d40-b5bd-5d9ccd163bc9> a crm:PC3_has_note ;
    crm:P01_has_domain <ee30d4e0-ab1c-40e6-972c-39ab9dea35b7> ;
    crm:P03_has_range_literal "M. Cassin a été assesseur et premier échevin de la ville de Saint-Jean-d'Angély (cf. [1701-01_160](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_160))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ca87eb5d-3294-4dbb-82c0-84b6ae786141> a crm:PC3_has_note ;
    crm:P01_has_domain <5ffdf374-d600-4ea6-aeae-17d4b8b4c844> ;
    crm:P03_has_range_literal "M. Souisse est l'auteur d'un air paru dans le *Mercure galant* de mai 1709. D'après ce périodique, il s'apprêtait à faire paraître un recueil d'airs sérieux et à boire dont, s'il a paru, il ne reste plus trace (cf. [1709-05_338](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1709-05_338))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<caa263db-588b-45ae-8376-b9cf402d741e> a crm:PC3_has_note ;
    crm:P01_has_domain <8bd8100e-887e-4b46-ad40-d06540777c54> ;
    crm:P03_has_range_literal "Buache (Philippe) (1700-1773), premier géographe du roi (1729-1773)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<caa767f2-66b1-4901-8e7e-c37ac7b4f6da> a crm:PC3_has_note ;
    crm:P01_has_domain <39d1a238-6f5d-4d31-9dc9-6a3fe5c547f8> ;
    crm:P03_has_range_literal "Antoine Morel était chantre au sein de la musique du roi, librettiste et valet de chambre de la dauphine." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cacf8ec1-df4c-4419-a295-3b5efb303074> a crm:PC3_has_note ;
    crm:P01_has_domain <7facf35b-a85a-448f-9ff2-36a8ead0f221> ;
    crm:P03_has_range_literal "M. Roy est l'auteur des paroles d'une parodie dans le *Mercure Galant* d'avril 1717 (cf. MG-1717-04\\_149)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cadeb6fd-4d21-4a3a-8145-da4c4263ad91> a crm:PC3_has_note ;
    crm:P01_has_domain <fdb8d53f-b098-4c25-8d52-b319fcb7c262> ;
    crm:P03_has_range_literal "Dame de Bordeaux (cf. MG-1682-09b_015)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cae1345b-05b2-493c-aba9-e329ff3a2684> a crm:PC3_has_note ;
    crm:P01_has_domain <6ecf9e82-d74c-45b2-99c2-0e7623f7f50d> ;
    crm:P03_has_range_literal "Doyen du chapitre de la cathédrale Saint-André de Bordeaux (cf. [1691-09_067](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-09_067))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<caecf33f-6605-4d2a-9dc7-11d29287792a> a crm:PC3_has_note ;
    crm:P01_has_domain <4c08eb55-f7f2-44cb-b531-0b51f84d1198> ;
    crm:P03_has_range_literal "Marchand des Chartrons de Bordeaux (cf. [1682-09b_015](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-09b_015))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<caf5aaeb-a1b7-48b5-9d03-7689444536ab> a crm:PC3_has_note ;
    crm:P01_has_domain <5ddd2dca-d197-47ea-b706-a232b7a42446> ;
    crm:P03_has_range_literal "Demoiselle qui épousa en 1678 M. de Launay, capitaine des régiments du roi (cf. MG-1678-06_122)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<caf6b50d-397b-4e73-94c4-473ac0ac5c8d> a crm:PC3_has_note ;
    crm:P01_has_domain <0edc62b8-0ae2-4384-8f81-3c23fec9d98b> ;
    crm:P03_has_range_literal "Ferrand (François-Antoine) (1657-1731), conseiller au Châtelet (1677…), lieutenant particulier au Châtelet (1683…), maître des requêtes de l'hôtel du roi (1690-1718…), intendant de Bourgogne (1694-1705), intendant de Bretagne (1705-1716), conseiller au conseil du commerce (1716…), conseiller au conseil de la Marine (…1718…), conseiller d'État (1719…), maître des requêtes honoraire (…1722-1727…), conseiller d'État ordinaire (1728…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<cb13df03-3f2d-40e3-ac0f-8c40e963d92b> a crm:PC3_has_note ;
    crm:P01_has_domain <ce6ecc75-d874-46b1-813a-cb6b0ef2e79d> ;
    crm:P03_has_range_literal "M. Noël est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mars 1679. Le rédacteur du Mercure précise que \"Les Paroles sont de Mr Noël, Homme d'un fort grand merite, & que je vous ay déja dit que la Ville de Chartres avoit choisy pour son Avocat.\" (cf. [1679-03_042](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-03_042)). Il s'agit de Milles Noël dont l'acte de décès indique qu'il était \"advocat en parlement et de la ville de Chartres\" (cf. [Registres paroissiaux de Saint-Hilaire de Chartres, 31 janvier 1701](https://familysearch.org/ark:/61903/3:1:3Q9M-C33B-DRK3?cc=3460907 : 2 July 2021)). Il épousa en juin 1670 Catherine Bouvart." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cb392cc4-99e3-471c-8ab7-188064a61914> a crm:PC3_has_note ;
    crm:P01_has_domain <6b2ce12b-edfe-4f42-baaa-2104cbfdeb80> ;
    crm:P03_has_range_literal "M. Guillery est mentionné en tant que compositeur d'un Te Deum laudamus en musique, chanté le 10 juillet 1704 en l'église des Saints Innocents à Paris (cf. [1704-07b_246](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_246))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cb3e73c5-34e6-4e96-b9be-78ae1b02d887> a crm:PC3_has_note ;
    crm:P01_has_domain <35b6c99c-5913-4924-911a-732cc0e1855f> ;
    crm:P03_has_range_literal "Aumônier de la dauphine. Sa nomination en tant qu'évêque de Lavaur ne fut pas confirmée." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cb46cdc2-27c8-41b9-b8e8-211499ece884> a crm:PC3_has_note ;
