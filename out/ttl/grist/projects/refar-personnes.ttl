<874b35d7-9308-4595-985e-75e3b67825f8> a crm:PC3_has_note ;
    crm:P01_has_domain <cdc78b83-323b-4e9e-beb8-24946489c672> ;
    crm:P03_has_range_literal "Amelot de Chaillou (Jean-Jacques) (1689-1749), garde des Sceaux de France et secrétaire d'état des Affaires étrangères (1737-1744), président de l'Académie royale des sciences (1744 ; 1749)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<8759ac0d-7b8e-4ff6-91d5-647b7a1cc9e4> a crm:PC3_has_note ;
    crm:P01_has_domain <a8a1b119-358f-4e75-abc2-adb9b396b31c> ;
    crm:P03_has_range_literal "M. Puget, de Berance est l'auteur d'une ode publiée dans le Mercure galant en avril 1702 (cf. [1702-04_282](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-04_282)). Nous n'avons pas pu identifier avec certitude la ville où il réside à cette date. Peut-être s'agit-il de Cérance, dans l'évêché de Coutances (gouvernement de Normandie), à peu de distance de la Bérence, affluent de la Sienne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<875b4b4a-6f68-424f-83da-607efa25e178> a crm:PC3_has_note ;
    crm:P01_has_domain <23886db1-d3c0-482f-a351-11c4d31e0aee> ;
    crm:P03_has_range_literal "Bourgeois de Soleure, (cf. [1682-11_021](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-11_021))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<87888717-de62-4488-9226-464f7ccf1a11> a crm:PC3_has_note ;
