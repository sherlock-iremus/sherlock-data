<dcf7889c-c99f-4d08-8e70-a5bbe4d7ba79> a crm:PC3_has_note ;
    crm:P01_has_domain <8a96df5c-4a10-4849-9f59-c575509f1280> ;
    crm:P03_has_range_literal "Maître des comptes à Grenoble (cf. MG-1684-03\\_218)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dd186f38-8b45-461f-b8bc-12419a2428c8> a crm:PC3_has_note ;
    crm:P01_has_domain <6a6627a7-eb4f-47ec-aa27-8310c2670cac> ;
    crm:P03_has_range_literal "Thévenot (Melchisédech) (v. 1620-1692), envoyé du roi à Rome (1652-1655), physicien, commis à la garde de la Bibliothèque roi (1684-1691)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dd261cc0-f083-4fb5-81d6-b4c1eb3ec466> a crm:PC3_has_note ;
    crm:P01_has_domain <9b312415-9ab5-4e7b-ade3-ca8f331cd321> ;
    crm:P03_has_range_literal "Mlle de Fontenelle a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dd46947a-3ca7-4877-a6ef-5640957df111> a crm:PC3_has_note ;
    crm:P01_has_domain <9346c228-82e8-46bd-9078-f43a9df8cf74> ;
    crm:P03_has_range_literal "Giovanni Agostino Centurione prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (MG.1702-04\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dd4db6f1-d7ea-4d4e-8be5-c7c3ec394255> a crm:PC3_has_note ;
    crm:P01_has_domain <35e894ea-e14a-41ab-80ed-e116a14b443b> ;
    crm:P03_has_range_literal "Jean Nicollin a été maire de Béziers de 1698 à 1709 (cf. Société archéologique, scientifique et littéraire de Béziers, 2003, p. 62, consultable en ligne, https://gallica.bnf.fr/ark:/12148/bpt6k9604996h/f64.item, consulté le 16 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dd758327-cfe3-4f18-b55c-f4ea4ed40987> a crm:PC3_has_note ;
    crm:P01_has_domain <a573739d-b2bd-4072-8924-b632640016d0> ;
    crm:P03_has_range_literal "capitaine chevalier du guet de Paris (1682.09)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dd8f33b6-c26b-4780-a6aa-a150e57b864f> a crm:PC3_has_note ;
    crm:P01_has_domain <942a9090-6ba2-4016-8c8b-5d1d7f14a27c> ;
    crm:P03_has_range_literal "M. D. L. B. mit en musique une chanson parue dans le Mercure galant de février 1720 (MG-1720-02\\_162)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dda2db51-e0bb-4f81-934e-fbed7c75383d> a crm:PC3_has_note ;
