    crm:P01_has_domain <ab315a7c-51d4-4bf8-8f43-b16478658958> ;
    crm:P03_has_range_literal "D’après le Mercure galant, Flavio Barbarossa est « Recteur & Gouverneur du Comtat Venaissin » en 1701 (cf. [1701-02_036](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-02_036))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<95b3eac6-92d3-4d05-9fc5-619b35110cd4> a crm:PC3_has_note ;
