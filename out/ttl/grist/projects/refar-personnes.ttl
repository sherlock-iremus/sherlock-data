    crm:P03_has_range_literal "Albergotti (Antoine) (?-?), prêtre (actif en 1732)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e55c11f3-2f4a-44d0-a4b9-b9fe11132166> a crm:PC3_has_note ;
    crm:P01_has_domain <53a45c31-29e2-4ae1-a832-ad6e9b575407> ;
    crm:P03_has_range_literal "Lieutenant pour le roi de la ville de Montélimar (cf. [1687-06a_154](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-06a_154))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e56379b8-4c66-42db-8a4d-1a3a99167ca2> a crm:PC3_has_note ;
    crm:P01_has_domain <9614f4d9-b363-4bef-9138-3df74391a5ee> ;
    crm:P03_has_range_literal "Avocat au présidial d'Agen (cf. MG-1696-12_225)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e57d31e9-ad4c-4e63-825f-eb0a9d38ca4d> a crm:PC3_has_note ;
    crm:P01_has_domain <f40abec1-7a1b-43dc-bffa-58256ed2542b> ;
    crm:P03_has_range_literal "Laillet (Jacques-Joseph) (v. 1705 - ?), garde des eaux à la machine de Marly (…1728…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e582977b-a656-4b00-acd8-ddcc7edf942f> a crm:PC3_has_note ;
    crm:P01_has_domain <20247e5c-ab6a-40e5-a429-390162da5f7d> ;
    crm:P03_has_range_literal "Jurat de Bordeaux (cf. MG-1682-09b_015)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e58b3473-1deb-4a77-8bf4-9777ac0c4aba> a crm:PC3_has_note ;
    crm:P01_has_domain <bc201687-22a1-4dda-9854-4703e8e09a18> ;
    crm:P03_has_range_literal "Pasteur béarnais, converti en 1685 (cf. MG-1685-08\\_141)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e5b4500f-cb18-408b-9402-91681148c74b> a crm:PC3_has_note ;
    crm:P01_has_domain <aa1b5e8f-7ca1-4fe6-a030-cb3da39905ee> ;
    crm:P03_has_range_literal "Abbé. Agent diplomatique et artistique de Mazarin puis de Colbert à Rome." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e60aab6b-39db-42c5-aeba-4ac16dd190e6> a crm:PC3_has_note ;
    crm:P01_has_domain <39cf34ed-bba5-4d2e-bb12-62c3b0faf7e4> ;
    crm:P03_has_range_literal "M. Nolet de Cadhilac remporta le prix des Lanternistes de Toulouse en 1702. Le Mercure galant dit de lui qu'il est né \"pour ainsi dire, dans le sein des Muses. Son illustre Famille les a toujours cultivées, & c'est là particulierement qu'elles aiment à faire entendre leurs charmants Concerts\" (cf. [1702-07a_9](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-07a_9))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e65b79de-5647-4f13-86ab-d89a89ebb1e2> a crm:PC3_has_note ;
    crm:P01_has_domain <05ae596d-ca4d-41a0-b05b-223c12e0454d> ;
    crm:P03_has_range_literal "conseiller d'État" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e660ca55-72bd-42e7-8f1e-05af96f10ce0> a crm:PC3_has_note ;
    crm:P01_has_domain <de268a54-fd7e-4b86-9372-24e8ef9193cf> ;
    crm:P03_has_range_literal "Président et lieutenant général à Niort (cf. [1692-08a_044](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1692-08a_044))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e668da82-c2e4-4207-b0d4-3f8a6b649a44> a crm:PC3_has_note ;
    crm:P01_has_domain <ba8da1d1-8224-43e8-8a8a-37d99bbf0ef6> ;
    crm:P03_has_range_literal "Francisco Antonio de Borja-Centelles y Ponce de Leán (né le 27 mars 1659 à Sassari, en Sardaigne, et mort à Calahorra le 3 avril 1702) est un cardinal autrichien de la fin du XVIIe et du début du XVIIIe siècle. Il est le frère du cardinal Carlos de Borja-Centelles y Ponce de Leán (1720). Le pape Innocent XII le crée cardinal lors du consistoire du 21 juin 1700, il ne reçut jamais son titre cardinalice. Il ne participe pas au conclave de 1700, lors duquel Clément XI est élu. Le cardinal Borja est élu évêque de Calahorra-La Calzada en 1701 et est promu à l'archidiocèse de Burgos le 3 avril 1702, le jour de sa mort . (https://fr.wikipedia.org/wiki/Francisco\\_Antonio\\_de\\_Borja-Centelles\\_y\\_Ponce\\_de\\_Leán, consulté le 9 janvier 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e669d662-850f-460f-8b18-86529fb52897> a crm:PC3_has_note ;
    crm:P01_has_domain <815eccb9-eb1f-4b6c-b6a0-b2054541d087> ;
    crm:P03_has_range_literal "Maître de chapelle de Saint-Agricol d'Avignon (1687.07)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e6723a48-3b4f-483b-92b9-816e62a9cceb> a crm:PC3_has_note ;
    crm:P01_has_domain <ad8fc296-d3e5-4e5b-a5fb-ca095f9dc0aa> ;
    crm:P03_has_range_literal "M. Bernard (fl. 1701) est l'auteur d'un poème publié en janvier 1701 dans le Mercure galant (cf. MG-1701-01\\_036)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e6737668-5f10-4e24-a7de-c9988e520242> a crm:PC3_has_note ;
    crm:P01_has_domain <8da61c11-0023-4930-b687-1d6231f2cbda> ;
    crm:P03_has_range_literal "Capitaine du château, ville et comté de Jarnac (cf. [1682-10a_035](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10a_035))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e67f7ad4-acf4-4ac0-831e-28fbc63587bb> a crm:PC3_has_note ;
    crm:P01_has_domain <92d1402b-3877-4357-a1c5-5a8650f9d50a> ;
    crm:P03_has_range_literal "secrétaire du roi (1668), commissaire général de l'artillerie (1676), trésorier général des finances de la dauphine (1680)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e6bada70-c08c-4151-b44d-d60f2413feda> a crm:PC3_has_note ;
    crm:P01_has_domain <599b666c-0b0b-496b-932b-1e74d3089e7f> ;
    crm:P03_has_range_literal "M. Genais, auteur de la musique d'un air paru dans le Mercure galant en mars 1684, était alors maître de musique  à Tours (cf. [1684-03_348](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-03_348))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e6bc7860-2133-46d9-95ee-e8b20ce6f27c> a crm:PC3_has_note ;
    crm:P01_has_domain <a8584bbd-475a-4198-8ae4-385cd88941db> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e701e5d2-f6ed-41c2-b282-9e597ad8dc33> a crm:PC3_has_note ;
    crm:P01_has_domain <f62c4850-224c-4c72-a312-fbf79ad3a4c5> ;
    crm:P03_has_range_literal "Michel I Ancel Desgranges est maître des cérémonies du roi de France de 1691 à 1716 (cf. http://www.chateauversailles-recherche-ressources.fr/jlbweb/jlbWeb?html=notetiquette&ref=2085, consulté le 22 janvier 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e708f48c-b851-4c67-8f07-ab2be02e3767> a crm:PC3_has_note ;
    crm:P01_has_domain <8a4450df-2c9c-4ee9-9c12-2431e85efb96> ;
    crm:P03_has_range_literal "Dessus de violon de Monsieur." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e75f5b29-f10b-4793-a4a2-e4d7a68d00d1> a crm:PC3_has_note ;
    crm:P01_has_domain <a4b330c8-8b69-4a17-9a98-3dc7aa0f93fd> ;
    crm:P03_has_range_literal "Bourdelin (Claude II) (1667-1711), premier médecin de la duchesse de Bourgogne (1708-1711)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e76069e9-c9c8-4709-bf88-04eea3b9cefd> a crm:PC3_has_note ;
    crm:P01_has_domain <7f0b7969-c4c6-4f1e-b4ff-869a684bbe6d> ;
    crm:P03_has_range_literal "M. Dader est dit «  de Toulouse  » dans la livraison du Mercure galant de mars 1697 (cf. [1697-03_176](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1697-03_176))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e77d1558-2340-45f2-af70-7a1b69c37670> a crm:PC3_has_note ;
    crm:P01_has_domain <486cc0bf-52d3-45b7-a57f-cafe996be1a7> ;
    crm:P03_has_range_literal "Desmarets de Vaubourg (Jean-Baptiste) (1646-1740), conseiller au parlement de Paris (1678…), maître des requêtes (1681…), intendant de Béarn (1685-1687), d'Auvergne (1687-1691), de Lorraine (1691-1698), de Franche-Comté (1698-1700), maître des requêtes honoraire (1699…), intendant de Rouen (1700-1701), directeur des affaires commerciales au contrôle général des Finances (1701…), conseiller d'État (1709…), membre du conseil de commerce (1715…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e782db70-a9a6-46ea-ac03-951a3f02e860> a crm:PC3_has_note ;
    crm:P01_has_domain <22a8c4b7-5ab7-465d-ac07-d6c9cf53f5e2> ;
    crm:P03_has_range_literal "Oratorien, professeur au collège de Juilly (cf. MG-1688-08\\_268)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e78c0db4-c6a4-4bb8-8ea8-7049051df101> a crm:PC3_has_note ;
    crm:P01_has_domain <27240195-a929-4ce0-a326-cb37e1d9f954> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame la Présidente de Beaumont qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e7914b6e-de2f-4899-936e-d7a4533fe4f7> a crm:PC3_has_note ;
    crm:P01_has_domain <77971234-af23-4825-85e3-93bd75df6183> ;
    crm:P03_has_range_literal "Hérault d'armes au titre de Roussillon (cf. MG-1684-10\\_007)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e79ed9f8-ff1a-4730-9e77-54c83764e360> a crm:PC3_has_note ;
    crm:P01_has_domain <9212af58-ef53-47e5-998d-72a0cd8863b3> ;
    crm:P03_has_range_literal "Bachelier en théologie de la faculté de Paris, curé d'Ambrières (diocèse du Mans) puis d'Alençon (cf. Inventaire des titres, papiers et enseignement concernant la cure d'Alençon…., par Messire Pierre Belard, Prestre, publ. par la Société historique et Archéologiques de l'Orne, Alençon, E. Renaut-de Boise, 1895, p. 10)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e7c7ef8b-8a72-4734-bbca-df8be311cc0c> a crm:PC3_has_note ;
    crm:P01_has_domain <d627d07d-b721-45d9-b744-756eaa102860> ;
    crm:P03_has_range_literal "Cuvillier (Charles-Étienne-Gabriel) (1728-1793), premier commis des Bâtiments du roi (1764-1780...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e7cf2a38-49d7-4682-89fb-2974505bc633> a crm:PC3_has_note ;
    crm:P01_has_domain <a7e97396-b900-4032-8485-557594603c6d> ;
    crm:P03_has_range_literal "Roi de Danemark, de Norvège (1513-1523) et de Suède (1520-1523)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e7de9b08-e68a-49e3-bff7-947e13afc0ea> a crm:PC3_has_note ;
    crm:P01_has_domain <4ca7e83f-bccb-48c4-99f4-5156fd5538d4> ;
    crm:P03_has_range_literal "Reçut les trois Fleurs de l'Académie des jeux floraux de Toulouse en 1694 (cf. [1694-05_140](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1694-05_140))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e7ff9dc9-3b75-4881-aad5-3e8670a1b2b0> a crm:PC3_has_note ;
    crm:P01_has_domain <d356c2c7-9078-4a94-9a02-37136dc41915> ;
    crm:P03_has_range_literal "Marc-Antoine Oudinet était avocat aux parlements de Paris, puis de Reims et garde du cabinet des médailles du roi de 1689 à 1712." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e810cd47-1807-471d-a923-f8201b2bc49b> a crm:PC3_has_note ;
    crm:P01_has_domain <ea002c7f-eedd-4852-8988-a69ac7e854ea> ;
    crm:P03_has_range_literal "Chanteur, appartenant à la Musique du roi." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e814fd07-3621-4d87-9900-5585b09dd9fa> a crm:PC3_has_note ;
    crm:P01_has_domain <4f12913c-4ecc-48be-aafa-a1fe8babbca1> ;
    crm:P03_has_range_literal "Capitaine perpétuel de la compagnie des chevaliers du jeu de l'arquebuse de Provins (cf. [1686-10a_073](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-10a_073))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e81accfa-4c19-4814-8fab-42457ce82c34> a crm:PC3_has_note ;
    crm:P01_has_domain <fd76b1ee-98b0-4460-ba99-822d9556313b> ;
    crm:P03_has_range_literal "M. Maugard, de Troyes, est l'auteur d'une paraphrase du psaume Exaudiat publiée dans le Mercure galant d'août 1702 (MG-1702-08\\_176). Si l'on se fie au texte de l'épître en vers à Louis Nivelle publiée dans le périodique en février 1702, c'est le même M. Maugard qui en est l'auteur (MG-1702-02a\\_146)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e83e7d56-0be8-47fd-be4d-e522c1b32a78> a crm:PC3_has_note ;
    crm:P01_has_domain <aebfbee3-998e-4d9c-9db5-9877bb8fe0e3> ;
    crm:P03_has_range_literal "Jean Berthus, seigneur de Langlade, a été vice-sénéchal de Saintonges durant une quarantaine d'années à partir de 1677 (cf. Gustave Chaix d'Est-Ange, Dictionnaire des familles françaises anciennes ou notables à la fin du XIXe siècle, Volume 4, Évreux : impr. de C. Hérissey, 1903-1929, p. 118 (cf. https://gallica.bnf.fr/ark:/12148/bpt6k1119977/f122.item, consulté le 4 mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e84bcb2a-7ba3-46e1-a847-3083618df94e> a crm:PC3_has_note ;
    crm:P01_has_domain <148e9e8e-d1f5-462d-9a38-3eeebd49dd89> ;
    crm:P03_has_range_literal "L'abbé Imperiale assista à la célébration de la fête de Saint-Lazare à l'abbaye de Saint-Germain-des-Prés le 19 décembre 1703 (cf. MG-1703-01_210)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e8535c80-ba22-44fc-99a6-fe443211abcc> a crm:PC3_has_note ;
    crm:P01_has_domain <c8c7ad2e-1fdc-4be8-96ca-e8603acf9c39> ;
    crm:P03_has_range_literal "Choiseul-Beaupré (Claude-Antoine de) (1697-1763), évêque de Châlons (1733-1763)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e8606e44-4e73-4eb5-8928-ebadee832e93> a crm:PC3_has_note ;
    crm:P01_has_domain <8c15ac65-6a4f-4172-a378-c2f7959c3fa6> ;
    crm:P03_has_range_literal "Fer (Nicolas de) (1646-1720), géographe du roi, géographe du roi d'Espagne (1702…), du dauphin (1688?-1711), cartographe, éditeur d'estampes" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<e8663a4c-1ceb-4c1c-b651-80aa8404d51d> a crm:PC3_has_note ;
    crm:P01_has_domain <bdbb41ee-e9af-44a7-add3-b01fe42858fa> ;
    crm:P03_has_range_literal "François I Martin est un compositeur français, actif à Paris durant la seconde moitié du XVIIe siècle. Il a été ordinaire de la musique de Gaston d'Orléans et a publié un recueil de pièces pour la guitare (1663), un recueil d'airs (1668) et des airs isolés, dont quatre dans le *Mercure galant* (cf. MG-1678-04\\_071 ; MG-1688-11a\\_136 ; MG-1689-04a\\_076 et MG-1689-04a\\_317). Il est également l'auteur d'une pastorale, Les Bergers heureux (cf. MG-1689-09\\_021). Il est le père de François (1661-?)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e870955a-31cd-41fb-911b-107cbcce16ff> a crm:PC3_has_note ;
    crm:P01_has_domain <d3cf1a9c-a77f-417c-9886-8fb43e34f65a> ;
    crm:P03_has_range_literal "Claude Philippe Auburtin fut « reçut avocat au Parlement de Metz le 12 septembre 1678. Il fut maire alternatif de Metz en 1707-1712 et 1720-1738 (cf. étienne Broglin, Dictionnaire biographique sur les pensionnaires de l'académie royale de Juilly (1651-1828) Tome I, 2017, p. 533)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e8cc7645-7225-44a4-9e70-9022b22602b3> a crm:PC3_has_note ;
    crm:P01_has_domain <7792cd63-6a87-4521-9b7e-3ac6892efa31> ;
    crm:P03_has_range_literal "Ambassadeur du Maroc à la cour de France (cf. [1682-01_291](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-01_291))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<e90d9d1c-255c-490c-8ec7-2b0321284d54> a crm:PC3_has_note ;
    crm:P01_has_domain <275e3cf4-ce90-465d-88de-eb70de82441c> ;
