<b3ce0214-2d55-4a3c-880c-f38ea04126b0> a crm:PC3_has_note ;
    crm:P01_has_domain <856ccc02-eab7-4354-9252-5d30747aed2e> ;
    crm:P03_has_range_literal "Catherine-Charlotte de Gramont était dame d'honneur de la reine de 1725 à 1735." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b3d287d9-5521-4251-8927-232cea0a84c7> a crm:PC3_has_note ;
    crm:P01_has_domain <13a90220-76ac-4275-9580-19f62400a927> ;
    crm:P03_has_range_literal """Compositeur et maître de musique. D’après la page de titre de son 1er livre de cantates françaises (1727), il était à cette date maître de musique de l’Académie de Rouen. D’après sa méthode pour l’accompagnement du clavecin (1733), il était alors maître de musique de l’Académie de Lille. C'est peut-être lui qui se présenta au concours de recrutement pour le poste de sous-maître de la musique de la Chapelle du roi de 1683.
Sur ce compositeur, voir Montagnier, Jean-Paul C. “Autour de Laurent Gervais (ca 1670-1748), Compositeur, Claveciniste et Pédagogue.” \\_Revue Belge de Musicologie / Belgisch Tijdschrift Voor Muziekwetenschap\\_, vol. 57, 2003, pp. 113–32. \\_JSTOR\\_, . Accessed 12 Feb. 2025).""" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b3d905f1-9c3e-4e23-9fa2-99a6f5851afd> a crm:PC3_has_note ;
    crm:P01_has_domain <033d15f7-4148-401d-aed5-5f41dd330272> ;
    crm:P03_has_range_literal "Lieutenant criminel au baillage de Soissons (cf. [1698-03_237](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-03_237))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b3e5f909-2c63-4353-ba4e-11b0a7b49ee2> a crm:PC3_has_note ;
    crm:P01_has_domain <c5a9a789-92f4-45ba-a585-170eaec1f0d4> ;
    crm:P03_has_range_literal "Mlle de Castille est l'autrice d'un poème, qui sera mis en musique, publié dans le *Mercure galant* d'avril 1680 (cf. [1680-04_242](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-04_242))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b422c251-6993-4992-a06b-d09833b79c1e> a crm:PC3_has_note ;
    crm:P01_has_domain <2ce6d283-7062-46dc-895e-831fa8a5d4c3> ;
    crm:P03_has_range_literal "M. du Breuil est l'auteur d'un air paru dans le *Mercure galant* d'août 1714 (cf. MG-1714-08\\_221)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

