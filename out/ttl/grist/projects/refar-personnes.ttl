    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a8fdb0b1-2f12-4272-8da9-d2dce7cafe2a> a crm:PC3_has_note ;
    crm:P01_has_domain <ab315a7c-51d4-4bf8-8f43-b16478658958> ;
    crm:P03_has_range_literal "D’après le Mercure galant, Flavio Barbarossa est « Recteur & Gouverneur du Comtat Venaissin » en 1701 (Cf. MG-1701-02\\_036)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a905dc35-bb5a-4bc6-8585-d34b375d82d9> a crm:PC3_has_note ;
    crm:P01_has_domain <c8496335-66b9-4ea3-bbe1-67940026db95> ;
    crm:P03_has_range_literal "M. Du Pré composa la musique d'un air paru dans le Mercure galant (cf. [1679-02_253](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-02_253)). Peut-être s'agit-il de Laurent Dupré (1642-1709)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a94d3a9e-7c46-4dc5-af47-ebd453019043> a crm:PC3_has_note ;
    crm:P01_has_domain <99bf7811-baf7-477b-9615-182a4612b51c> ;
