<55e8c2ac-1176-4729-bab3-f55aefbe4c82> a crm:PC3_has_note ;
    crm:P01_has_domain <05e8b5e2-9777-429a-9d5e-885dd3dfce36> ;
    crm:P03_has_range_literal "Chanteur ayant appartenu à la Musique du dauphin et à la musique du roi où il occupa la charge de chantre ordinaire (1679-1697 ca)." ;
