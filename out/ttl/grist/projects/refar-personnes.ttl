    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7a3badcc-fad9-4a3f-827a-15ee2e8625ba> a crm:PC3_has_note ;
    crm:P01_has_domain <816bf254-08f6-4c59-9cb1-d91d2a533ad9> ;
    crm:P03_has_range_literal "M. Pageau est l'auteur des paroles d'un air publié dans le *Mercure Galant* d'août 1679 (cf. [1679-08_362](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-08_362)). Dans sa présentation de l'air, le rédacteur du *Mercure* précise que M. Pageau est avocat au Parlement." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7a725235-e575-4b6b-b3f8-3656de45a709> a crm:PC3_has_note ;
    crm:P01_has_domain <7105b91c-3f3a-4899-95fb-cf94ed986811> ;
    crm:P03_has_range_literal "Religieuse de l'abbaye de Vignats, soeur de Marguerite de Froulay de Tessé, abbesse de cette abbaye (cf. [1682-04_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-04_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7a7f637d-7f92-48c6-ac7d-0f1f2a0ced75> a crm:PC3_has_note ;
    crm:P01_has_domain <5f7fa1fb-d0a0-45f3-9272-4cf68f1a9e6b> ;
    crm:P03_has_range_literal "Grand-vicaire de Soissons (cf. [1682-10b_246](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-10b_246))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7aa33a1b-668a-43ea-8ee9-fb07cc6a4239> a crm:PC3_has_note ;
    crm:P01_has_domain <7e938c0e-fa1c-48d4-bbb5-1f32ff9dcd97> ;
    crm:P03_has_range_literal "Maître de la chapelle de la cathédrale de Soissons. Il a fait publier \"Les délices de la table, des airs...meslez de. cantatilles\" et diverses cantatilles." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7aa765f2-4350-44fb-a3bb-9ac42848d6cc> a crm:PC3_has_note ;
    crm:P01_has_domain <7b5d9f0b-3dc5-4032-ab81-0eac382512cc> ;
    crm:P03_has_range_literal "Bonneau (René) (1630-1711), aumônier du roi (...1663-1676), dit l'abbé Bonneau" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7aad15df-06d1-41b2-a5a8-d4a238de2535> a crm:PC3_has_note ;
    crm:P01_has_domain <b780b24d-f8ac-4979-965f-0b3af814fbf1> ;
    crm:P03_has_range_literal "Docteur es droits en la cour, accède en 1682 à l'office de vice-sénéchal de Montélimar." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7ab488c2-b2d9-4e6b-a005-13a38e033f90> a crm:PC3_has_note ;
