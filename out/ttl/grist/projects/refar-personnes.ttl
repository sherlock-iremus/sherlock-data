<7d92653e-7b3d-4251-bdfd-4212560d038a> a crm:PC3_has_note ;
    crm:P01_has_domain <506ac662-2f0f-4469-8a8d-cce3de126360> ;
    crm:P03_has_range_literal "Barbier de La Rivière (Louis) (1593-1670), premier aumônier du duc Gaston d'Orléans (1643-1660), grand aumônier de la reine (1660-1670), évêque de Langres (1655-1670)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7da45bce-41bd-4a2b-9336-48edf54029b8> a crm:PC3_has_note ;
    crm:P01_has_domain <e4d115ec-b455-40a2-afe4-d1fe46444d3b> ;
    crm:P03_has_range_literal "M. Prevost était un compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. MG-1683-04_310). Lors de la publication d'un air dans le *Mercure galant*, il est indiqué qu'il était «  ci-devant maître de musique de la cathédrale de Clermont en Auvergne  » (cf. MG-1687-04_160)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7de12477-ff16-46f0-9490-86a8b215ee9b> a crm:PC3_has_note ;
    crm:P01_has_domain <cb26ee1d-4d7f-42fe-a1da-a01610f09451> ;
    crm:P03_has_range_literal "Ambassadeur de Hollande (cf. MG-1698-08_281)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7df60900-ab5a-42ea-b95f-2935f2e48540> a crm:PC3_has_note ;
    crm:P01_has_domain <47bdd61a-ce7b-4a32-9e1b-ebe50ded8673> ;
    crm:P03_has_range_literal "Léonard de la Valette, seigneur des Plans, était second président de la Chambre des Comptes de Montpellier." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7df60e61-8b3b-4ec2-be66-f44f3c34a231> a crm:PC3_has_note ;
    crm:P01_has_domain <fa1204f1-dc80-44d0-a34b-fa57a6d0fa41> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne une Madame de Brion , épouse de Mr de Brion \"cy-devant Capitaine d'Infanterie dans la Reyne\", qui a participé aux réjouissances publiques à Château-Gontier pour la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7dfba792-ecfe-48b5-88cb-7773c7c4e719> a crm:PC3_has_note ;
    crm:P01_has_domain <495c0c16-8074-4b31-8942-60dea4ee8b03> ;
    crm:P03_has_range_literal "Ossun (Geneviève de Gramont, comtesse d') (1751-1794), dame d'atours de la reine (1781-1792)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7e021466-a034-4ae5-a8fb-d1e82d878f0f> a crm:PC3_has_note ;
    crm:P01_has_domain <190343c3-4674-4734-b62a-541a527013ba> ;
    crm:P03_has_range_literal "Charles Allard, le père, était un sauteur et un entrepreneur de spectacles. Il a introduit ses deux fils, Charles et Pierre, en 1699 lors des célébrations du carnaval à Marly (cf. http://www.theatrales.uqam.ca/foires/08a.html#allard, consulté le 25 mai 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7e1109c8-ef41-43ce-a888-c10614e48334> a crm:PC3_has_note ;
    crm:P01_has_domain <71a26cb5-0fa6-4871-8422-71d2f48e1ae3> ;
    crm:P03_has_range_literal "Docteur en droit, comte Palatin, consulteur du Saint-Office, ambassadeur d'Avignon auprès du Saint-Siège, doyen de la compagnie de la rote en Avignon (cf. [1681-11_320](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-11_320))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7e178215-97ea-47dc-9b49-63d33e028591> a crm:PC3_has_note ;
    crm:P01_has_domain <8a1e7961-5f38-43f9-9bb9-136d37f07ca7> ;
    crm:P03_has_range_literal "Aide-major du Régiment des Gardes (cf. [1679-01_234](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-01_234))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7e1db1ee-842d-44c5-958d-b307b02faf7f> a crm:PC3_has_note ;
    crm:P01_has_domain <c2bf81cc-b0ac-48c6-9ce7-f26d79400803> ;
    crm:P03_has_range_literal "champion de Jacques II d'Angleterre lors de son couronnement" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7e3913ff-7e8f-4e97-8a10-26d80eff8ab4> a crm:PC3_has_note ;
    crm:P01_has_domain <bdf7a9b6-b37d-49b1-86d1-94e85f7cf63b> ;
    crm:P03_has_range_literal "D’après la thèse de Juan Antonio López Anguita intitulée “Pouvoir et influence politique d'une reine d'Espagne lors de la Guerre de Succession : Marie-Louise Gabrielle de Savoie, première épouse de Philippe V”, Madame de Noyers (?-1720) était gouvernante de Marie-Louise, reine d’Espagne (cf. https://core.ac.uk/download/pdf/33108544.pdf, consulté le 4 février 2021). En 1655, elle épousa François Rey, baron de Noyers." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7e3ae3bb-9420-40f7-ba64-b04d0c7e9493> a crm:PC3_has_note ;
    crm:P01_has_domain <6d68645b-cb2f-45bf-b6f8-b0b61e5d0614> ;
    crm:P03_has_range_literal "Robert (Philippe), chef de fourrière de la Maison de la duchesse d'Orléans (…1636-1646…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7e3eda29-e9b3-4172-9db7-ef8e656b72cc> a crm:PC3_has_note ;
