    crm:P03_has_range_literal "Boufflers (Marie-Anne-Philippine-Thérèse de Montmorency-Logny, duchesse de) (1730-1797), dame du palais de la reine (1747-1768)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<156e79c2-a469-46ba-9195-cf0870dd3084> a crm:PC3_has_note ;
    crm:P01_has_domain <d90f0b6c-1187-4134-bc11-26fd8887b566> ;
    crm:P03_has_range_literal "Jacques Leullier (fl. 1693-1723) était curé de Saint-Louis-en-l'Île depuis 1693. Il résigne sa cure vers 1723 à Jacques Robbe, son neveu (cf. de Dainville-Barbiche, Ségolène. « Prosopographie des curés de Paris (1695-1789) », Devenir curé à Paris. Institutions et carrières ecclésiastiques (1695-1789), sous la direction de de Dainville-Barbiche Ségolène. Presses Universitaires de France, 2005, p. 485)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1579679d-0dd6-4ab4-8680-12913dfdc869> a crm:PC3_has_note ;
