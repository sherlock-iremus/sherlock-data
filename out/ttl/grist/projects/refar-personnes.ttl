<543536f4-b437-43e7-a3c8-f8731706f00d> a crm:PC3_has_note ;
    crm:P01_has_domain <dcb8c1b2-3429-42ab-a0a4-d6fcbca91506> ;
    crm:P03_has_range_literal "Mlle Le Rouge chante lors d'une concert donné par le Petit concert de Troyes le 27 juillet 1756 pour célébrer la prise du fort Saint-Philippe (cf. Annonces, affiches et avis divers. 8 septembre 1756, n° 36, p. 143). Dans la musique latine et française, elle reçoit \"les applaudissements qu'elle s'attire de plus en plus par ses belles cadences et par le goût de son chant\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<544b0359-8592-41c6-ab64-8a5707568cb7> a crm:PC3_has_note ;
    crm:P01_has_domain <14d8b569-71e5-4acb-be3e-a06695baeb7b> ;
    crm:P03_has_range_literal "Directeur de l'Académie de Soissons (cf. [1693-05_242](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-05_242))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<54b2554a-432b-4dd1-b19b-95c508921761> a crm:PC3_has_note ;
    crm:P01_has_domain <a465a04d-6adf-40b1-92b9-a9d5ffab96d1> ;
    crm:P03_has_range_literal "Gentilhomme ordinaire de Monsieur le Duc (Louis III de Bourbon (1668-1710), prince de Condé), premier écuyer, envoyé auprès de Jacques II (1685), ambassadeur à Turin (1697),à  La Haye (1700), conseiller d'état d'épée (1701)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<554d1b4a-ce01-4a7f-8509-172da435b65f> a crm:PC3_has_note ;
    crm:P01_has_domain <658611ee-34cf-4470-af75-c3782f690701> ;
    crm:P03_has_range_literal "Compositeur, candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

