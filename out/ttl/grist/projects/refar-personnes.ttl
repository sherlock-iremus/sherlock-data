    crm:P03_has_range_literal "Président au Parlement de Paris." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aa298972-2c64-42e0-880d-67687e8612d6> a crm:PC3_has_note ;
    crm:P01_has_domain <b041a97e-ce2b-481b-ac6d-7e426fdb61a3> ;
    crm:P03_has_range_literal "Michel Bourayne a été «  Maître des maçons de Chartres et voyer, entrepreneur Capitaine des chevaliers du Vidame de Chartres, Premier échevin de Chartres (1710), Receveur du domaine du duché de Chartres (1710)  » (cf. <https://gw.geneanet.org/favrejhas?lang=fr&n=bourayne&p=michel>, consulté le 1 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aa378a6f-808e-47c4-9e5c-ecd60497a3d4> a crm:PC3_has_note ;
    crm:P01_has_domain <81f77d72-90e2-4dd4-b2ba-57a3439295d0> ;
    crm:P03_has_range_literal "Major de Libourne (cf. MG-1682-10a_157)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aa90350e-8b1d-4362-96dc-1ee4c7a7dc94> a crm:PC3_has_note ;
    crm:P01_has_domain <31a6ffe1-b5ef-49f2-8cd9-7672deef9e08> ;
    crm:P03_has_range_literal "Antin (Françoise-Gillette de Montmorency-Luxembourg, duchesse d') (1704-1768), dame du palais de la reine (1725-1757)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aab6a3a1-6222-4cf4-bd97-234e752d5a4b> a crm:PC3_has_note ;
    crm:P01_has_domain <aafc39d7-7e5c-4d53-ab08-3366e1a8c585> ;
    crm:P03_has_range_literal "Poète, auteur du poème de trois cantatilles (Alcide et Omphale, Le Berger amoureux et l'Adieu du guerrier dont la musique a été publiée entre 1736 et 1744)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<aadcd0bc-1ab4-4477-98f2-1d191d02b86f> a crm:PC3_has_note ;
