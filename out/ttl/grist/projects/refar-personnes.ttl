<c07ee6f6-6526-4c66-ac7b-04305e66a385> a crm:PC3_has_note ;
    crm:P01_has_domain <d317f041-cbfa-4082-a119-7960135952ec> ;
    crm:P03_has_range_literal "Jean-Louis de Saint-Estève fût lieutenant dans les Gardes du corps du roi (cf. https://gallica.bnf.fr/ark:/12148/bpt6k346962/f61.image.r=%22gabriel%20de%20saint%20est%C3%A8ve%22?rk=85837;2, consulté le 18 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c081c3f6-8729-4f10-807a-a62ba3c15022> a crm:PC3_has_note ;
    crm:P01_has_domain <00cfae11-79f1-44da-93ef-d06e2565b506> ;
    crm:P03_has_range_literal "M. du Careau composa la musique de quatre airs parus dans le Mercure galant en 1707 (cf. [1707-02_19](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-02_19), [1707-02_163](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-02_163), [1707-05_134](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-05_134), [1707-11-12_160](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1707-11-12_160))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c09feb9d-7406-4758-af4b-d010cbcaa5ed> a crm:PC3_has_note ;
    crm:P01_has_domain <70509060-9703-474f-ae9a-74e97c3350ea> ;
    crm:P03_has_range_literal "Coquet (Pierre-Étienne-Léon) (1726-1789), secrétaire de la garde-robe de Madame Louise, maître à écrire des pages de la Chambre ou garde-robe du roi, secrétaire de la Chambre de Madame Victoire, commis des Bâtiments du roi (…1787)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c0dbac01-1a46-4725-890e-7fa6241b7b60> a crm:PC3_has_note ;
    crm:P01_has_domain <c8273412-90c5-4407-9420-08b50134e1d8> ;
    crm:P03_has_range_literal "Ingénieur du roi (cf. [1686-10a_281](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1686-10a_281))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c0dde551-23b5-4939-9cf6-159e933bad1d> a crm:PC3_has_note ;
    crm:P01_has_domain <50c69c36-3c73-415d-a8aa-ef67622a9b1d> ;
    crm:P03_has_range_literal "M. de Collignon mit en air quatre poésies de Mlle l'Héritier parus dans les livraisons du Mercure galant de juillet 1700, décembre 1700 et janvier 1701 (cf. [1700-07_109](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1700-07_109), [1700-07_300](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1700-07_300), [1700-12_142](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1700-12_142), [1701-01_387](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_387))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c0e18705-aa55-40b5-8904-e4d8dcbc9a9a> a crm:PC3_has_note ;
    crm:P01_has_domain <0bfa8f2d-e816-4aa5-b242-21f1385961e8> ;
    crm:P03_has_range_literal "Membre de l'Académie de Nîmes, auteur d'une l'épître au roi d'Espagne parue dans le Mercure galant de janvier 1701 (cf. [1701-01_085](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-01_085)) et probablement aussi de l'épître au Roy sur la prise de Barcelone, (Paris, J.-B. Coignard, 1697, https://catalogue.bnf.fr/ark:/12148/cb30718820j)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c0f712b4-be9f-4070-94eb-96bc6ebffd90> a crm:PC3_has_note ;
    crm:P01_has_domain <dd68f836-998a-4f41-a02d-dfbb6168dd54> ;
    crm:P03_has_range_literal "Vicaire patriarcal de Constantinople (cf. [1687-08b_254](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-08b_254))" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c14fe6a8-3cca-4e02-8377-7f87d580899c> a crm:PC3_has_note ;
    crm:P01_has_domain <539e55bc-463b-48da-aa3a-4c6c723e6217> ;
    crm:P03_has_range_literal "Premier président du parlement de Bourgogne (1715-1745)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c15dc83d-d134-4dd9-ac46-2ef73ee4884b> a crm:PC3_has_note ;
    crm:P01_has_domain <99dffc21-b6ea-4d6d-b63c-29b7773e89cc> ;
    crm:P03_has_range_literal "\"Mr le Comte de Rocquebrune\" est l'auteur d'un air publié dans le *Mercure Galant* de juin 1681 (cf. MG-1681-06\\_88)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c16a6def-4463-490d-ae22-5c0a177d3232> a crm:PC3_has_note ;
    crm:P01_has_domain <fa1204f1-dc80-44d0-a34b-fa57a6d0fa41> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne une Madame de Brion , épouse de Mr de Brion \"cy-devant Capitaine d'Infanterie dans la Reyne\", qui a participé aux réjouissances publiques à Château-Gontier pour la naissance du duc de Bretagne (cf. MG-1704-07b\\_393)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c1907e23-1180-41e3-ada8-0950d8a2b94f> a crm:PC3_has_note ;
    crm:P01_has_domain <f3ae752d-f97f-44d1-8486-c8af6d1c502d> ;
    crm:P03_has_range_literal "Maître des comptes à Grenoble (cf. MG-1684-03\\_218)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c1a3ea35-f1ab-4fd5-a3d0-7c2c7712ae65> a crm:PC3_has_note ;
    crm:P01_has_domain <e87e6f31-0d27-4847-9d4f-d70d53d40cd6> ;
    crm:P03_has_range_literal "M. Buquet, d'Abbeville, est l'auteur des paroles d'un air publié en septembre 1691 (cf. MG-1691-09\\_311)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c1c6ac34-26e7-476b-aa6a-5878b82f98cd> a crm:PC3_has_note ;
    crm:P01_has_domain <ef0e5720-0df9-4957-8cad-2f5758a2ec57> ;
    crm:P03_has_range_literal "Ignace-François de Limojon de Saint Didier a présenté en 1701 au duc d'Anjou et à ses frères une ode lors de leur passage à Avignon. Il est aussi mentionné qu'il est le neveu d'Alexandre-Toussaint de Limojon (1630?-1689), chevalier de Saint Didier (cf. [cf1701-05b_079](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/cf1701-05b_079))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c1f73f05-6d73-4e43-a702-6bc76ccb7ef8> a crm:PC3_has_note ;
    crm:P01_has_domain <603c95db-7341-40d6-8d50-8b91e6692b62> ;
    crm:P03_has_range_literal "Le comte de Priego prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c240bf88-bde8-418c-aaf1-b7c175f054ff> a crm:PC3_has_note ;
    crm:P01_has_domain <14c5a1ef-bf49-4643-a762-1859c44f1178> ;
    crm:P03_has_range_literal "M. de L. C. est l'auteur des paroles d'un air publié dans le *Mercure Galant* de juin 1702 (cf. MG-1702-06a_309)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c26f095b-58d2-4d28-ba95-f42ab1fd8fb4> a crm:PC3_has_note ;
    crm:P01_has_domain <303bf40e-5603-4bc6-8959-1e7b58d1aaf4> ;
    crm:P03_has_range_literal "Mosnier ou Munier. Peintre académicien (Meyer 2017, p. 360)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c28b83d5-00d5-4a01-8a1b-4af487c95c38> a crm:PC3_has_note ;
    crm:P01_has_domain <c8361b3f-207c-45d1-8891-25dd6d40a269> ;
    crm:P03_has_range_literal "Louvois (François-Michel Le Tellier, marquis de) (1641-1691), secrétaire d'État de la Guerre (1677), surintendant des Bâtiments du roi (1683)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c2bc8458-3290-4ba8-a669-374c50681b83> a crm:PC3_has_note ;
    crm:P01_has_domain <2982f6b4-0f40-43e3-a0a9-3154ff757aae> ;
    crm:P03_has_range_literal "Joseph Fabre était banquier et armateur marseillais, mais aussi trésorier de la Marine, ambassadeur de France au Levant, agent du comté de Savoie, délégué de la ville au Conseil du commerce du roi (cf. Faïence et Porcelaine de Marseille, XVIIe-XVIIIe siècles - Collections du Musée de la Faïence de Marseille, RMN, 1997, p. 15). Il est également l'un des fondateurs de la Compagnie de la Méditerranée en 1685." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c2cf25dc-77d0-4778-86a6-50c7eafac835> a crm:PC3_has_note ;
    crm:P01_has_domain <c0e32ca4-6d3e-476c-b594-0ff9036a8e33> ;
    crm:P03_has_range_literal "Premier aumônier du défunt duc de Mecklembourg (cf. [1693-02a_096](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-02a_096))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c2e8e0b3-c5dc-4488-b388-c14df08fe62b> a crm:PC3_has_note ;
