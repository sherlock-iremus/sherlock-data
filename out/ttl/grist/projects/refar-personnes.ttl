<756bf2b9-4298-4372-9912-3cf39d4e11a0> a crm:PC3_has_note ;
    crm:P01_has_domain <d16962e1-fd20-41fe-949e-59ab8740b5a0> ;
    crm:P03_has_range_literal "L'abbé de Vaillac a célébré la bénédiction nuptiale du mariage du comte et de la comtesse de Vauguyon au château de Chalus en 1704 (cf. [1704-01_13](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-01_13))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<758de3ac-12dc-4b16-9a51-ce6b21293f02> a crm:PC3_has_note ;
    crm:P01_has_domain <77061939-4c61-44d3-a7ef-5a6546ab9f71> ;
