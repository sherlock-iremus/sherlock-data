<ff571e8a-d5ca-4046-bb4a-6bf0681a35cd> a crm:PC3_has_note ;
    crm:P01_has_domain <03df6525-dd30-468f-b9c2-ef589724e28f> ;
    crm:P03_has_range_literal "Dillon (Thérèse-Lucy de Rothe, comtesse de) (1751-1782), dame du palais (1780-1782)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ff62c271-6d4c-4cb8-9272-5e90e57ce942> a crm:PC3_has_note ;
    crm:P01_has_domain <e7992cc0-cb6d-46af-bcc4-b2966ec97805> ;
    crm:P03_has_range_literal "Domenico Doria prit part aux manifestations organisées par la République de Gênes pour la réception de Philippe V d'Espagne en novembre 1702 (cf. MG-1702-12\\_191)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ff669dae-f6c1-4fe2-8233-5242d76463f5> a crm:PC3_has_note ;
    crm:P01_has_domain <06dcf0a1-acec-4256-82e8-80ba9ed281cd> ;
    crm:P03_has_range_literal "M. Normandeau l'aîné, \"cy-devant Page de la Chapelle du Roy\" (cf. [1699-09_205](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1699-09_205)), ne doit pas être confondu avec M. Normandeau, auteur de deux airs parus dans le *Mercure galant* en 1689 et 1691 (cf. MG-1689-06a\\_114 et MG-1691-09\\_311a). Ce dernier était peut-être le père de l'ancien page." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ffa8fd8a-dd4f-4cd0-8f2e-f5537fe88eb8> a crm:PC3_has_note ;
    crm:P01_has_domain <0d3dc7d8-2787-4344-89ef-2e071c46171a> ;
    crm:P03_has_range_literal "Maître de musique de la Sainte-Chapelle de Paris (cf. MG-1687-02\\_293)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ffc75da6-c589-47e7-b746-dd22cbd069e6> a crm:PC3_has_note ;
    crm:P01_has_domain <dbea4436-bdeb-49ea-a8a1-b3c26b3e20a2> ;
    crm:P03_has_range_literal "Sève (Guillaume de) (1638-1696), intendant de Montauban (1669), de Bordeaux et de Béarn (1673-1678), premier président au parlement de Metz (1681), intendant des Trois-Évêchés (1691)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ffed9c80-f898-4a66-873c-0c93398704f6> a crm:PC3_has_note ;
    crm:P01_has_domain <478dfd4b-eed5-477d-b26c-8020299eab43> ;
    crm:P03_has_range_literal "Pour la biographie de Sismund von Erlach, voir le Dictionnaire historique de la Suisse (<https://hls-dhs-dss.ch/fr/articles/023645/2005-11-15/>)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fff24d15-db52-4c91-8e9c-678319799b89> a crm:PC3_has_note ;
    crm:P01_has_domain <0e2b80f5-9451-40ae-97af-eb28d87728f6> ;
    crm:P03_has_range_literal "Maire perpétuel de Béziers (1698-1709)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<fff726e2-303f-453e-aa8f-ca427054c5a7> a crm:PC3_has_note ;
    crm:P01_has_domain <bcb07a0d-c20d-4ce8-a2b0-15e60393a2b8> ;
    crm:P03_has_range_literal "Surintendante de la Maison de la reine (1660-1661)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

