<9ed14f8b-5b46-4dd3-bc12-f24112c1988a> a crm:PC3_has_note ;
    crm:P01_has_domain <09d70613-40f9-44b4-8f59-457ffb9d5442> ;
    crm:P03_has_range_literal "Gaston-Jean-Baptiste Terrat, marquis de Chantosme, était chancelier et garde des sceaux du duc d'Orléans ainsi que grand trésorier des ordres du Roi (cf. « Grands trésoriers de l'ordre du roi »,Annuaire-bulletin de la Société de l'histoire de France, vol. 1, n°2, 1863, pp. 127-130 (généré le 25 avril 2021), disponible sur internet: <http://www.jstor.org/stable/23401509> ; voir aussi les « Minutes et répertoires du notaire Claude II Le Vasseur, 2 avril 1661 - 26 janvier 1700 (étude XCVIII) », documents conservés aux Archives nationales et qui comprennent le contrat de mariage entre Jean-Baptiste Terrat et Marie-Juste-Henriette de Ginestoux de la Tourette: cote MC/ET/XCVIII/339,[https://www.siv.archives-nationales.culture.gouv.fr/siv/rechercheconsultation/consultation/ir/pdfIR.action?irId=FRAN\\_IR\\_043034](https://www.siv.archives-nationales.culture.gouv.fr/siv/IR/FRAN_IR_043034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9ee6d848-9930-43a1-93b7-3bee5d368462> a crm:PC3_has_note ;
    crm:P01_has_domain <8a86cf80-c40d-440b-b088-8b371fd3b64a> ;
    crm:P03_has_range_literal "Aydie (François-Odet d') (v. 1702-1794), aumônier du roi (1736-1745)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9eeae5db-df04-4aa5-9f7e-313a9c89153e> a crm:PC3_has_note ;
    crm:P01_has_domain <3de21d33-119d-42a5-a532-de25bc862e38> ;
    crm:P03_has_range_literal "Chanoine et sacristain de la cathédrale d'Arles (cf. [1687-03a_056](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03a_056)) ; frère de Henri de Boche, grand sénéchal d'Arles." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9f271cdd-91f0-464b-88c6-0c25adb5fa8a> a crm:PC3_has_note ;
    crm:P01_has_domain <a69b6b55-3bb8-4338-8341-bc65d995119c> ;
    crm:P03_has_range_literal "Pierre-Cardin Lebret fut successivement intendant de la généralité de Limoges (1681-1683), intendant de la généralité de Grenoble (1683-1686), intendant de la généralité de Lyon (1686-1687), intendant de Provence (1687-1704) et premier président du Parlement de Provence (1691-1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9f3ba36f-1138-4095-a526-b8f4ad5de2d7> a crm:PC3_has_note ;
    crm:P01_has_domain <1db05e93-d513-40fa-ac49-ef52adc5d672> ;
    crm:P03_has_range_literal "Capitaine aux gardes, à Versailles (cf. [1682-06_010](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-06_010))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9f4eb4b2-6f72-4c83-800e-6956dd3fdd85> a crm:PC3_has_note ;
    crm:P01_has_domain <77971234-af23-4825-85e3-93bd75df6183> ;
    crm:P03_has_range_literal "Hérault d'armes au titre de Roussillon (cf. [1684-10_007](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-10_007))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<9f607c7b-2c3a-4726-9ac3-5116383c62d9> a crm:PC3_has_note ;
