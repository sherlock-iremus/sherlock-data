<bef32366-e59c-4b0b-9430-83abd8e981ed> a crm:PC3_has_note ;
    crm:P01_has_domain <57281046-da03-4987-998e-6ec4a8a5589c> ;
    crm:P03_has_range_literal "M. de Rochebrune est l'auteur des paroles d'un air publié dans le *Mercure Galant* en janvier 1717 (cf. MG-1717-01\\_218). Peut-être s'agit-il de Claude Guérin de Rochebrune (1660-1719), polygraphe et parolier dont Voltaire disait être le fils illégitime (Pearson, *Voltaire almighty* ..., 2005, p. 9)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

