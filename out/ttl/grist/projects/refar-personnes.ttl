    crm:P03_has_range_literal "Chaulnes (Marie-Paule-Angélique d'Albert de Luynes, duchesse de) (1744-1781), dame du palais de la reine (1766-1768 ; 1774-1781), dame pour accompagner la dauphine (1770-1774)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

