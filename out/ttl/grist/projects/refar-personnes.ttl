<8fbda08b-a7b5-4c9f-a275-667930d0f46e> a crm:PC3_has_note ;
    crm:P01_has_domain <249daaa4-d418-44cf-8c86-c0d19bc1d7e0> ;
    crm:P03_has_range_literal "En 1675, Marguerite de Quibly succéda sa tante homonyme en tant qu’abbesse à l’abbaye de la Déserte à Lyon (cf. https://gallica.bnf.fr/ark:/12148/bpt6k5819645n/f138.item.r=%22marguerite%20de%20quibly%22, consulté le 23 avril 2021). En 1732, elle fut succédée par Antoinette de Châtillon, cependant, le Mercure galant signale en 1710 que “Me de Châtillon” était abbesse de la Déserte, formulant ainsi une erreur dans l’identification de cette personne." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

