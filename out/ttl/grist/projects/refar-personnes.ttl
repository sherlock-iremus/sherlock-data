    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b8bb6bbe-8b3c-42ba-b98f-0b19d2024d8e> a crm:PC3_has_note ;
    crm:P01_has_domain <8277e2db-5e1c-4388-a337-a47d33a592d4> ;
    crm:P03_has_range_literal "Compositeur de la cantate \"L'Apologie des femmes\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8de8344-7696-4c33-aa30-750aec772812> a crm:PC3_has_note ;
    crm:P01_has_domain <a9cd6e64-dc13-4b3c-978a-198245d34443> ;
    crm:P03_has_range_literal "Pseudonyme d'un habitant du Havre dont une explication en vers d'une énigme de décembre 1683 est parue dans le Mercure galant (cf. [1684-03e_084](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-03e_084))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8deb932-2a8e-4564-9049-b97731a4d1ef> a crm:PC3_has_note ;
    crm:P01_has_domain <0c12ce1c-541d-413c-9030-a7d2b08e50fa> ;
    crm:P03_has_range_literal "Le Mercure galant de juillet 1704, consacré aux réjouissances pour la naissance du duc de Bretagne, mentionne M. Lhuillier, alors Grand-Maître du collège du Cardinal Lemoine (cf. [1704-07b_130](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_130)). Les mémoires de la Société de l'histoire de Paris et de l'Ile-de-France publié en 1876 indiquent que Claude Leullier occupa ce poste de 1694 à sa mort en 1733 (https://gallica.bnf.fr/ark:/12148/bpt6k63057479). Dans leur article, Marie-Madeleine Compère et Boris Noguès lui attribuent la fonction de principal du collège du Cardinal Lemoine aux mêmes dates mais situent sa mort en 1732 («  La direction d'établissement dans les collèges de l'université de Paris sous l'Ancien Régime  », dans Histoire de l'éducation, 2001 ; https://journals.openedition.org/histoire-education/829)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8e7d4c6-cc73-4dec-a60f-9432cab3a783> a crm:PC3_has_note ;
    crm:P01_has_domain <3d0aeef8-b1c9-4c77-9c1a-7192e843667a> ;
    crm:P03_has_range_literal "Voir [Geoffrey Turnovsky](https://www.cairn.info/publications-de-Geoffrey-Turnovsky--653952.htm), \"**Les lecteurs du *Mercure galant*. Trois aperçus\", *[Auctorialité, voix et publics dans Le Mercure Galant,](https://www.cairn.info/revue-dix-septieme-siecle.htm)* [éd. A. Piéjus, D. Blocker,](https://www.cairn.info/revue-dix-septieme-siecle.htm) *[Dix-septième siècle](https://www.cairn.info/revue-dix-septieme-siecle.htm)* [270 (2016/1](https://www.cairn.info/revue-dix-septieme-siecle-2016-1.htm)), p. 65-80 ;**https://www.cairn.info/revue-dix-septieme-siecle-2016-1-page-65.htm." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b90e72ec-1bea-47cd-85e0-66db019d15e4> a crm:PC3_has_note ;
    crm:P01_has_domain <2dd59f8b-15ed-4805-9626-4309f0a8b4f8> ;
    crm:P03_has_range_literal "Mlle de Poisson a participé à un bal chez M. de Saint-Philibert à Château-Gontier pour célébrer la naissance du duc de Bretagne (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b9278ba5-4faa-4964-9c60-4eed9f58f55a> a crm:PC3_has_note ;
    crm:P01_has_domain <7fc919f5-d9ba-4ebf-8393-79c24fc70ab7> ;
    crm:P03_has_range_literal "Maître de musique, compositeur et copiste de musique, actif à Paris." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b9671b4f-fedc-4402-9ed8-9723cd664870> a crm:PC3_has_note ;
    crm:P01_has_domain <d802881f-4a94-440e-ab15-b03b3aea6313> ;
    crm:P03_has_range_literal "Mlle Vailly est l'autrice d'un air paru dans le *Mercure galant* de mai 1688 (cf. [1688-05a_203](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1688-05a_203))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b97b7ba8-41b4-474c-838f-25c873268cad> a crm:PC3_has_note ;
    crm:P01_has_domain <3e1f9909-5e33-43df-84d3-c021cd0d13ea> ;
    crm:P03_has_range_literal "M. Bernard (fl. 1697) était receveur général de la commanderie de Launay (cf. [1697-09_257](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1697-09_257))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b9bb3389-8618-484f-92c0-c40f5979759c> a crm:PC3_has_note ;
    crm:P01_has_domain <0f29e8f3-7658-419b-aafb-33aa33ee7f11> ;
    crm:P03_has_range_literal "Commissaire général de la Marine à Toulon (1666), à Marseille (1670), au Havre (1671), Intandant général des Galères à Marseille (1675-79, 1680-1684), intendant général des Galères de Toulon (1679), maître ordinaire de la Chambre des Comptes (1688)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b9d32ca3-7b64-4953-aa45-169e93b6cb3a> a crm:PC3_has_note ;
    crm:P01_has_domain <235f9521-fff6-450c-87df-e0a2f5633e6e> ;
    crm:P03_has_range_literal "Ambres (François de Gélas, marquis d') (1640-1721), colonel du régiment de Champagne (1657-…)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ba29430c-f922-4f08-b59c-91c32674a944> a crm:PC3_has_note ;
    crm:P01_has_domain <08b53337-36d0-40d3-8234-ad155c9c7f79> ;
    crm:P03_has_range_literal "Jean de Quinson a étélieutenant des armées du roi, ainsi que commandant de la province de Roussillon, Conflant et Cerdagne (cf. <http://www.archives-communales-ain.fr/index.php/quinson-jean-de-16-1713-chevalier>, consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ba425158-fbbc-489c-a9b9-f5cd329ae343> a crm:PC3_has_note ;
    crm:P01_has_domain <ca8ab7a2-829d-42b1-b2b7-4e3cc919c36d> ;
    crm:P03_has_range_literal "Compositeur de la cantatille \"L'Amour couronné\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ba5be300-9a44-4e85-b90a-191d28390158> a crm:PC3_has_note ;
