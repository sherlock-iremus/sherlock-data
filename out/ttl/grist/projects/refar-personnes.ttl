    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c6100cd6-79a7-4a4b-ab69-f9c4240bbb51> a crm:PC3_has_note ;
    crm:P01_has_domain <52b29b19-328f-4b16-a715-c1f0f63830b6> ;
    crm:P03_has_range_literal "Anne-Marie des Fontaines (fl. 1685-1724) était chanteuse de la Chambre du roi. Sa fille, Marguerite-Dorothée Le Peintre, lui succéda dans sa charge en 1724." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c636fcef-31fc-414a-851e-888c569c3496> a crm:PC3_has_note ;
    crm:P01_has_domain <31c036c1-ee45-4cff-a943-d89f153f790d> ;
    crm:P03_has_range_literal "Président aux enquêtes du Parlement de Toulouse et mainteneur des Jeux Floraux (1694.05)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c647e49d-467c-45ee-b040-56cb73d93a1e> a crm:PC3_has_note ;
    crm:P01_has_domain <f1e4e7db-6342-4d27-909d-74ce092c90ed> ;
    crm:P03_has_range_literal "Jean-Baptiste Sabatini était peintre de la ville de Nevers. Il travaille parallèlement pour divers châteaux, églises ou hôtels particuliers des environs (église de Parigny-les-Vaux, 1689). Il semble s’être installé définitivement à Nevers, puis à Bourges (cf. https://www.academie-sabl-dijon.org/celebration/deces-de-jean-baptiste-battista-sabatini-peintre/, consulté le 15 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c64b8d97-956a-4221-8899-4c6b4efb3d1d> a crm:PC3_has_note ;
    crm:P01_has_domain <b455bac2-6481-4cc7-b3db-c60bdc98fc36> ;
    crm:P03_has_range_literal "Commandant des brigades à La Patache (cf. MG-1687-03b_311)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c6530430-47c0-4ddb-972d-33ee40d2e3ba> a crm:PC3_has_note ;
    crm:P01_has_domain <fd76b1ee-98b0-4460-ba99-822d9556313b> ;
    crm:P03_has_range_literal "M. Maugard, de Troyes, est l'auteur d'une paraphrase du psaume Exaudiat publiée dans le Mercure galant d'août 1702 (cf. [1702-08_176](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-08_176)). Si l'on se fie au texte de l'épître en vers à Louis Nivelle publiée dans le périodique en février 1702, c'est le même M. Maugard qui en est l'auteur (MG-1702-02a\\_146)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c660efb4-964a-4a2e-bdfc-3e0f03004fe3> a crm:PC3_has_note ;
    crm:P01_has_domain <165f1761-b249-4f3a-8722-3f720007f9fd> ;
    crm:P03_has_range_literal "Commissaire général dans les troupes de l'Électeur de Bavière (cf. [1684-11_034](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-11_034))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<c68fd0c3-05be-48b4-82d5-81c0dd349a69> a crm:PC3_has_note ;
    crm:P01_has_domain <d58ee2ff-13f9-4f4c-ab01-fb19b0364703> ;
    crm:P03_has_range_literal "Turola (Dominique-Léonard) (1643-1701), garde-meuble du château de Versailles (…1693), garde général du Garde-Meuble de la Couronne (1693-1701)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<c695d94a-e076-428d-8841-accbe12e991d> a crm:PC3_has_note ;
