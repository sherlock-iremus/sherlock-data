<dde9f1e7-386d-44a2-bc0b-43de1276eec3> a crm:PC3_has_note ;
    crm:P01_has_domain <89b151b2-a672-4dee-abd6-8d258a1876b9> ;
    crm:P03_has_range_literal "Chef des émirs de Syrie (1cf. MG-1680-07\\_185)." ;
