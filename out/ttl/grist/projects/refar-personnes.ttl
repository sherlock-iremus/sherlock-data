    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7ad3f547-b603-42be-bbd2-1d7b3a2e04e8> a crm:PC3_has_note ;
    crm:P01_has_domain <1aa62d20-ef1f-4f29-99e5-06d6a0473e96> ;
    crm:P03_has_range_literal "Bernard Picart était miniaturiste, dessinateur et graveur." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7ae3ad37-8c91-47e4-a048-35f207c841d9> a crm:PC3_has_note ;
    crm:P01_has_domain <5e331843-f754-4d55-8fd0-407f21d93cfe> ;
