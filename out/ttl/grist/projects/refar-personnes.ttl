    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ec54f750-88a3-42d5-af20-2418fc8341f0> a crm:PC3_has_note ;
    crm:P01_has_domain <6032c7b8-5882-44a4-9f14-1696e49eebd2> ;
    crm:P03_has_range_literal "Esgrigny (René Jouenne d') (?-1732), huissier de la Chambre du roi, capitaine au régiment de la Couronne, commissaire des guerres, intendant de l'armée d'Irlande (1689…), puis de Catalogne et d'Italie, intendant de Catalogne" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ec67ee5c-cf69-409c-85f9-d713102683f5> a crm:PC3_has_note ;
    crm:P01_has_domain <c92f5e49-d8b0-4b34-bdf7-d0a3b0cb96dc> ;
    crm:P03_has_range_literal "D'après le *Mercure galant*, M. Normandeau était organiste du Collège de Navarre. Il est l'auteur de deux airs parus dans le périodique en 1689 et 1691 (cf. [1689-06a_114](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-06a_114), [1691-09_311a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-09_311a)). Il ne doit pas être confondu avec M. Normandeau l'aîné, dont le *Mercure galant* affirme en 1699 qu'il était \"cy-devant Page de la Chapelle du Roy\" (cf. MG-1699-09\\_205) qui pourrait être son fils." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ec6ae4d1-ea0c-4dfa-a1d3-ee8d7de99c50> a crm:PC3_has_note ;
    crm:P01_has_domain <249932ae-3c6a-4037-b5bf-943e9700f25f> ;
    crm:P03_has_range_literal "Prieur de Fontenay-en-Brie (cf. MG-1687-03b\\_109b)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<ec75038b-211a-4677-80dd-2e5003afaaf6> a crm:PC3_has_note ;
    crm:P01_has_domain <529b29e4-f8f8-4695-9c4b-7c033d6d2b59> ;
