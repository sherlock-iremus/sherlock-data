<1abddcc5-b0bc-4fde-b71b-935c26741172> a crm:PC3_has_note ;
    crm:P01_has_domain <39af5121-1464-494b-8295-56818e943976> ;
    crm:P03_has_range_literal "Albrecht Konrad Finck von Finckenstein (1660-1735) fut “maréchal et homme de cour prussien, familier du roi-sergent. Il fut le précepteur de Frédéric II” (cf. https://fr.wikipedia.org/wiki/Albrecht\\_Konrad\\_Finck\\_von\\_Finckenstein, consulté le 29 mars)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1ac7a4b8-b332-4fb0-809e-c7ca8336ad85> a crm:PC3_has_note ;
    crm:P01_has_domain <1270d20c-f64a-4759-b00d-1422c1c1dfac> ;
    crm:P03_has_range_literal "M. de Maugé est l'auteur des paroles d'un air publié dans le *Mercure Galant*  de juin 1707 (cf. MG-1707-06\\_142)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1ade06ed-6b54-478b-8349-9db07facea3e> a crm:PC3_has_note ;
