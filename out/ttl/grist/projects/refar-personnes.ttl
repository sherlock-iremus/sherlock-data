<754cd1fe-2a23-44ae-bc91-497c7ea39f37> a crm:PC3_has_note ;
    crm:P01_has_domain <44aff363-62da-44f6-bc6d-d77bbcfe15c2> ;
    crm:P03_has_range_literal "Le chevalier de Théron, capitaine dans le régiment de Lanoy, est l'auteur d'une Ode sur la fortune parue dans le Mercure galant. D'après le périodique, il est le neveu du père Vital Théron (MG-1703-01\\_112)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<75560bdb-73c1-41bc-9b72-5be879517cf3> a crm:PC3_has_note ;
    crm:P01_has_domain <19940af4-2e24-4e81-a328-0dbaabd02dfa> ;
    crm:P03_has_range_literal "Grégoire de la Forge (fl. 1693-1706) a été Général de l'ordre de la Trinité entre novembre 1692 jusqu'à sa mort en août 1706 (cf. Moreri, Louis. Le Grand dictionnaire historique ou le Mélange curieux de l'histoire sacrée et profane, Tome 10. Paris, chez les Libraires Associés, 1759, p. 344)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<755acd4a-31c2-434d-af57-78f9386d81f4> a crm:PC3_has_note ;
    crm:P01_has_domain <cf446574-df0d-49cf-8a6d-6d59b1de40a7> ;
    crm:P03_has_range_literal "Avocat et premier échevin de Mâcon (cf. MG-1679-09\\_072)." ;
