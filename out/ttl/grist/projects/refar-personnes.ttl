<a37d8956-190b-4b12-b834-2dfc851367d1> a crm:PC3_has_note ;
    crm:P01_has_domain <31961efd-0bf3-4f85-afe2-4f09e034054d> ;
    crm:P03_has_range_literal "Jean de la Brière de Louvancy a été proviseur du collège d’Harcourt de 1701 jusqu'à sa mort en 1713 (cf. https://www.persee.fr/doc/inrp\\_0000-0000\\_2002\\_ant\\_10\\_3\\_8019, consulté le 2 juin 2021)." ;
