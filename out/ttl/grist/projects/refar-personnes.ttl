<609b84bb-bed0-44b4-a497-df28f75da979> a crm:PC3_has_note ;
    crm:P01_has_domain <cbf514a1-c9ba-4122-acaf-e1228cc15960> ;
    crm:P03_has_range_literal "Mohammad Temim Attitouani était ambassadeur du Maroc en France. Une gravure parue dans le Mercure galant d’après un tableau d’Antoine Coypel le représente ainsi que sa suite (cf. <http://collections.chateauversailles.fr/#a3e059fe-c0a9-4da1-932a-e36fdae2fa17>)." ;
