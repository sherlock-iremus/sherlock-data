    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<474464fe-4b7f-468c-8237-be97c160171e> a crm:PC3_has_note ;
    crm:P01_has_domain <b1a125e3-78d3-459a-9e01-9390c6757834> ;
    crm:P03_has_range_literal "Konstantyn Jázef Zieliński est mentionné dans le Mercure galant en tant qu' «  'Archevêque de Leopol  » (cf. [1705-12_16](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1705-12_16)), nom francisé de la ville de Lviv." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

