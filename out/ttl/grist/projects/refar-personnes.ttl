    crm:P03_has_range_literal "Raffeneau-Delile (Élie) (v. 1657 - 1732), sommier d'échansonnerie-bouche de la dauphine (…1682-1684…), porte-arquebuse du duc de Berry (1693-1708…), chef de paneterie-bouche du roi (…1698-1727…), maître d'hôtel de Mme de Maintenon (1699…), contrôleur général de la Bouche du duc de Berry (…1712…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<37608f40-df84-496a-bc8d-14ac7df1cd4b> a crm:PC3_has_note ;
