    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<55dec4b5-02a2-4d1b-b8d4-aaa68bbab8e9> a crm:PC3_has_note ;
    crm:P01_has_domain <26341fc9-a02f-4d27-8e16-7d722a664bce> ;
