    crm:P03_has_range_literal "M. du Mesnil-Marchand (ou M. Mesnil-Marchand) composa la musique de trois airs publiés dans le Mercure galant (cf. MG-1701-09\\_165, MG-1701-09\\_402 et MG-1701-12\\_293)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

