    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b143666-6d26-4fb6-86dd-ba2304c9114f> a crm:PC3_has_note ;
    crm:P01_has_domain <71c83983-4108-4ef1-8112-477759c67119> ;
    crm:P03_has_range_literal "Bouzols (Laure Fitz-James, marquise de) (1713-1766), dame du palais de Marie Leszczyńska (1737-1762)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<7b252bfe-34d6-486f-85f1-0d97cc890908> a crm:PC3_has_note ;
    crm:P01_has_domain <62faf773-8a21-472b-933e-a78e5ae7d84d> ;
    crm:P03_has_range_literal "Marie-Angélique de La Porte de Villoiseau (dite Madame la Presidente de la Gravelle), était l'épouse du Premier Président au Présidial de Château-Gonthier, René d'Héliand, seigneur de la Gravelle (1657-1724)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b26a544-2c10-4478-9578-45b282e5730a> a crm:PC3_has_note ;
    crm:P01_has_domain <e2dbb2a6-12b1-465c-b0a0-471c82625b20> ;
    crm:P03_has_range_literal "Sculpteur et médailleur français." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b28ec9e-7630-4007-8ff9-2c3a36ff5f72> a crm:PC3_has_note ;
    crm:P01_has_domain <0a898bea-908c-4003-8416-35166e88a947> ;
    crm:P03_has_range_literal "Ardier (Paul) (1543-1638), trésorier de l'épargne (1627)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b55aa00-96f3-4b19-afcf-5d586a291bc3> a crm:PC3_has_note ;
    crm:P01_has_domain <27bfb124-c3ca-4d54-b2ee-07c492334ffb> ;
    crm:P03_has_range_literal "Jacques Jollain (1654-1724) était curé de Saint-Hilaire à Paris à partir de 1685 (cf. de Dainville-Barbiche, Ségolène. « Prosopographie des curés de Paris (1695-1789) », , Devenir curé à Paris. Institutions et carrières ecclésiastiques (1695-1789), sous la direction de de Dainville-Barbiche Ségolène. Presses Universitaires de France, 2005, p. 475)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b56fb8d-6fec-4ba9-9456-92b8273c8886> a crm:PC3_has_note ;
    crm:P01_has_domain <bfb7f2cf-e350-4d7c-b362-a2da1458fe56> ;
    crm:P03_has_range_literal "Premier aumônier de Philippe I d'Orléans (cf. [1679-05_290](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-05_290))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<7b64c45e-4f10-43ad-b7fe-24d49c1d2736> a crm:PC3_has_note ;
    crm:P01_has_domain <9257b7a5-3be8-4f13-9446-c99ab445873a> ;
