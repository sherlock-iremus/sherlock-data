    crm:P03_has_range_literal "Subdélégué de l'Intendant et Maître des Eaux et Forêts à Compiègne (cf. MG-1687-03b\\_107)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

