<de09da79-e32d-4e60-b5cc-e5fae656e458> a crm:PC3_has_note ;
    crm:P01_has_domain <7b79acb7-6b8d-490b-9771-492b1fc59e23> ;
    crm:P03_has_range_literal "Enseigne des gardes du palais de Hanovre (cf. MG-1681-08_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<de1707c9-cff0-461e-a58a-ca819fdbbd13> a crm:PC3_has_note ;
    crm:P01_has_domain <ad84f707-5073-4e84-8ae3-4bf4164531cc> ;
    crm:P03_has_range_literal "Après avoir été secrétaire à l'ambassade de France à Constantinople (1703), Pierre-Victor Michel fut envoyé extraordinaire de Louis XIV en Perse entre 1706 et 1708 (cf. Susan Mokhberi, The Persian Mirror : Reflections of th Safarid Empire in Early Modern France, Oxford Scholarship Online: November 2019, ISBN-13: 9780190884796 ; DOI:10.1093/oso/9780190884796.003.0004 ; consulté le 23 avril 2021). À son retour en France, il écrivit “Mémoire du Sieur Michel sur le voyage qu’il a fait en Perse dans les années 1706, 1707, 1708 et 1709” (cf. https://gallica.bnf.fr/ark:/12148/btv1b10720916q/f5.item, consulté le 20 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

