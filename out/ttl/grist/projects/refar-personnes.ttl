    crm:P01_has_domain <4fbd8875-3148-47c3-98af-3d03eb7ad764> ;
    crm:P03_has_range_literal "Jaubert (Paul) (1722-?), inspecteur des Bâtiments du roi au département de Choisy et inspecteur-garde magasin à Versailles" ;
