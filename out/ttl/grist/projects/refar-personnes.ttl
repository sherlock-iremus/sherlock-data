<a2b9e032-c24a-4ac1-adc2-4663a18a3701> a crm:PC3_has_note ;
    crm:P01_has_domain <2967fbca-0881-4be2-b151-65790007d29f> ;
    crm:P03_has_range_literal "Nicolas de Malézieu (1650-1727) était chancelier de Dombes, précepteur du duc de Maine, secrétaire général des Suisses et Grisons de France, membre de l'Académie des sciences (élu en 1699) et de l'Académie française (élu en 1701)." ;
