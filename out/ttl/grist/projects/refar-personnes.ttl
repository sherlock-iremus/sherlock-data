<92d143be-93ac-4163-9c71-3a12c7ad09cd> a crm:PC3_has_note ;
    crm:P01_has_domain <f379276f-4bf5-483c-b1c1-a58c3c723391> ;
    crm:P03_has_range_literal "M. Charles, \"disciple de M. Brossant\" (cf. [1706-04_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1706-04_375)), est l'auteur de la musique d'airs parus dans le Mercure galant entre 1706 et 1710. Peut-être convient-il de lire \"Brossard\" et non \"Brossant\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<92d80ed3-7b16-46e3-b5ae-8ae1369f7a28> a crm:PC3_has_note ;
    crm:P01_has_domain <43020552-caa2-49c4-bf32-5307ac869ed4> ;
    crm:P03_has_range_literal "Demoiselle parisienne, qui épouse en 1679 Charles-François Monthelon (1651 ca-1703) (cf. [1679-10a_171](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-10a_171))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<92e8946a-5c9b-4a98-803e-37c94d483a8e> a crm:PC3_has_note ;
