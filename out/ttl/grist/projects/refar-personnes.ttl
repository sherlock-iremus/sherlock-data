    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b87cd802-6177-493a-9c9c-bb85f67eda87> a crm:PC3_has_note ;
    crm:P01_has_domain <27c54a4d-2010-406d-ade9-8688b2577943> ;
    crm:P03_has_range_literal "Deodini (Francesco) (?-?), stucateur (…1642…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b88f40e1-e596-4d8d-8929-9e3b16c65a06> a crm:PC3_has_note ;
    crm:P01_has_domain <57f4258d-59c4-453e-ad57-141432caca38> ;
    crm:P03_has_range_literal "D'après le Mercure galant, Bernard d'Aspe était conseiller au Parlement et maire de Toulouse (cf. [1697-09_234](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1697-09_234)) puis président à mortier au Parlement de Toulouse (cf. MG-1702-02\\_284)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b8915db8-e5a9-4581-bcb8-82c038b43d1a> a crm:PC3_has_note ;
    crm:P01_has_domain <bd38a8d4-dfcc-404c-862f-a239170f10e6> ;
    crm:P03_has_range_literal "échevin de Luzy (cf. [1698-02_026](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-02_026))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<b89aed63-b520-4978-9c3e-ef12b373008d> a crm:PC3_has_note ;
    crm:P01_has_domain <97ae770e-5aaa-4b90-a8e9-7ae95caa19c3> ;
    crm:P03_has_range_literal "Poisson (Louis) (?-1613), peintre du roi (…1596-1613)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<b8a21766-f248-4c81-802f-449f31ac4cce> a crm:PC3_has_note ;
    crm:P01_has_domain <e7fb9797-161c-41fe-b4fe-95b677458fff> ;
    crm:P03_has_range_literal "Sous-prieur des Pénitents bleus de Toulouse et conseiller au parlement de Toulouse (cf. MG-1692-03\\_144)." ;
