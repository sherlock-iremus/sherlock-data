<a13cf7d9-1744-455a-8ac5-21e3f042dcd3> a crm:PC3_has_note ;
    crm:P01_has_domain <1ed9554b-3c21-45b4-b52e-8afd3a34cd19> ;
    crm:P03_has_range_literal "M. du Mesnil-Marchand (ou M. Mesnil-Marchand) composa la musique de trois airs publiés dans le Mercure galant (cf. [1701-09_165](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-09_165), [1701-09_402](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-09_402), [1701-12_293](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1701-12_293))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a14aa1bd-1aa8-4ac4-ad06-91c16ac12843> a crm:PC3_has_note ;
    crm:P01_has_domain <a58ed6f2-7d86-4ef5-a277-0ee0e76aef68> ;
    crm:P03_has_range_literal "M. de la Fevrerie était un contributeur du *Mercure Galant* qui publia en février 1695 sa \"Réponse à la Satire contre les Vers irreguliers employée dans le Mercure du mois d'Avril 1694\" (cf. MG-1695\\_02\\_236) et écrivit les paroles d'un air publié dans le *Mercure Galant* de décembre 1708 (cf. MG-1708-12\\_267)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a14f1c44-6d9e-4623-a871-cc4e07621ab7> a crm:PC3_has_note ;
    crm:P01_has_domain <e1f3c3b6-780a-4a77-9246-6688f51063d2> ;
    crm:P03_has_range_literal "M. de Frontinière est l'auteur des paroles d'un air publié dans le *Mercure Galant* de septembre 1689 (cf. [1689-09_051](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-09_051))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<a153f4c8-1c7b-4cee-8a89-1a20651697cb> a crm:PC3_has_note ;
