    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<09021a63-5b35-4900-9065-bab439745f8e> a crm:PC3_has_note ;
    crm:P01_has_domain <825b9735-170e-47b4-b96d-f276a21e64af> ;
    crm:P03_has_range_literal "Compositeur et organiste. A composé la musique des célébrations du retour de la santé du roi à l'abbaye Notre-Dame-du-Trésor de Rouen (cf. MG-1687-02\\_155)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0906df62-7484-4df2-9135-cb1e18550017> a crm:PC3_has_note ;
    crm:P01_has_domain <31a432ef-d73b-4432-a30b-a2718bfb2c0e> ;
    crm:P03_has_range_literal "L'abbé Charlet est l'auteur d'odes latines dont une Sur la guerre présente publiée dans le Mercure galant d'août 1702 dans la traduction de l'abbé Mauguin (cf. MG-1702-08\\_211)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09115abc-0ff9-4ba7-ab00-6e00f4864ab7> a crm:PC3_has_note ;
    crm:P01_has_domain <ad07a209-6696-47ae-8a5b-a1e6a7b55b97> ;
    crm:P03_has_range_literal "Arnaud Laborie, prêtre, était membre de l'Académie des Jeux floraux de Toulouse où il a été Maître entre 1679 et 1702. Il fut lauréat en 1672 (pris de l'Églantine), 1676 (prix du Souci) et 1679 (prix de la Violette) (cf. François de Gélis, Histoire critique des jeux floraux depuis leur origine jusqu'à leur transformation en Académie (1323-1694), Toulouse, E. Privat, 1912, p. 157, 284, 316-318) ." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<093c7691-4dcc-44fa-a649-39f5247f126c> a crm:PC3_has_note ;
    crm:P01_has_domain <1150ce8c-2ca4-42bc-9dd2-790a5cf3350a> ;
    crm:P03_has_range_literal "Procurateur de Venise (cf. MG-1682-10a_172)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0984461d-b8a3-45e2-9b24-f2a6a5da32b4> a crm:PC3_has_note ;
    crm:P01_has_domain <3867ede3-92e5-4533-a0d3-66ab54c6f750> ;
    crm:P03_has_range_literal "Montoison (Alise-Tranquille de Clermont-Tonnerre, marquise de) (1724-1752), dame pour accompagner la duchesse douairière d'Orléans (1745-1749), dame du palais surnuméraire (1749-1752)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<099a773d-60e5-405c-9750-b05b2473cf55> a crm:PC3_has_note ;
    crm:P01_has_domain <0d9569d2-e924-45a6-a7d1-f65172c88db4> ;
    crm:P03_has_range_literal "Lieutenant de roi à Falaise (cf. [1682-11_254](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-11_254))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09ab4579-ace4-4b57-a927-133f0aa95813> a crm:PC3_has_note ;
    crm:P01_has_domain <417a7dff-5944-4732-bacc-54726e327022> ;
    crm:P03_has_range_literal "M. Marcel est l'auteur des paroles d'airs publiés dans le *Mercure Galant* entre juin 1690 et juin 1693 (cf. [1690-06_340](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1690-06_340), [1690-08_033](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1690-08_033), [1691-04_037](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1691-04_037), [1693-06_315](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-06_315)). Dans celui de janvier 1701, il publie également un madrigal (cf. MG-1701-01\\_009)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09bc720e-29d0-4c28-bdd7-449fedcc2f54> a crm:PC3_has_note ;
    crm:P01_has_domain <fd565c73-083e-40da-aefc-e23a82ee5bf8> ;
    crm:P03_has_range_literal "Aviler (Augustin-Charles d') (1653-1701), architecte de la province du Languedoc (1693-1701), théoricien" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09d3fef7-16b8-4dc6-99dd-994e9b51e0e4> a crm:PC3_has_note ;
    crm:P01_has_domain <8c56e423-e901-4019-9aae-d53159177730> ;
    crm:P03_has_range_literal "Jolly (Charles-François) (v. 1730-1781), jardinier du roi au parc de Choisy (…1781)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<09d48508-b6ec-4d2e-a6b3-9f7586f88153> a crm:PC3_has_note ;
    crm:P01_has_domain <6adc4b0f-68b5-4f4e-b31a-260fc2e6250e> ;
    crm:P03_has_range_literal "Le père le Clerc, jésuite, a composé une tragédie intitulée Philippes le Bon, Duc de Bourgogne , représentée par les pensionnaires du collège Louis-le-Grand en 1704." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09dcea3a-e59c-49e2-8302-560650b970d9> a crm:PC3_has_note ;
    crm:P01_has_domain <6d81e1f4-cf00-4e70-a4ae-87b4e02d9be5> ;
    crm:P03_has_range_literal "M. Guitrandi (ou Guitrandy) , d'Avignon, fut publié à plusieurs reprises dans le Mercure galant, notamment en octobre 1693 (cf. [1693-10a_055](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1693-10a_055)) et en avril 1702 (cf. MG-1702-04\\_79)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<09ed6374-ddee-48da-8909-e7c582b032f5> a crm:PC3_has_note ;
    crm:P01_has_domain <ab823529-21d7-4815-9497-5027102743f9> ;
    crm:P03_has_range_literal "Lieutenant de chastellenie à Mercurol (cf. MG-1687-06a\\_159)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<0a291c88-3c37-4b1f-90de-ddfef1b5293a> a crm:PC3_has_note ;
    crm:P01_has_domain <c84b738b-5876-4659-b478-0134ab07be28> ;
