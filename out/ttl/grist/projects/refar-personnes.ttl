    crm:P03_has_range_literal "Abbé, Grand vicaire et official du diocèse de Strasbourg (cf. [1688-01_197](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1688-01_197))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

