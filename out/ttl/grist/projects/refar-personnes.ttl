<dcd36977-4163-4b2c-be1e-2f8bec0cc0ae> a crm:PC3_has_note ;
    crm:P01_has_domain <4a7f9620-4d69-4992-a042-e6f2359df621> ;
    crm:P03_has_range_literal "Docteur en théologie, ancien curé de la Rocheguyon en 1692, prononce un panégyrique à Niort (cf. MG-1692-11\\_188)." ;
