<cf228343-8cc3-44b8-b14d-b0db4093c11f> a crm:PC3_has_note ;
    crm:P01_has_domain <26341fc9-a02f-4d27-8e16-7d722a664bce> ;
    crm:P03_has_range_literal "Docteur, régent de la faculté de droit de Paris (cf. MG-1685-09\\_256)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cf36a282-bf2f-4939-a79f-2f444ffb8331> a crm:PC3_has_note ;
    crm:P01_has_domain <91e3c3b6-57c5-4e79-bb38-fdcaa0bfa25a> ;
    crm:P03_has_range_literal "Tamiriste est le pseudonyme utilisé par un des correspondants du Mercure galant, actif entre 1681 et 1709." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<cf60cc32-0bd5-409c-a6d4-8b4f106d3985> a crm:PC3_has_note ;
    crm:P01_has_domain <328dc4fa-123f-4ca9-9a66-d1919f63d94d> ;
    crm:P03_has_range_literal "« Vicaire de l'abbaye de Saint-Martin des Champs, vicaire général de l'église de Paris. - Plusieurs fois lauréat du prix d'éloquence décerné par l'Académie française » (cf. https://data.bnf.fr/fr/16667186/hyacinthe\\_colin/, consulté le 26 février 2021)." ;
