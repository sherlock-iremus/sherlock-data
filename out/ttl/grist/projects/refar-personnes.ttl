    crm:P03_has_range_literal "Lieutenant-colonel d'infanterie à la cour de Hanovre (cf. MG-1681-08_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da4bce64-cd37-42fe-ae09-578e8824c45f> a crm:PC3_has_note ;
    crm:P01_has_domain <df0e42cf-f3e7-4e17-b3bb-5638e6257fc1> ;
    crm:P03_has_range_literal "Auteur des Dialogues satyriques et moraux, Lyon, Th. Almaury, 1687." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da628833-8629-42c0-bf62-6426fa675955> a crm:PC3_has_note ;
    crm:P01_has_domain <9fb07ee7-bfbf-453c-88ea-44be2c16bfa9> ;
    crm:P03_has_range_literal "Ancien chantre de l'église de Saint-Martin de Tours (1693.02)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<da63b2a6-7547-42b6-9339-f7ca728c9fd5> a crm:PC3_has_note ;
    crm:P01_has_domain <4ac707af-a51f-452b-a31b-0f8ceb2a5067> ;
    crm:P03_has_range_literal "Dame d'épinal, fille d'honneur de la duchesse de Lorraine (cf. [ 1699-03_151](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/ 1699-03_151))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da769390-f71a-48ef-bd07-7bfca5a125ef> a crm:PC3_has_note ;
    crm:P01_has_domain <02974d99-ba6f-445b-8c44-07466f296dfa> ;
    crm:P03_has_range_literal "Compositeur, notamment candidat au concours pour le poste de sous-maître de musique de la Chapelle Royale (cf. [1683-04_310](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1683-04_310))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da8334c1-1dd1-40ac-9541-fde013c42e18> a crm:PC3_has_note ;
    crm:P01_has_domain <73d7007e-526b-4c23-bd6b-57629512e93a> ;
    crm:P03_has_range_literal "Hérault d'armes au titre du régiment de Charolais (cf. [1678-09_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_375), [1684-10_007](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1684-10_007))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da859fb5-241c-4a41-acd3-1c2f144732be> a crm:PC3_has_note ;
    crm:P01_has_domain <df60b06a-81a5-47c0-8538-a5059bced29d> ;
    crm:P03_has_range_literal "Procureur du roi en la ville de Luzy (cf. MG-1698-02\\_026)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da8fac09-19db-45ba-9e5e-5de9de87ed3b> a crm:PC3_has_note ;
    crm:P01_has_domain <57281046-da03-4987-998e-6ec4a8a5589c> ;
    crm:P03_has_range_literal "M. de Rochebrune est l'auteur des paroles d'un air publié dans le *Mercure Galant* en janvier 1717 (cf. [1717-01_218](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1717-01_218)). Peut-être s'agit-il de Claude Guérin de Rochebrune (1660-1719), polygraphe et parolier dont Voltaire disait être le fils illégitime (Pearson, *Voltaire almighty* ..., 2005, p. 9)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<da960424-48a6-42b2-b7e0-d7630dceb415> a crm:PC3_has_note ;
    crm:P01_has_domain <5531b9f3-20a1-4ad5-8c39-458e32122698> ;
    crm:P03_has_range_literal "Commandeur du Grand Prieuré de France (cf. [1678-08_132](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-08_132))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dab66f7c-f53f-4d83-b86d-47c8d2f2f50b> a crm:PC3_has_note ;
    crm:P01_has_domain <7b8616a7-99ce-4845-a1dd-76b646d86cb3> ;
    crm:P03_has_range_literal "Lieutenant du roi à Nîmes (cf. MG-1689-10_077)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dafce198-70ad-496e-aab9-8205ec72902c> a crm:PC3_has_note ;
    crm:P01_has_domain <86788459-98b8-4428-b6c6-7560b43cc2e9> ;
    crm:P03_has_range_literal "D'après le Mercure galant, M. Daches, auteur d'une gavotte et d'un menuet parus dans le périodique, était «  de la musique du roi  » (cf. MG-1684-02\\_234). Il ne figure cependant pas dans les effectifs de la Musique du roi donnés pas les état de la France." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db3af78b-bd61-49f2-bebd-cc69c1c5d18d> a crm:PC3_has_note ;
    crm:P01_has_domain <3bc5df43-2f65-43cb-b173-c8e584c96185> ;
    crm:P03_has_range_literal "Jésuite à Zolkiew (cf. [1694-06_151](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1694-06_151))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db3ca1ce-ab62-48d5-86ca-efe8652b5610> a crm:PC3_has_note ;
    crm:P01_has_domain <43ec09af-da4b-43ed-8fef-99406fb51fd3> ;
    crm:P03_has_range_literal "Syndic général des marchands privilégiés selon la cour (cf. MG-1704-07b\\_198b)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db687c5a-6fe4-4d71-a872-2a11a39343f8> a crm:PC3_has_note ;
    crm:P01_has_domain <c2e62695-0df5-4d76-92d9-bec935d7a69d> ;
    crm:P03_has_range_literal "Antibes (Charles de Grimaldi d') (1705-1770), évêque de Rodez (1747-1770)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db75139e-0e23-429e-a8c9-b74093be639a> a crm:PC3_has_note ;
    crm:P01_has_domain <a9b0063d-55af-46f1-b94a-cb05a39c92cf> ;
    crm:P03_has_range_literal "M. de Farcy était doyen de la faculté de médecine de Paris (cf. [1702-02a_312](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02a_312))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<db79733f-93c4-4244-b1f2-542b77c50082> a crm:PC3_has_note ;
    crm:P01_has_domain <ec825409-f787-4a7c-8288-134799ffe4d9> ;
    crm:P03_has_range_literal "consul de Riom (1682.10)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<db8f35eb-edfc-45de-89cb-7ef91027fc3b> a crm:PC3_has_note ;
    crm:P01_has_domain <57f99c8a-e485-4872-8dda-bfe2c2279832> ;
    crm:P03_has_range_literal "M. Delan est un des commissaires fondateurs de l'Académie de musique de Troyes." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dbb081c4-18c1-4424-ab3e-b9932017ccc1> a crm:PC3_has_note ;
    crm:P01_has_domain <329db659-22a5-447b-a14a-dd8f3f26a4b3> ;
    crm:P03_has_range_literal "Un M. Paulin, «  bénéficier de Notre-Dame  », est mentionné à deux reprises dans le Mercure Galant de 1704, en tant qu'auteur d'un Te Deum en musique donné au couvent des Célestins le 6 juillet 1704 (cf. [1704-07b_150a](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_150a)) et à l'église des Augustins du faubourg Saint-Germain le 14 juillet (cf. MG-1704-07b\\_246), pour célébrer la naissance du duc de Bretagne, arrière-petit-fils de Louis XIV. Il est possible qu'il s'agisse de Frédéric-Hubert Paulin, auteur d'un recueil de motets (1705 ca) et d'airs sérieux et à boire (1705)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dbd27089-608a-4093-bf9a-0244dfd412aa> a crm:PC3_has_note ;
    crm:P01_has_domain <143a62ba-53ac-4ba4-90b7-581cbf33cbac> ;
    crm:P03_has_range_literal "Brun (Louis-Auguste) (1758-1815), peintre (1771-1801)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dbdb8498-69c0-4eb8-a34c-641c8ecfb55b> a crm:PC3_has_note ;
    crm:P01_has_domain <1db03977-baee-49d9-b05f-90e2ecabb6cc> ;
    crm:P03_has_range_literal "Compositeur de trois cantates ou cantatilles perdues, publiées chez Leclerc, Boivin ou encore Ballard." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dbef07bd-814a-4f00-b096-b9e5fafc6c26> a crm:PC3_has_note ;
    crm:P01_has_domain <06e7c562-fb5b-4ac3-a7b2-b387c84fb367> ;
    crm:P03_has_range_literal "Compositeur, auteur notamment d'un motet à huit parties chanté à Orange lors de solennités publiques (cf. MG-1679-07_124)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dbfe6011-73df-4f9d-a3d2-ea87e3e73bf3> a crm:PC3_has_note ;
    crm:P01_has_domain <e7406990-ec21-4053-b7ae-3ae4def0e0bc> ;
    crm:P03_has_range_literal "Grand Maistre des Eaux et Forests , frère de Louis Milon, évêque de Condom (1694.09.02)." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc22739c-aeb5-443c-abf3-c07fff6e7b13> a crm:PC3_has_note ;
    crm:P01_has_domain <00cf7c97-2edd-42a0-ad05-5b265585e7e2> ;
    crm:P03_has_range_literal "Castrat d'origine autrichienne, actif entre les années 1670 et 1714." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dc25b74e-e76e-4cf6-8607-4d70aaef1aa5> a crm:PC3_has_note ;
    crm:P01_has_domain <d2639458-3e3b-43ff-8f2a-9f31dd35db40> ;
    crm:P03_has_range_literal "M. de Tonti est l'auteur des vers de la pastorale Les Bergers heureux parue dans le Mercure galant de septembre 1689 (cf. MG-1689-09\\_021), du Prologue Mars, la France, la Renommée parue en novembre 1690 (cf. MG-1690-11\\_255) et de l'air nouveau paru en janvier 1701 (cf. MG-1701-01\\_079)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dc286b76-b067-45e4-bc50-21416431636f> a crm:PC3_has_note ;
    crm:P01_has_domain <cf510c9f-3fd8-4686-8b3e-4b19fad0f392> ;
    crm:P03_has_range_literal "Commandeur de l'Ordre de Malte (cf. MG-1679-11\\_014)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<dc2fd3a9-56a9-4cb7-a859-2acd76a205e1> a crm:PC3_has_note ;
    crm:P01_has_domain <e6df017b-dc28-4926-ae88-bc438c8f1810> ;
    crm:P03_has_range_literal "gentilhomme bourbonnais, capitaine de cavalerie (1685.04)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc36652b-24b0-4e15-b2aa-e2f21479385d> a crm:PC3_has_note ;
    crm:P01_has_domain <96fda2c0-6799-48c5-b9db-168a23a32bfe> ;
    crm:P03_has_range_literal "Périn, Albert-François (1688-1759), valet de chambre du roi (…1708-1736…), porte-manteau du roi (…1712-av. 1718 ; …1736-av. 1749), sous-gouverneur (…1718-av. 1749), précepteur (…1736-1749…), puis gouverneur (…1749-1756…) des pages de la Grande Écurie" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc4c64bc-a6fa-462a-8893-a607a673931c> a crm:PC3_has_note ;
    crm:P01_has_domain <749fcdf2-48f8-4290-82d2-48318fe1730a> ;
    crm:P03_has_range_literal "gentilhomme picard (1685.11)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<dc5a2c5b-78d0-42f8-84ce-37d1347b2510> a crm:PC3_has_note ;
    crm:P01_has_domain <bce6b785-c295-4402-b1ad-902e99760538> ;
    crm:P03_has_range_literal "M. de Villemont de Rouen est l'auteur d'une satire publiée dans la livraison de janvier 1702 du Mercure galant (cf. MG-1702-01\\_99)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

