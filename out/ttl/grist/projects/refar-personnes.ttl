    crm:P03_has_range_literal "Porée (Louis) (?-?), huissier de la Chambre du roi (...1698-1736...), concierge du chenil du château de Saint-Germain-en-Laye (1706-1736...), concierge de la grande écurie du château de Saint-Germain-en-Laye (...1708-1722...)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<ce10b334-b870-43b0-898d-36494305845a> a crm:PC3_has_note ;
    crm:P01_has_domain <2aff2117-7043-4071-a9cc-60388667a683> ;
    crm:P03_has_range_literal "Hector de Marle (Bernard) (?-1694), conseiller au parlement de Paris (1652…), maître des requêtes ordinaire de l'Hôtel du roi (1665…), intendant à Alençon (1666-1671), puis en Auvergne (1671-1682), chancelier des Grands-Jours de Poitou, Périgord et Limousin (1688…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

