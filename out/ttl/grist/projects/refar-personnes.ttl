<11df6153-3e5d-4fbb-9250-b0c29aec0a1c> a crm:PC3_has_note ;
    crm:P01_has_domain <6b2ce12b-edfe-4f42-baaa-2104cbfdeb80> ;
    crm:P03_has_range_literal "M. Guillery est mentionné en tant que compositeur d'un Te Deum laudamus en musique, chanté le 10 juillet 1704 en l'église des Saints Innocents à Paris (cf. MG-1704-07b\\_246)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<11f4607f-0e40-47e1-9484-7c9ee3c18a92> a crm:PC3_has_note ;
    crm:P01_has_domain <3ebd4c3e-d347-4544-a666-b430ee8ec45b> ;
    crm:P03_has_range_literal "Mademoiselle Conradi a chanté à l’Opéra de Hambourg entre 1690 et 1710 (cf. <http://www.quellusignolo.fr/sopranos/conradi.html>, consulté le 25 mars 2021). Dans le ballet «Sieg der Schönheit über die Helden», présenté lors du mariage du prince de Prusse en 1706, elle a joué les rôles de Vénus et de la Prusse." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<11f91eba-e2b1-46fe-afc4-7eab185456a7> a crm:PC3_has_note ;
    crm:P01_has_domain <5368e3cf-a305-41fc-ac86-7eddeaf9012d> ;
    crm:P03_has_range_literal "Giovanni Antonio Luppazzoli succède en 1702 à son père Francesco en tant que consul de Venise à Smyrne (cf. https://journals.openedition.org/cdlm/11234 ; http://tesi.cab.unipd.it/45361/1/Tesi\\_Umberto\\_Signori.pdf, consulté le 11 juin 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<1206cad1-25d3-4822-bfad-66f0efb4d7d4> a crm:PC3_has_note ;
    crm:P01_has_domain <874c681b-f670-49d7-a3fa-239307adf84a> ;
    crm:P03_has_range_literal "Écuyer cavalcadour de la Petite Écurie (? - 1750), Écuyer ordinaire de la Grande Écurie (1754-1773), Capitaine du haras royal de Saint-Léger (1758-1785), Premier écuyer de la Grande Écurie (1773 - ?)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<12562150-5f65-4a36-bb55-f68dcf6c0ea1> a crm:PC3_has_note ;
    crm:P01_has_domain <f760ab70-c8f9-45f8-8da4-a977c26067eb> ;
    crm:P03_has_range_literal "Le Mercure galant fait mention en juillet 1704 d'un comte de la Bretesche, frère du marquis de la Bretesche, lieutenant général des Armées du Roy. L'arbre généalogique présentant plusieurs frères, le comte est difficilement identifiable sans informations complémentaires." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<12726dc7-52d4-4ba6-810b-69ce0ee6bed6> a crm:PC3_has_note ;
    crm:P01_has_domain <85688579-923c-42c8-bbee-f3bc422e4754> ;
    crm:P03_has_range_literal "Secrétaire du Cabinet de Leurs Altesses Royales de Savoie (cf. [1679-01_060](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1679-01_060))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

