<d1f5b024-8479-429f-b3dc-416f28cfcc69> a crm:PC3_has_note ;
    crm:P01_has_domain <387caa71-c14c-4a40-8d1b-7c947bdb2ab9> ;
    crm:P03_has_range_literal "Jean Truchet, dit le Père Sébastien, était membre de l'Académie des Sciences. Il a été «Académicien honoraire, premier titulaire, nommé par Louis XIV, le 28 janvier 1699 - Démissionnaire le 16 août 1726» (cf. <https://www.academie-sciences.fr/fr/Liste-des-membres-depuis-la-creation-de-l-Academie-des-sciences/les-membres-du-passe-dont-le-nom-commence-par-t.html>, consulté le 9 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d23d681f-c390-40cf-98ec-f60519c1c765> a crm:PC3_has_note ;
    crm:P01_has_domain <63489540-c09b-4617-ab4b-b97bb89f91af> ;
    crm:P03_has_range_literal "Blanzy (Jérôme Bignon de) (1698-1743), conseiller au parlement de Paris (1716…), maître des requêtes (1719…), intendant de La Rochelle (1726-1737), puis à Soissons (1737-1743), bibliothécaire du roi (1741…), conseiller d'état (1743…)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d2a00569-93a1-4ec9-828f-8b217ef8dc7c> a crm:PC3_has_note ;
    crm:P01_has_domain <dc00bcd2-7b40-485a-8831-c7aed9e93fbc> ;
    crm:P03_has_range_literal "« Abbé de Saint-Pierre de Tasque, au diocèse de Tarbes en 1691, […], il fut rapidement nommé par ordonnance royale, le 24 décembre 1701 à l'abbaye de Sainte Marie d'Arles-sur-Tech et Saint André de Sorède de l'ordre de Saint Benoit. Confirmé par le pape le 31 juillet de l'année suivante et sacré à Paris le 4 octobre 1702, il fut également docteur en théologie et prédicateur du roi et devint membre honoraire du Conseil souverain de Roussillon en 1703 » (cf. <http://www.hyacinthe-rigaud.com/catalogue-raisonne-hyacinthe-rigaud/portraits/1144-gaillard-de-chaudon-noel>, consulté le 12 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d2bb11ed-ec7b-4471-b0d1-24b41dcd8ab9> a crm:PC3_has_note ;
    crm:P01_has_domain <c3b749f9-1da5-4dae-bcd4-ed7768cd71f1> ;
    crm:P03_has_range_literal "Lubersac (Jean-Baptiste-Joseph de) (1740-1822), évêque de Tréguier (1775-1780) puis de Chartres ((1780-1801)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d2c175f6-2272-487d-afb0-0b4cd38d3b1a> a crm:PC3_has_note ;
    crm:P01_has_domain <d3f52a39-97c3-46a3-aab9-2d31c5ef6648> ;
    crm:P03_has_range_literal "Abbé de Bouzonville et chanoine de Notre-Dame de Paris (cf. MG-1689-03a_233)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d2fa12e9-4e1b-44e6-ba93-789e2ffa31ac> a crm:PC3_has_note ;
    crm:P01_has_domain <3175ad80-d9f2-4379-853b-c8737676edd9> ;
    crm:P03_has_range_literal "Mlle Sicard, fille de Jean Sicard, est l'autrice d'un air paru dans le *Mercure galant* de mars 1678 (cf. [1678-03e_390](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-03e_390))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d31d86c8-8344-4928-bade-cc5954b3fe17> a crm:PC3_has_note ;
    crm:P01_has_domain <2a8be81d-3518-4e4f-b82d-995af684fa01> ;
    crm:P03_has_range_literal "M. du Breuil chanta, avec M. Pivain, un air de la composition de ce dernier à Clayes (désormais Clayes-Souilly), en présence de la duchesse de Lorraine (cf. MG-1698-11\\_113)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3540373-e1dc-49f8-b48b-4b8a123e1631> a crm:PC3_has_note ;
    crm:P01_has_domain <c57d9eca-5074-410e-ad1d-10d32063b67d> ;
    crm:P03_has_range_literal "Commandeur de l'hôpital de Besançon (cf. MG-1683-07\\_230)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3a10e0e-c7f2-4a8c-b8cc-4ba9754326f2> a crm:PC3_has_note ;
    crm:P01_has_domain <b0fbbd96-6bb0-4bbf-bfea-c74c1d4eb9c8> ;
    crm:P03_has_range_literal "Aide-major de la citadelle de Mont-Louis (cf. [1681-12_51](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1681-12_51))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3af17b2-3400-414e-9525-6cedb12291f2> a crm:PC3_has_note ;
    crm:P01_has_domain <7a8c0a9f-2775-4a11-b329-88d468917b91> ;
    crm:P03_has_range_literal "Claude-Marie de Saint Georges (1677-?), chanoine-comte de Saint-Jean de Lyon (1697), était le neveu de Claude de Saint-Georges, Archevêque de Lyon. Il fut “précenteur de l’église de Lyon” (cf. Journal Historique sur les Matières du Tems, Tome VI, Paris : Étienne Ganeau, 1719, p. 155)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3be5e41-fa12-4706-8201-d19d92033ace> a crm:PC3_has_note ;
    crm:P01_has_domain <3d1f2444-8724-41f6-a501-a78b6165cbf8> ;
    crm:P03_has_range_literal "Marie de Sourdille était l'épouse de René II du Guesclin (1647-1714), seigneur de Beaucé et capitaine de cavalerie." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3cd3fbd-b64d-4863-b2ac-d01108e6e9d5> a crm:PC3_has_note ;
    crm:P01_has_domain <01eb3c56-823c-48f6-8b89-68c1fbbbaa45> ;
    crm:P03_has_range_literal "Gaillard de La Bouëxière (Jean) (1676-1759), fermier général (1722-1758)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d3d02535-8eea-4aca-80c9-da3d83ff331e> a crm:PC3_has_note ;
    crm:P01_has_domain <1972d8d5-0e9e-4925-9430-01c677042457> ;
    crm:P03_has_range_literal "Gentilhomme de la cour de Hanovre (cf. MG-1681-04\\_133)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3dd561f-c5e9-4724-9e31-035fc1fc20ef> a crm:PC3_has_note ;
    crm:P01_has_domain <84b41db7-0786-4971-95c3-fd979621694e> ;
    crm:P03_has_range_literal "Capitaine au régiment de Champagne (cf. [1682-11_244](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-11_244))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d3f77719-c9be-4f13-94dd-4ffa20b196a4> a crm:PC3_has_note ;
    crm:P01_has_domain <535d38df-2d53-4c4e-ac91-1e55ec692388> ;
    crm:P03_has_range_literal "Le Mercure galant indique que Jean Foloppe était avocat du roi (MG-1704-07b\\_292). Les archives civiles de la Seine Maritime précisent qu’il est devenu « avocat du roi au siège présidial de Caudebec » entre 1676 et 1690 (Inventaire-sommaire des Archives Départementales antérieures à 1790 de Seine inférieure, archives civiles, série C- 1328)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d42e8eb6-0885-4c8a-bf3b-f6b723e7f101> a crm:PC3_has_note ;
    crm:P01_has_domain <20707f56-c2ed-4c21-a4d6-b1bb79a30fad> ;
    crm:P03_has_range_literal "Berwick (Jacques Fitz-James, duc de) (1670-1734), maréchal de France (1706). On trouve également, dans le *Mercure galant,* son nom orthographié \"Barvick\" et \"Barwick\"." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d42fb276-1774-4b86-aab6-83d984519c45> a crm:PC3_has_note ;
    crm:P01_has_domain <2e0959a5-d99a-4bfd-a496-0ad515fe244b> ;
    crm:P03_has_range_literal "Ancien doyen de la cathédrale et grand vicaire de l'évêque de Troyes (cf. [1687-03b_337](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_337))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d430ae4b-87c3-40ea-9f3e-444cdeb726b5> a crm:PC3_has_note ;
    crm:P01_has_domain <53d108ef-922e-4c69-9f5c-2b68976e248c> ;
    crm:P03_has_range_literal "Madame de Middleton a participé à une fête organisée par Louis XIV à Versailles à laquelle la cour d'Angleterre exilée à Saint-Germain-en-Laye participa (cf. MG-1708-01\\_244). Il pourrait s'agir de Catherine Brudenell, countess of Middleton (cf. <https://www.npg.org.uk/collections/search/portrait/mw139850/Catherine-ne-Brudenell-Countess-of-Middleton>, consulté le 2 avril 2021), épouse du comte de Middleton (cf. <https://fr.nipponkaigi.net/wiki/Charles_Middleton,_2nd_Earl_of_Middleton>, consulté le 2 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d447ac65-81fb-4a2b-82d8-30991e5b97da> a crm:PC3_has_note ;
    crm:P01_has_domain <e2702198-1fcc-43e8-9cd7-1362c2c10249> ;
    crm:P03_has_range_literal "Gouverneur et lieutenant général de la province de Foix (cf. MG-1677-07\\_209)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d47c0c3e-5850-455b-a532-3882f86ee26c> a crm:PC3_has_note ;
    crm:P01_has_domain <7220a9c9-ce9b-4b89-89b2-7d16de759fcf> ;
    crm:P03_has_range_literal "Bon (Philibert de) (1636-1711), premier président à la Cour des comptes, aides et finances de Montpellier (1681-1711)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d48658a2-0f26-4d84-a7ce-26e431a69ab2> a crm:PC3_has_note ;
    crm:P01_has_domain <46b9e9a8-407b-44d1-9cfb-d21dbed68601> ;
    crm:P03_has_range_literal "Père jésuite allemand qui confessa la dauphine à la Toussaint 1687 (cf. [1687-11_004](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-11_004))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4a6ea0a-772d-464a-800f-967cc7a9061e> a crm:PC3_has_note ;
    crm:P01_has_domain <03fd5ae8-eae4-41ab-9412-237c16008531> ;
    crm:P03_has_range_literal "Enseigne au Régiment des Gardes françaises en 1654, promu lieutenant en 1656 puis Major de son Régiment en 1670. Il leva son propre régiment de Dragons en 1674. Gouverneur et grand bailli des ville et citadelle de Tournai (voir Chronologie historique-militaire par M. Pinard, t. 6, 1763). Il était également l'oncle de M. de Combes, lieutenant général de Riom (MG-1687-04\\_297)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4b7d759-8ac4-414d-a15e-e816c22a6c5d> a crm:PC3_has_note ;
    crm:P01_has_domain <9f3c1604-a486-4691-9da6-358c3907c0b1> ;
    crm:P03_has_range_literal "Bournezeau (Jean de Creil de) (1644-1709), conseiller au Châtelet, conseiller au parlement de Paris, première chambre d'enquête (1671…), maître des requêtes ordinaire de l'Hôtel du roi (1676…), intendant à Moulins (1684-1686), intendant à Orléans (1686-1694), conseiller d'État (1694…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d4c1f5ba-7028-49c2-bd8d-f3e907dbce1b> a crm:PC3_has_note ;
    crm:P01_has_domain <0aa0837e-307c-4b3a-a100-2ad64b1b165d> ;
    crm:P03_has_range_literal "Duché (Jean-Baptiste) (?-1691), intendant et contrôleur général de l'Argenterie, menus plaisirs et affaires de la Chambre du roi (1666…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d4c90374-effa-4ba0-b896-a7a3965c683a> a crm:PC3_has_note ;
    crm:P01_has_domain <2714f709-c7f2-4333-85da-4a4f97578da9> ;
    crm:P03_has_range_literal "Surintendant des finances et des bâtiments de Monsieur (cf. MG-1679-07\\_340)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4cfbe23-675a-4dd3-b209-cc6559a9ca42> a crm:PC3_has_note ;
    crm:P01_has_domain <0963f7dc-e97b-4882-9f7a-701add28f206> ;
    crm:P03_has_range_literal "Gentilhomme napolitain (cf. MG-1679-04_144)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d4cfc733-1c7e-4aa7-b96c-81e60b858d81> a crm:PC3_has_note ;
    crm:P01_has_domain <9ce59e99-41e0-4e02-9ade-5bf3ee870002> ;
    crm:P03_has_range_literal "Castries (Charles-Eugène-Gabriel de La Croix, marquis de) (1727-1801), maréchal de France (1783)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d4e39fed-3abb-429a-ad64-2b5a82dd53af> a crm:PC3_has_note ;
    crm:P01_has_domain <7684eea5-7cf2-4233-a598-7920061791d1> ;
    crm:P03_has_range_literal "Prieure de l'Hôtel-Dieu des Andelys (cf. [1687-03b_031](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1687-03b_031))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d5040032-4c14-454a-8787-4cfe6c8dfd48> a crm:PC3_has_note ;
    crm:P01_has_domain <e631b84e-cbd0-4f4d-9ebf-49caa0bf1045> ;
    crm:P03_has_range_literal "Ancien maître des comptes, vicomte majeur de Dijon (cf. MG-1688-12a_038)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d507b617-1133-4000-8e03-17a7b52e8a28> a crm:PC3_has_note ;
    crm:P01_has_domain <b23ba521-d432-4f97-8a82-8f06d2bbf553> ;
    crm:P03_has_range_literal "fille d'honneur de Madame (1682.01)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d517f837-e11a-45ab-898b-c7367a8540e1> a crm:PC3_has_note ;
    crm:P01_has_domain <2c7eb179-7614-417c-bc88-0d145738e481> ;
    crm:P03_has_range_literal "Prévôt et maître des cérémonies de l'ordre royale de Notre-Dame-du-Mont-Carmel et de Saint-Lazare de Jérusalem." ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d538f639-1071-492f-a20c-7eec44f174e6> a crm:PC3_has_note ;
    crm:P01_has_domain <b0fbbd96-6bb0-4bbf-bfea-c74c1d4eb9c8> ;
    crm:P03_has_range_literal "Aide-major de la citadelle de Mont-Louis (cf. MG-1681-12\\_51)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d5420766-70a5-4e05-856a-b4ced7adbfb5> a crm:PC3_has_note ;
    crm:P01_has_domain <ffa73212-8438-4f8a-aa79-af0d7e619e61> ;
    crm:P03_has_range_literal "Renard de Saint-André (Jacques) (1659-?), peintre ordinaire du roi (…1685…), concierge du Louvre (…1685-1696…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d54f054e-d79f-453c-adce-530264aacf4e> a crm:PC3_has_note ;
    crm:P01_has_domain <b5f65de9-cb2f-481a-b17c-7caf5299d141> ;
    crm:P03_has_range_literal "Curé de La Chapelle-Souquet (cf. [1698-01_082](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-01_082))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d599ab0d-141d-4f2f-a899-a7dd65f1550f> a crm:PC3_has_note ;
    crm:P01_has_domain <4f98bb88-9799-4e4b-a27f-2afc83af46d7> ;
    crm:P03_has_range_literal "M. Mal, auteur des paroles d'un air publié dans le *Mercure Galant* d'octobre 1687 (cf. MG-1687-10\\_121), organisait également des concerts en sa demeure (cf. MG-1681-02\\_130)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d5a39d06-3de9-4c5a-88ad-758ae434c773> a crm:PC3_has_note ;
    crm:P01_has_domain <b6ceaf5e-9b96-4820-845e-9c815cf53ec3> ;
    crm:P03_has_range_literal "Plattemontagne (Nicolas-Anne de) (?-1743), musicien ordinaire de la chapelle du roi (1707-1736…)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d5eb7238-6673-49df-aa13-c64bf5cac8b7> a crm:PC3_has_note ;
    crm:P01_has_domain <a66bf13c-1cd9-46e7-b464-6bceb772a84a> ;
    crm:P03_has_range_literal "Fils du baron puis marquis d'Ollières et frère de M. de Mirabeau (cf. MG-1687-06a\\_166). On peut l'identifier soit à Augustin d'Agoult d'Ollières, soit à Gaspard d'Agoult d'Ollières." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d612482d-3976-48fb-9851-014345fb622d> a crm:PC3_has_note ;
    crm:P01_has_domain <ce6ecc75-d874-46b1-813a-cb6b0ef2e79d> ;
    crm:P03_has_range_literal "M. Noël est l'auteur des paroles d'un air publié dans le *Mercure Galant* de mars 1679. Le rédacteur du Mercure précise que \"Les Paroles sont de Mr Noël, Homme d'un fort grand merite, & que je vous ay déja dit que la Ville de Chartres avoit choisy pour son Avocat.\" (cf. MG-1679-03\\_042). Il s'agit de Milles Noël dont l'acte de décès indique qu'il était \"advocat en parlement et de la ville de Chartres\" (cf. [Registres paroissiaux de Saint-Hilaire de Chartres, 31 janvier 1701](https://familysearch.org/ark:/61903/3:1:3Q9M-C33B-DRK3?cc=3460907 : 2 July 2021)). Il épousa en juin 1670 Catherine Bouvart." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d61962e6-1dd7-48e6-bf7c-9a5f779ef39d> a crm:PC3_has_note ;
    crm:P01_has_domain <7e239f52-dd4b-4ac6-8879-956c84a17535> ;
    crm:P03_has_range_literal "M. Chauvon est l'auteur d'un air paru dans le Mercure galant d'avril 1703 (cf. [1703-04_156](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1703-04_156))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d61e8598-307f-4454-8296-799c83ccb26c> a crm:PC3_has_note ;
    crm:P01_has_domain <6768f239-f8db-4f58-80c7-1f546ec09973> ;
    crm:P03_has_range_literal "Jean-Baptiste Dufour était médailleur de Louis XIV (cf. De Turckeim-Pey Sylvie, *Médailles du Grand Siècle: Histoire métallique de Louis XIV,* Paris, Bibliothèque nationale de France, 2004, p. 27-28.)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d645d700-ad2b-4998-a509-f87cd155e437> a crm:PC3_has_note ;
    crm:P01_has_domain <69a9d1d8-8503-488a-a664-497034cafa42> ;
    crm:P03_has_range_literal "Imprimeur libraire." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d64eceff-71dd-4e3c-9b97-4d8221c26a9a> a crm:PC3_has_note ;
    crm:P01_has_domain <b49037a2-c7e4-4b64-aed9-82c0d7270579> ;
    crm:P03_has_range_literal "Laura de Castelvi était l’épouse de Nicola Antonio de Caracciolo, marquis de Torrecuso. Leur mariage, cité dans le Mercure galant en septembre 1705, a eu lieu le 4 janvier de cette année (cf. https://gallica.bnf.fr/ark:/12148/bpt6k6279055c/f74.item, consulté le 7 avril 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d66b0489-68e9-4902-b713-bcfc2635f438> a crm:PC3_has_note ;
    crm:P01_has_domain <37f96143-8c4f-49fc-9e84-f8e21374e8bd> ;
    crm:P03_has_range_literal "Capitaine aux gardes, à Versailles (cf. [1682-06_010](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-06_010))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d686bff8-af15-4f47-bfa0-435b74ffbcd0> a crm:PC3_has_note ;
    crm:P01_has_domain <ab6c414f-05bf-4252-b8b7-f806d44207a1> ;
    crm:P03_has_range_literal "La Rochefoucauld (Frédéric-Jérôme de) (1701-1757), cardinal (1747-1757)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d68b160d-f33c-4e46-83a6-6c58c169b4ff> a crm:PC3_has_note ;
    crm:P01_has_domain <bdbb41ee-e9af-44a7-add3-b01fe42858fa> ;
    crm:P03_has_range_literal "François I Martin est un compositeur français, actif à Paris durant la seconde moitié du XVIIe siècle. Il a été ordinaire de la musique de Gaston d'Orléans et a publié un recueil de pièces pour la guitare (1663), un recueil d'airs (1668) et des airs isolés, dont quatre dans le *Mercure galant* (cf. [1678-04_071](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-04_071), [1688-11a_136](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1688-11a_136), [1689-04a_076](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-04a_076), [1689-04a_317](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1689-04a_317)). Il est également l'auteur d'une pastorale, Les Bergers heureux (cf. MG-1689-09\\_021). Il est le père de François (1661-?)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d7202032-19fe-4258-b3e6-2382f84e6921> a crm:PC3_has_note ;
    crm:P01_has_domain <783337c1-dab8-4d98-b70f-c98600f04457> ;
    crm:P03_has_range_literal "échevin de Semur-en-Auxois (cf. MG-1682-12\\_216) et auteur d'une Relation de ce qui c'est passé de plus considerable dans la rejouissance ordonnée par messieurs les magistrats de la ville de Semur, capitalle d'Auxois, sur la naissance de Monseigneur duc de Bourgogne en l'année 1682 (Pierre Palliot, imprimeur du roi, du rever. evesque duc de Langres, des états, & de la ville, à la Reine de Paix, devant la Cour du Palais, 1682)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d7657d2f-9594-40a7-abcc-f59db58918d9> a crm:PC3_has_note ;
    crm:P01_has_domain <b2e3f4cb-fda9-44cb-82d2-5ce9a792df87> ;
    crm:P03_has_range_literal "Trésorier de France en Champagne (cf. [1680-03b_088](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-03b_088))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d76d83e5-e1ea-4d49-96a6-73624adb997e> a crm:PC3_has_note ;
    crm:P01_has_domain <ad8579cf-6152-4454-ab89-0eb9a85bc0a6> ;
    crm:P03_has_range_literal "Gouverneur de Nantes (cf. MG-1681-08_323)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d78abca0-5a0a-4fe1-a075-b8182650ae7b> a crm:PC3_has_note ;
    crm:P01_has_domain <17a9b9d7-a96c-4002-afcd-e298421dbac5> ;
    crm:P03_has_range_literal "Hérault d'armes au régiment de Picardie (cf. [1678-09_375](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1678-09_375))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d7a31749-05a6-48e2-a3ac-d383e61f06bf> a crm:PC3_has_note ;
    crm:P01_has_domain <9f9c9019-b34f-453e-a3a3-69726bd1215a> ;
    crm:P03_has_range_literal "Premier président de la chambre des comptes de Bourgogne et de Bresse (cf. [1682-08_223](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1682-08_223))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d7e79986-5e82-4a6d-81f3-1ccab88f7e3d> a crm:PC3_has_note ;
    crm:P01_has_domain <9d9bcf11-fbe0-43b4-a2f0-003712704cba> ;
    crm:P03_has_range_literal "Procureur du roi au Présidial de Limoux (cf. MG-1682-12\\_349)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d7eb7aee-e4e7-46a9-9c18-b35dbfcb10a5> a crm:PC3_has_note ;
    crm:P01_has_domain <5cd1f7af-e729-4cf9-8552-0ea47958933a> ;
    crm:P03_has_range_literal "Bernard (Pierre-Joseph) (1708-1775), poète érotique, clerc dans un bureau de procureur, secrétaire du marquis de Pezai, secrétaire du maréchal de Coigny, secrétaire général des Dragons (1740-1751…), garde du Cabinet des livres du roi à Choisy (…1748-1775 ?)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d82f24aa-eb37-45d8-928f-8d781ed2e97b> a crm:PC3_has_note ;
    crm:P01_has_domain <fbf25c28-1944-40da-8fa3-ef434d2b1c21> ;
    crm:P03_has_range_literal "Tourolle (Charles) (1693?-1748), maréchal des logis (actif en 1722-1728), garde général du Garde-Meuble de la Couronne (en survivance …1728-1742, en titre 1742-1748), receveur général des domaines et bois de la généralité de Rouen (1735-1748)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d840b09f-9c10-49f7-941c-0867445a0e51> a crm:PC3_has_note ;
    crm:P01_has_domain <e631b84e-cbd0-4f4d-9ebf-49caa0bf1045> ;
    crm:P03_has_range_literal "Ancien maître des comptes, vicomte majeur de Dijon (cf. [1688-12a_038](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1688-12a_038))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d84a283e-b1a1-4a92-b3d7-dbccdbbb2a1d> a crm:PC3_has_note ;
    crm:P01_has_domain <8cfe73c6-80ab-4051-adb4-99b24f0df77c> ;
    crm:P03_has_range_literal "Curé à Aix, Grand Vicaire de l'Archevêque d'Aix, Abbé de Saint Rambert." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d854ab79-d4f9-4bef-b453-598a003612cb> a crm:PC3_has_note ;
    crm:P01_has_domain <4523be8b-a701-4038-8e3b-e15c01f5db26> ;
    crm:P03_has_range_literal "Maître de musique de la cathédrale de Beauvais depuis 15 années en 1680 (cf. [1680-02_062](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1680-02_062))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d8621ea4-29fd-4e05-aad9-34e82e41adf7> a crm:PC3_has_note ;
    crm:P01_has_domain <28e4b33c-f29f-4715-9bed-c1b79b624ca2> ;
    crm:P03_has_range_literal "Nivernais (Hélène-Françoise-Angélique Phélypeaux de Pontchartrain, duchesse de) (1715-1782), dame du palais de la reine (1745-1748)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d86be5a6-3992-404d-bab6-ddc5a044c720> a crm:PC3_has_note ;
    crm:P01_has_domain <01917bf0-401e-4358-b0dd-3810e8b8eb83> ;
    crm:P03_has_range_literal "À propos de Joseph-Antoine Hennequin de Charmont, voir FROSTIN, Charles. Chapitre III. La diversité du réseau Pontchartrain et ses tendances affairistes, dans Les Pontchartrain, ministres de Louis XIV : Alliances et réseau d'influence sous l'Ancien Régime [en ligne], Rennes, Presses universitaires de Rennes, 2006 (généré le 25 mars 2021). Disponible sur Internet : . ISBN : 9782753532113. DOI : https://doi.org/10.4000/books.pur.9190." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d899e8e9-989e-46c8-a03d-e6ede896ffae> a crm:PC3_has_note ;
    crm:P01_has_domain <cd2830d9-e74d-4d98-9bb7-3f1ef2a8fdcd> ;
    crm:P03_has_range_literal "Jean-Baptiste Dantécourt, génovéfain, fut régent de théologie à Évaux (1670), professeur de philosophie à Sainte-Geneviève (1675-1686), chancelier de l'Université (1680-1707) et curé de Saint-Étienne-du-Mont (1694-1710)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d8bac187-7959-4fde-b07c-4e704cc6be47> a crm:PC3_has_note ;
    crm:P01_has_domain <0f34642e-05ac-493a-a84d-2fb8b2aa94ea> ;
    crm:P03_has_range_literal "Le Mercure galant mentionne Madame de Fontenelle qui a participé aux réjouissances publiques organisées à Château-Gontier pour la naissance du duc de Bretagne en 1704 (cf. [1704-07b_393](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1704-07b_393))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d8c16dee-9df9-44a4-b36e-36a0085bfe07> a crm:PC3_has_note ;
    crm:P01_has_domain <3b61589d-11f4-4d8a-9500-e0c29cdd57e9> ;
    crm:P03_has_range_literal "Joachim de la Chétardie (1636-1714) était “directeur dans les séminaires de Limoges, du Puy et de Bourges, [puis] Curé de Saint-Sulpice à Paris de 1696 à sa mort (29 juin 1714) (cf. http://beauchesne.immanens.com/appli/article.php?id=12223, consulté le 9 mars 2021)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d8e990f9-d2b4-4049-9899-4ef94c22ea5b> a crm:PC3_has_note ;
    crm:P01_has_domain <590ff5b6-b84c-4758-b089-87f14113b81d> ;
    crm:P03_has_range_literal "« de Saint-Malo » (1680.02)" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d8f5b467-57e4-4341-8a1a-a3a76b86c4d4> a crm:PC3_has_note ;
    crm:P01_has_domain <eabaaa79-157d-4d9c-b02b-eb6ab08ca83e> ;
    crm:P03_has_range_literal "Aphrodise était un compositeur et maître de musique actif à Toulouse entre 1696 et 1706, mentionné notamment dans le Mercure galant en tant que maître de musique du chapitre de Saint-Sernin à Toulouse (cf. [1698-03_123](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1698-03_123), [1702-02_284](https://data-iremus.huma-num.fr/sherlock/mercure-galant/article/1702-02_284))." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d90b797f-02ec-4585-ae4b-f469aade5c0f> a crm:PC3_has_note ;
    crm:P01_has_domain <0fdf2745-c5e5-49ec-879c-16107e84d02f> ;
    crm:P03_has_range_literal "Bourdelin (Claude Ier) (1621-1699), académicien chimiste de l'Académie royale des sciences (1666...)" ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d927ced2-db48-4858-9b7b-29dfc8c84585> a crm:PC3_has_note ;
    crm:P01_has_domain <e4c01474-0fe3-48bf-88cb-f3068523e899> ;
    crm:P03_has_range_literal "Vauvré (Jean-Louis de Girardin de) (v. 1647-1724), intendant de la marine" ;
    crm:P3.1_has_type <c5402ae4-4ae9-48a1-86ed-c13de0c97d53> .

<d944793c-dbe0-4e31-96be-38cb7e492b3e> a crm:PC3_has_note ;
    crm:P01_has_domain <155b5189-ba3a-42e3-8c0c-c9db493b2432> ;
    crm:P03_has_range_literal "Premier ministre d'état à la cour de Würtemberg (cf. MG-1684-11\\_034)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d94660ba-e80d-43c2-bc3d-0a74b6da2b6b> a crm:PC3_has_note ;
    crm:P01_has_domain <389b4509-6c80-4165-b2e5-1d0747f49cb3> ;
    crm:P03_has_range_literal "Marguerite-Louise de Béthune a été dame du palais de la reine (1667-1683) puis dame d'honneur de la dauphine (1696-1712)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d94b3017-666c-404b-b610-442a6aee514a> a crm:PC3_has_note ;
    crm:P01_has_domain <0bd9c2a0-e221-498f-8fd8-adfdc9deb8bb> ;
    crm:P03_has_range_literal "Chanoine de Saint-Martin-de-Tours, frère de Guillaume Guédier (cf. MG-1687-03b\\_299)." ;
    crm:P3.1_has_type <60e0538c-c548-4e0a-8456-4bd654acb59d> .

<d9ada591-a527-4fed-b9e7-b03909defc3f> a crm:PC3_has_note ;
